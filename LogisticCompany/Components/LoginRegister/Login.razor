@page "/login"
@inject AppDbContext DbContext
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@using LogisticCompany.Db
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

<div class="login-page min-vh-100">
    <div class="container-fluid h-100 p-0">
        <div class="row g-0 h-100">
            <!-- Left Side - Background -->
            <div class="col-lg-6 d-none d-lg-block login-background">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-white p-5">
                    <div class="text-center">
                        <div class="logo-container mb-4">
                            <div class="logo-icon mb-3">
                                <i class="fas fa-shipping-fast"></i>
                            </div>
                            <h1 class="fw-bold display-4 mb-3">Logistic Company</h1>
                        </div>
                        <p class="lead mb-5 opacity-75">Инновационная система управления доставкой</p>
                        <div class="features-list">
                            <div class="feature-item">
                                <div class="feature-icon">
                                    <i class="fas fa-bolt"></i>
                                </div>
                                <div class="feature-text">
                                    <h6 class="fw-bold mb-1">Мгновенное отслеживание</h6>
                                    <small class="opacity-75">Реальное время положение посылок</small>
                                </div>
                            </div>
                            <div class="feature-item">
                                <div class="feature-icon">
                                    <i class="fas fa-chart-line"></i>
                                </div>
                                <div class="feature-text">
                                    <h6 class="fw-bold mb-1">Аналитика в реальном времени</h6>
                                    <small class="opacity-75">Полная статистика доставок</small>
                                </div>
                            </div>
                            <div class="feature-item">
                                <div class="feature-icon">
                                    <i class="fas fa-robot"></i>
                                </div>
                                <div class="feature-text">
                                    <h6 class="fw-bold mb-1">Автоматизация процессов</h6>
                                    <small class="opacity-75">Умная маршрутизация</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side - Login Form -->
            <div class="col-lg-6 d-flex align-items-center justify-content-center">
                <div class="login-content w-100">
                    <div class="card login-form-card border-0">
                        <div class="card-body p-4 p-md-5">
                            <!-- Header -->
                            <div class="text-center mb-4">
                                <div class="login-icon-container mb-3">
                                    <div class="login-icon-circle">
                                        <i class="fas fa-lock-open"></i>
                                    </div>
                                </div>
                                <h2 class="fw-bold text-black mb-2" style="color: #000 !important; background: none !important; -webkit-text-fill-color: #000 !important;">
                                    С возвращением!
                                </h2>
                                <p class="text-muted">Войдите в свою учетную запись</p>
                            </div>

                            <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="login">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="alert alert-danger rounded-3 border-0" />

                                <!-- Email Field -->
                                <div class="mb-4">
                                    <label class="form-label fw-semibold text-dark mb-3">
                                        <i class="fas fa-envelope me-2"></i>Email адрес
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text">
                                            <i class="fas fa-at"></i>
                                        </span>
                                        <InputText @bind-Value="loginModel.Email"
                                                   type="email"
                                                   class="form-control"
                                                   placeholder="your.email@example.com" />
                                    </div>
                                    <ValidationMessage For="() => loginModel.Email" class="text-danger small mt-2" />
                                </div>

                                <!-- Password Field -->
                                <div class="mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <label class="form-label fw-semibold text-dark mb-0">
                                            <i class="fas fa-key me-2"></i>Пароль
                                        </label>
                                        <NavLink href="/forgot-password" class="text-decoration-none small forgot-password">
                                            Забыли пароль?
                                        </NavLink>
                                    </div>
                                    <div class="password-field">
                                        <div class="input-group input-group-lg">
                                            <span class="input-group-text">
                                                <i class="fas fa-lock"></i>
                                            </span>
                                            <InputText @bind-Value="loginModel.Password"
                                                       type="@(showPassword ? "text" : "password")"
                                                       class="form-control password-input"
                                                       placeholder="Введите ваш пароль" />
                                            <button class="btn btn-outline-secondary password-toggle-btn"
                                                    type="button"
                                                    @onclick="TogglePasswordVisibility">
                                                <i class="@(showPassword ? "fas fa-eye-slash" : "fas fa-eye")"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <ValidationMessage For="() => loginModel.Password" class="text-danger small mt-2" />
                                </div>

                                <!-- Submit Button -->
                                <button type="submit" class="btn btn-login w-100 py-3 fw-bold rounded-3 login-btn">
                                    <i class="fas fa-sign-in-alt me-2"></i>Войти в систему
                                </button>
                            </EditForm>

                            <!-- Divider -->
                            <div class="position-relative my-4">
                                <hr class="my-4" />
                                <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">
                                    или
                                </span>
                            </div>

                            <!-- Registration Link -->
                            <div class="text-center">
                                <p class="text-muted mb-3">Еще нет аккаунта?</p>
                                <NavLink href="/register" class="btn btn-outline-register w-100 py-3 rounded-3">
                                    <i class="fas fa-user-plus me-2"></i>Создать аккаунт
                                </NavLink>
                            </div>

                            <!-- Security Info -->
                            <div class="mt-4 p-3 security-info rounded-3">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-shield-alt me-2 text-primary"></i>
                                    <small class="text-muted">Ваши данные защищены современными методами шифрования</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert alert-danger alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3" role="alert" style="z-index: 1050;">
        <div class="d-flex align-items-center">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <span>@message</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}




@code {
    [SupplyParameterFromForm]
    private LoginModel loginModel { get; set; } = new();
    private string message;
    private bool isLoading = false;

    public class LoginModel
    {
        public string Email { get; set; } = string.Empty; // Инициализируйте свойства
        public string Password { get; set; } = string.Empty;
    }
    private bool showPassword = false;


    private void TogglePasswordVisibility()
    {
        try
        {
            showPassword = !showPassword;

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in TogglePasswordVisibility: {ex.Message}");
        }
    }
    private async Task HandleLogin()
    {
      
    var user = await DbContext.Users
            .FirstOrDefaultAsync(u => u.Email == loginModel.Email);

        if (user != null && BCrypt.Net.BCrypt.Verify(loginModel.Password, user.PasswordHash))
        {
            // создаём claims
            var claims = new List<Claim>
    {
        new Claim(ClaimTypes.Name, user.Email),
        new Claim(ClaimTypes.Role, user.Role)
    };

            var claimsIdentity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);

            await HttpContextAccessor.HttpContext.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme,
                new ClaimsPrincipal(claimsIdentity),
                new AuthenticationProperties
                    {
                        IsPersistent = true,
                        ExpiresUtc = DateTimeOffset.UtcNow.AddDays(30)
                    });

            if (user.Role == "Admin")
                Navigation.NavigateTo("/admin-home");
            else if (user.Role == "Manager")
                Navigation.NavigateTo("/profile");
            else
                Navigation.NavigateTo("/profile");
        }
    }
}

