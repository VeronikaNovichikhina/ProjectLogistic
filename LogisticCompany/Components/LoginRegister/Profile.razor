    private async Task SaveClient()
    {
        try
        {
            using var context = DbContextFactory.CreateDbContext();

            client.ClientTypeId = selectedClientTypeId;

            if (client.ClientsId == 0)
            {
                context.Clients.Add(client);
            }
            else
            {
                context.Clients.Update(client);
            }

            if (selectedClientTypeId == 1)
            {
                individualClient.Clients = client;

                if (individualClient.IndividualId == 0)
                    context.IndividualClients.Add(individualClient);
                else
                    context.IndividualClients.Update(individualClient);
            }
            else if (selectedClientTypeId == 2)
            {
                companyClient.Clients = client;

                if (companyClient.CompanyId == 0)
                    context.CompanyClients.Add(companyClient);
                else
                    context.CompanyClients.Update(companyClient);
            }

            await context.SaveChangesAsync();
            await JS.InvokeVoidAsync("alert", "Данные успешно сохранены!");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Ошибка при сохранении: {ex.Message}");
        }
    }

    private void Logout()
    {
        Navigation.NavigateTo("/logout", true);
    }
    
    private async Task SaveEmployee()
    {
        using var context = DbContextFactory.CreateDbContext();
        isSaving = true;
        saveMessage = "";
        StateHasChanged();

        try
        {
            // Валидация обязательных полей
            if (string.IsNullOrWhiteSpace(adminEmployee.FirstName))
            {
                saveMessage = "Имя обязательно для заполнения";
                isSaveSuccess = false;
                isSaving = false;
                StateHasChanged();
                return;
            }

            if (string.IsNullOrWhiteSpace(adminEmployee.LastName))
            {
                saveMessage = "Фамилия обязательна для заполнения";
                isSaveSuccess = false;
                isSaving = false;
                StateHasChanged();
                return;
            }

            if (string.IsNullOrWhiteSpace(adminEmployee.Phone))
            {
                saveMessage = "Телефон обязателен для заполнения";
                isSaveSuccess = false;
                isSaving = false;
                StateHasChanged();
                return;
            }

            // Обновляем только разрешенные поля
            var employeeToUpdate = await context.Employees
                .FirstOrDefaultAsync(e => e.EmployeeId == adminEmployee.EmployeeId);

            if (employeeToUpdate != null)
            {
                // Обновляем только те поля, которые можно изменять
                employeeToUpdate.FirstName = adminEmployee.FirstName;
                employeeToUpdate.LastName = adminEmployee.LastName;
                employeeToUpdate.PatronymicName = adminEmployee.PatronymicName;
                employeeToUpdate.Phone = adminEmployee.Phone;

                await context.SaveChangesAsync();

                saveMessage = "Данные успешно сохранены!";
                isSaveSuccess = true;

                // Обновляем локальную копию
                adminEmployee = employeeToUpdate;
            }
            else
            {
                saveMessage = "Сотрудник не найден";
                isSaveSuccess = false;
            }
        }
        catch (Exception ex)
        {
            saveMessage = $"Ошибка при сохранении: {ex.Message}";
            isSaveSuccess = false;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();

            // Автоматически скрываем сообщение через 5 секунд
            if (isSaveSuccess)
            {
                _ = HideMessageAfterDelay();
            }
        }
    }

    private async Task HideMessageAfterDelay()
    {
        await Task.Delay(5000);
        saveMessage = "";
        StateHasChanged();
    }
    

}

