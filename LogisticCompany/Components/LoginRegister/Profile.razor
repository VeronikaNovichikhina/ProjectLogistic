@page "/profile"
@using System.ComponentModel.DataAnnotations
@using LogisticCompany.Db
@using LogisticCompany.Domain.Entities.Employee
@using LogisticCompany.Domain.Entities.Location
@using LogisticCompany.Domain.Entities.Orders
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation

@rendermode InteractiveServer


<div class="account-container min-vh-100">
    @if (showPasswordChangeDialog)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header bg-warning text-dark">
                        <div class="d-flex align-items-center w-100">
                            <div class="modal-icon me-3">
                                <i class="fas fa-shield-alt fa-lg"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="modal-title fw-bold mb-0">Требуется смена пароля</h5>
                                <small class="opacity-75">В целях безопасности необходимо установить новый пароль</small>
                            </div>
                        </div>
                    </div>

                    <div class="modal-body p-4">
                        <div class="alert alert-info border-0 mb-4">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-info-circle me-3 fs-5 text-info"></i>
                                <div>
                                    <h6 class="alert-heading mb-1">Вы вошли с временным паролем</h6>
                                    <p class="mb-0">Для обеспечения безопасности вашего аккаунта необходимо установить постоянный пароль.</p>
                                </div>
                            </div>
                        </div>

                        <div class="security-features mb-4">
                            <h6 class="fw-semibold text-dark mb-3">Требования к паролю:</h6>
                            <ul class="list-unstyled">
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <small>Минимум 8 символов</small>
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <small>Как минимум одна цифра</small>
                                </li>
                                <li class="mb-2">
                                    <i class="fas fa-check text-success me-2"></i>
                                    <small>Как минимум одна заглавная буква</small>
                                </li>
                                <li>
                                    <i class="fas fa-check text-success me-2"></i>
                                    <small>Как минимум один специальный символ</small>
                                </li>
                            </ul>
                        </div>
                        <div class="modal-footer bg-light">
                            <div class="d-flex justify-content-between w-100 align-items-center">
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-warning" @onclick="DismissPasswordChange">
                                        <i class="fas fa-times me-2"></i>Больше не показывать
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }
    <div class="container-fluid h-100 p-0">
        <div class="row g-0 h-100">
            <!-- Sidebar -->
            <div class="col-md-3 col-lg-2 sidebar">
                <div class="d-flex flex-column h-100">
                    <!-- Header -->
                    <div class="sidebar-header p-4">
                        <div class="d-flex align-items-center">
                            <div class="user-avatar me-3">
                                <div class="avatar-circle @(isManager ? "bg-gradient-primary" : "bg-gradient-success")">
                                    <i class="fas @(isManager  ? "fa-user-tie" : "fa-user") text-white"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="fw-bold text-white mb-1">
                                    @(isManager ? "Кабинет сотрудника" : "Личный кабинет")
                                </h5>
                                <small class="text-white-50 opacity-75">@(isManager ? currentUser?.Email : client.Email)</small>
                                @if (isManager && adminEmployee != null)
                                {
                                    <small class="text-warning fw-semibold d-block mt-1">
                                        <i class="fas fa-star me-1"></i>@adminEmployee.FirstName @adminEmployee.LastName
                                    </small>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <div class="sidebar-nav flex-grow-1 p-3">
                        <ul class="nav flex-column" id="menuTabs" role="tablist">
                            <li class="nav-item mb-2" role="presentation">
                                <button class="nav-link active" id="main-tab" data-bs-toggle="tab" data-bs-target="#main" type="button" role="tab">
                                    <div class="nav-link-content">
                                        <i class="fas fa-home me-3"></i>
                                        <span>Главная</span>
                                    </div>
                                </button>
                            </li>
                            <li class="nav-item mb-2" role="presentation">
                                <button class="nav-link id="data-tab" data-bs-toggle="tab" data-bs-target="#data" type="button" role="tab">
                                    <div class="nav-link-content">
                                        <i class="fas fa-user-edit me-3"></i>
                                        <span>Личные данные</span>
                                    </div>
                                </button>
                            </li>
                            @if (!isManager)
                            {
                                <li class="nav-item mb-2" role="presentation">
                                    <button class="nav-link " id="packages-tab" data-bs-toggle="tab" data-bs-target="#packages" type="button" role="tab">
                                        <div class="nav-link-content">
                                            <i class="fas fa-box me-3"></i>
                                            <span>Мои посылки</span>
                                            @if (orders?.Any() == true)
                                            {
                                                <span class="badge bg-success ms-auto">@orders.Count</span>
                                            }
                                        </div>
                                    </button>
                                </li>
                            }
                            <li class="nav-item mb-2" role="presentation">
                                <button class="nav-link" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settings" type="button" role="tab">
                                    <div class="nav-link-content">
                                        <i class="fas fa-cog me-3"></i>
                                        <span>Настройки</span>
                                    </div>
                                </button>
                            </li>
                        </ul>
                    </div>

                    <!-- Logout -->
                    <div class="sidebar-footer p-3">
                        <button class="btn btn-logout w-100" @onclick="Logout">
                            <i class="fas fa-sign-out-alt me-2"></i>Выйти
                        </button>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-9 col-lg-10 main-content">
                <div class="tab-content ">
                   
                    <!-- Главная -->
                    <div class="tab-pane fade show active h-100" id="main" role="tabpanel">
                        <div class="p-4 h-100">
                            <div class="row g-4">
                                <!-- Welcome Card -->
                                <div class="col-12">
                                    <div class="card border-0 shadow-lg welcome-card">
                                        <div class="card-body p-4">
                                            <div class="row align-items-center">
                                                <div class="col-md-8">
                                                    <h2 class="fw-bold text-white mb-2">Добро пожаловать!</h2>
                                                    <p class="text-white opacity-75 mb-0">
                                                        Рады видеть вас в личном кабинете Logistic Company.
                                                    </p>
                                                </div>
                                                <div class="col-md-4 text-end">
                                                    <div class="welcome-icon">
                                                        <i class="fas fa-hand-wave"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Quick Actions -->
                                <div class="col-12">
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-header bg-transparent border-0 pb-0">
                                            <h5 class="fw-bold text-dark mb-3">
                                                <i class="fas fa-bolt me-2 text-warning"></i>Быстрые действия
                                            </h5>
                                        </div>
										@if (!isManager)
                                        {
                                            <div class="card-body pt-0">
                                                <div class="row g-3">
                                                    <div class="col-md-4">
                                                        <NavLink class="btn btn-action w-100 p-4" href="/create-order">
                                                            <div class="action-icon mb-3">
                                                                <i class="fas fa-plus-circle"></i>
                                                            </div>
                                                            <h6 class="fw-bold mb-1">Создать заказ</h6>
                                                            <small class="text-muted">Новая отправка</small>
                                                        </NavLink>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <button class="btn btn-action w-100 p-4">
                                                            <div class="action-icon mb-3">
                                                                <i class="fas fa-question-circle"></i>
                                                            </div>
                                                            <h6 class="fw-bold mb-1">Помощь</h6>
                                                            <small class="text-muted">Поддержка 24/7</small>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="card-body pt-0">
                                                <div class="row g-3">
                                                    <div class="col-md-4">
                                                        <NavLink href="/admin-home" class="btn btn-action w-100 p-4">
                                                            <div class="action-icon mb-3">
                                                                <i class="fas fa-plus-circle"></i>
                                                            </div>
                                                            <h6 class="fw-bold mb-1">Перейти к управлению</h6>
                                                        </NavLink>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Личные данные -->
                    <div class="tab-pane fade  h-100" id="data" role="tabpanel">
                        <div class="p-4 h-100 d-flex flex-column">
                            <EditForm Model="@(isManager? adminEmployee : client)" OnValidSubmit="@(isManager? SaveEmployee : SaveClient)" FormName="profile" class="flex-grow-1">
                                <DataAnnotationsValidator />
                                <!-- Сообщение о результате сохранения -->
                                @if (!string.IsNullOrEmpty(saveMessage))
                                {
                                    <div class="alert @(isSaveSuccess ? "alert-success" : "alert-danger") mb-4">
                                        <div class="d-flex align-items-center">
                                            <i class="fas @(isSaveSuccess ? "fa-check-circle" : "fa-exclamation-triangle") me-2"></i>
                                            <span>@saveMessage</span>
                                        </div>
                                    </div>
                                }

                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-header bg-white">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h4 class="fw-bold text-dark mb-0">
                                                <i class="fas fa-user-edit me-2 text-primary"></i>
                                                @(isManager ? "Данные сотрудника" : "Личные данные")
                                            </h4>
                                            @if (isManager)
                                            {
                                                <span class="badge bg-primary bg-opacity-20 text-white px-3 py-2">
                                                    <i class="fas fa-user-tie me-1"></i>Сотрудник
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-20 text-white px-3 py-2">
                                                    <i class="fas fa-user me-1"></i>Клиент
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <!-- Общая информация -->
                                        <div class="row g-4 mb-4">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="form-label fw-semibold text-dark mb-3">
                                                        <i class="fas fa-envelope text-primary me-2"></i>Email
                                                    </label>
                                                    @if (isManager)
                                                    {
                                                        <input class="form-control form-control-lg" value="@(currentUser?.Email ?? "")" disabled />
                                                    }
                                                    else
                                                    {
                                                        <InputText class="form-control form-control-lg" @bind-Value="client.Email" Disabled="true" />
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="form-label fw-semibold text-dark mb-3">
                                                        <i class="fas fa-phone text-primary me-2"></i>Телефон *
                                                    </label>
                                                    @if (isManager)
                                                    {
                                                        <InputText class="form-control form-control-lg"
                                                                   @bind-Value="adminEmployee.Phone" />
                                                        <ValidationMessage For="() => adminEmployee.Phone" class="text-danger small mt-2" />
                                                    }
                                                    else
                                                    {
                                                        <input @bind="client.Phone" @ref="phoneInput" class="form-control form-control-lg" />
                                                        <ValidationMessage For="() => client.Phone" class="text-danger small mt-2" />
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        @if (isManager)
                                        {
                                            <!-- Данные сотрудника -->
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <label class="form-label fw-semibold text-dark">Фамилия *</label>
                                                    <InputText class="form-control form-control-lg"
                                                               @bind-Value="adminEmployee.LastName" />
                                                    <ValidationMessage For="() => adminEmployee.LastName" class="text-danger small mt-2" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label fw-semibold text-dark">Имя *</label>
                                                    <InputText class="form-control form-control-lg"
                                                               @bind-Value="adminEmployee.FirstName" />
                                                    <ValidationMessage For="() => adminEmployee.FirstName" class="text-danger small mt-2" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label fw-semibold text-dark">Отчество</label>
                                                    <InputText class="form-control form-control-lg"
                                                               @bind-Value="adminEmployee.PatronymicName" />
                                                    <ValidationMessage For="() => adminEmployee.PatronymicName" class="text-danger small mt-2" />
                                                </div>

                                                <!-- Неизменяемые поля -->
                                                <div class="col-md-6">
                                                    <label class="form-label fw-semibold text-dark">Должность</label>
                                                    <InputText class="form-control form-control-lg"
                                                               @bind-Value="adminEmployee.Position"
                                                               Disabled="true" />
                                                    <div class="form-text text-muted mt-1">
                                                        <i class="fas fa-info-circle me-1"></i>Для изменения должности обратитесь к администратору
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label fw-semibold text-dark">Филиал</label>
                                                    <InputText class="form-control form-control-lg"
                                                               @bind-Value="adminEmployee.Branch.NameBranches"
                                                               Disabled="true" />
                                                    <div class="form-text text-muted mt-1">
                                                        <i class="fas fa-info-circle me-1"></i>Филиал назначается администратором
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Кнопка сохранения для сотрудника -->
                                            <div class="mt-4 pt-4 border-top">
                                                <div class="row align-items-center">
                                                    <div class="col-md-8">
                                                        <div class="alert alert-info border-0 mb-0">
                                                            <div class="d-flex align-items-center">
                                                                <i class="fas fa-info-circle me-2 text-info"></i>
                                                                <small>Вы можете изменить свои личные данные, кроме должности и филиала</small>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 text-end">
                                                        <button type="submit" class="btn btn-primary btn-lg px-5 py-3">
                                                            <i class="fas fa-save me-2"></i>Сохранить изменения
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- Данные клиента -->
                                            <div class="mb-4">
                                                <label class="form-label fw-semibold text-dark mb-3">Тип клиента*</label>
                                                <InputRadioGroup @bind-Value="selectedClientTypeId">
                                                    <div class="client-type-selector">
                                                        <label class="client-type-option @(selectedClientTypeId == 1 ? "selected" : "")">
                                                            <InputRadio Value="1" />
                                                            <div class="option-content">
                                                                <i class="fas fa-user fa-2x mb-2"></i>
                                                                <span>Физическое лицо</span>
                                                            </div>
                                                        </label>
                                                        <label class="client-type-option @(selectedClientTypeId == 2 ? "selected" : "")">
                                                            <InputRadio Value="2" />
                                                            <div class="option-content">
                                                                <i class="fas fa-building fa-2x mb-2"></i>
                                                                <span>Компания</span>
                                                            </div>
                                                        </label>
                                                    </div>
                                                </InputRadioGroup>
                                            </div>

                                            @if (selectedClientTypeId == 1)
                                            {
                                                <div class="row g-3">
                                                    <div class="col-md-4">
                                                        <label class="form-label fw-semibold text-dark">Фамилия*</label>
                                                        <InputText class="form-control form-control-lg" @bind-Value="individualClient.LastName" />
                                                        <ValidationMessage For="() => individualClient.LastName" class="text-danger small mt-2" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label fw-semibold text-dark">Имя*</label>
                                                        <InputText class="form-control form-control-lg" @bind-Value="individualClient.FirstName" />
                                                        <ValidationMessage For="() => individualClient.FirstName" class="text-danger small mt-2" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label fw-semibold text-dark">Отчество</label>
                                                        <InputText class="form-control form-control-lg" @bind-Value="individualClient.PatronymicName" />
                                                        <ValidationMessage For="() => individualClient.PatronymicName" class="text-danger small mt-2" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label fw-semibold text-dark">Пасспорт*</label>
                                                        <InputText class="form-control form-control-lg" @bind-Value="individualClient.PassportNumber" />
                                                        <ValidationMessage For="() => individualClient.PassportNumber" class="text-danger small mt-2" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label fw-semibold text-dark">Дата выдача пасспорта*</label>
                                                        <InputDate class="form-control form-control-lg" @bind-Value="individualClient.PassportDateOfIssue" />
                                                        <ValidationMessage For="() => individualClient.PassportDateOfIssue" class="text-danger small mt-2" />
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="row g-3">
                                                    <div class="col-md-4">
                                                        <label class="form-label fw-semibold text-dark">Название компании*</label>
                                                        <InputText class="form-control form-control-lg" @bind-Value="companyClient.CompanyName" />
                                                        <ValidationMessage For="() => companyClient.CompanyName" class="text-danger small mt-2" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label fw-semibold text-dark">ИИН*</label>
                                                        <InputText class="form-control form-control-lg" @bind-Value="companyClient.Inn" />
                                                        <ValidationMessage For="() => companyClient.Inn" class="text-danger small mt-2" />
                                                    </div>
                                                </div>
                                            }

                                            <!-- Кнопка сохранения для клиента -->
                                            <div class="mt-4 pt-4 border-top">
                                                <button type="submit" class="btn btn-primary btn-lg px-5 py-3">
                                                    <i class="fas fa-save me-2"></i>Сохранить изменения
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </EditForm>
                        </div>
                    </div>
                    <!-- Посылки -->
                    <div class="tab-pane fade h-100" id="packages" role="tabpanel">
                        <div class="p-4 h-100 d-flex flex-column">
                            @if (orders?.Any() == true)
                            {
                                <div class="card border-0 shadow-sm flex-grow-1">
                                    <div class="card-header bg-white">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h4 class="fw-bold text-dark mb-0">
                                                <i class="fas fa-box me-2 text-success"></i>Мои посылки
                                            </h4>
                                            <NavLink href="/create-order" class="btn btn-primary">
                                                <i class="fas fa-plus-circle me-2"></i>Создать заказ
                                            </NavLink>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-hover align-middle">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th class="border-0">№ Заказа</th>
                                                        <th class="border-0">Описание</th>
                                                        <th class="border-0">Размеры</th>
                                                        <th class="border-0">Вес</th>
                                                        <th class="border-0 text-end">Действия</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var order in orders)
                                                    {
                                                        <tr class="package-row">
                                                            <td>
                                                                <strong class="text-primary">#@order.OrdersId</strong>
                                                            </td>
                                                            <td>
                                                                <div class="package-description">
                                                                    @if (!string.IsNullOrEmpty(order.DescriptionParcel))
                                                                    {
                                                                        <span title="@order.DescriptionParcel">
                                                                            @(order.DescriptionParcel.Length > 50 ? order.DescriptionParcel.Substring(0, 50) + "..." : order.DescriptionParcel)
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-muted">Без описания</span>
                                                                    }
                                                                </div>
                                                            </td>
                                                            <td>
                                                                @if (order.LengthCm > 0 && order.WidthCm > 0 && order.HeightCm > 0)
                                                                {
                                                                    <span>@order.LengthCm × @order.WidthCm × @order.HeightCm см</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">—</span>
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (order.Weight > 0)
                                                                {
                                                                    <span>@order.Weight кг</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="text-muted">—</span>
                                                                }
                                                            </td>
                                                            <td class="text-end">
                                                                <button class="btn btn-outline-primary btn-sm" type="button"
                                                                        @onclick="() => ShowOrderDetails(order.OrdersId)">
                                                                    <i class="fas fa-eye me-1"></i>Подробнее
                                                                </button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="card border-0 shadow-sm flex-grow-1">
                                    <div class="card-body d-flex flex-column justify-content-center align-items-center">
                                        <div class="empty-state text-center">
                                            <i class="fas fa-box-open fa-4x text-muted mb-4"></i>
                                            <h5 class="text-muted mb-3">У вас пока нет посылок</h5>
                                            <p class="text-muted mb-4">Все ваши заказы будут отображаться здесь</p>
