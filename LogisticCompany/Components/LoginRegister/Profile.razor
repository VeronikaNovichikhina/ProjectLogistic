@code {
    [SupplyParameterFromForm]
    private Client client { get; set; } = new();
    private IndividualClient individualClient { get; set; } = new();
    private CompanyClient companyClient { get; set; } = new();
    private List<Client> clients = new List<Client>();
    private List<Order> orders = new List<Order>();
    private Order selectedOrder = null;
    private List<StatusDelivery> statusDelivery = new();
    private string GetStatusBadgeClass(string statusName)
    {
        if (string.IsNullOrEmpty(statusName))
            return "bg-secondary";

        return statusName.ToLower() switch
        {
            "создан" or "ожидает обработки" => "bg-info",
            "принят" or "в обработке" => "bg-primary",
            "передан в доставку" or "в пути" => "bg-warning",
            "на складе" or "доставляется" => "bg-info",
            "у курьера" or "вручение" => "bg-primary",
            "доставлен" or "получен" => "bg-success",
            "отменен" or "отклонен" => "bg-danger",
            "возврат" or "возвращен" => "bg-dark",
            "проблема" or "задержка" => "bg-warning",
            _ => "bg-secondary"
        };
    }
    [Inject]
    private IJSRuntime JS { get; set; }

    [Inject]
    private IDbContextFactory<AppDbContext> DbContextFactory { get; set; }

    private ElementReference phoneInput;
    private int selectedClientTypeId;

    private ChangePasswordModel changePasswordModel = new();
    private bool showCurrentPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;
    private string passwordChangeMessage = "";
    private bool isPasswordChangeSuccess = false;
    private bool isChangingPassword = false;
    private bool showOrderDetailsModal = false;

    private User currentUser;
    private Employee adminEmployee;
    private Branch adminBranch;
    private Town adminTown;
    private Country adminCountry;
    private bool isManager = false;
    private string adminEmail => currentUser?.Email ?? "";

    private bool isSaving = false;
    private string saveMessage = "";
    private bool isSaveSuccess = false;

    private bool showPasswordChangeDialog = false;
    private bool isFirstLogin = false;
    private bool isTempPassword = false;

    public class ChangePasswordModel
    {
        [Required(ErrorMessage = "Текущий пароль обязателен")]
        [Display(Name = "Текущий пароль")]
        public string CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "Новый пароль обязателен")]
        [MinLength(6, ErrorMessage = "Пароль должен содержать минимум 6 символов")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{6,}$",
            ErrorMessage = "Пароль должен содержать заглавные и строчные буквы, а также цифры")]
        [Display(Name = "Новый пароль")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Подтверждение пароля обязательно")]
        [Compare("NewPassword", ErrorMessage = "Пароли не совпадают")]
        [Display(Name = "Подтверждение пароля")]
        public string ConfirmPassword { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        using var db = await DbContextFactory.CreateDbContextAsync();
        await DetermineUserType();

        statusDelivery = await db.StatusDeliveries.ToListAsync();
        if (isManager)
        {
            await LoadAdminData();
        }
        else
        {
            await LoadClientData();
        }
       
        await CheckFirstLogin();
    }

    private async Task CheckFirstLogin()
    {
        try
        {
            var userEmail = HttpContextAccessor.HttpContext?.User?.Identity?.Name;

            if (!string.IsNullOrEmpty(userEmail))
            {
                // Проверяем куки
                var hasChangedPassword = await JS.InvokeAsync<string>("eval",
                    $"document.cookie.replace(/(?:(?:^|.*;\\s*)userPasswordChanged\\s*\\=\\s*([^;]*).*$)|^.*$/, '$1')");

                // ПРОВЕРЯЕМ ВРЕМЕННЫЙ ПАРОЛЬ
                isTempPassword = await IsTemporaryPassword(userEmail);

                Console.WriteLine($"Debug: hasChangedPassword='{hasChangedPassword}', isTempPassword={isTempPassword}"); // ДЛЯ ОТЛАДКИ

                // ПОКАЗЫВАЕМ ДИАЛОГ ТОЛЬКО ЕСЛИ ПАРОЛЬ ВРЕМЕННЫЙ И КУКИ НЕ УСТАНОВЛЕН
                if (isTempPassword)
                {
                    showPasswordChangeDialog = true;
                    StateHasChanged();
                }
                else
                {
                    showPasswordChangeDialog = false;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при проверке первого входа: {ex.Message}");
        }
    }
    private async Task<bool> IsTemporaryPassword(string email)
    {
        try
        {
            using var context = DbContextFactory.CreateDbContext();

            var user = await context.Users
                .FirstOrDefaultAsync(u => u.Email.ToLower() == email.ToLower());

            return user?.IsTemporaryPassword == true;
        }
        catch
        {
            return false;
        }
    }
    private async Task ChangePassword()
    {
        isChangingPassword = true;
        passwordChangeMessage = "";
        StateHasChanged();

        try
        {
            var userEmail = HttpContextAccessor.HttpContext?.User?.Identity?.Name;
            if (string.IsNullOrEmpty(userEmail))
            {
                passwordChangeMessage = "Ошибка: пользователь не аутентифицирован";
                isPasswordChangeSuccess = false;
                return;
            }

            using var context = DbContextFactory.CreateDbContext();

            var user = await context.Users
                .FirstOrDefaultAsync(u => u.Email.ToLower() == userEmail.ToLower());

            if (user == null)
            {
                passwordChangeMessage = "Ошибка: пользователь не найден";
                isPasswordChangeSuccess = false;
                return;
            }

            if (!BCrypt.Net.BCrypt.Verify(changePasswordModel.CurrentPassword, user.PasswordHash))
            {
                passwordChangeMessage = "Ошибка: текущий пароль указан неверно";
                isPasswordChangeSuccess = false;
                return;
            }

            var newPasswordHash = BCrypt.Net.BCrypt.HashPassword(changePasswordModel.NewPassword);
            user.PasswordHash = newPasswordHash;

            await context.SaveChangesAsync();

            // Устанавливаем куки на 1 год
            await JS.InvokeVoidAsync("eval",
                $"document.cookie = 'userPasswordChanged=true; max-age=31536000; path=/'");

            passwordChangeMessage = "Пароль успешно изменен!";
            isPasswordChangeSuccess = true;
            changePasswordModel = new ChangePasswordModel();

            // Закрываем диалог
            showPasswordChangeDialog = false;

            await SendPasswordChangeNotification(userEmail);
        }
        catch (Exception ex)
        {
            passwordChangeMessage = $"Ошибка при смене пароля: {ex.Message}";
            isPasswordChangeSuccess = false;
            Console.WriteLine($"Ошибка смены пароля: {ex.Message}");
        }
        finally
        {
            isChangingPassword = false;
            StateHasChanged();
        }
    }

    private async Task DismissPasswordChange()
    {
        var userEmail = HttpContextAccessor.HttpContext?.User?.Identity?.Name;

        if (!string.IsNullOrEmpty(userEmail))
        {
            // Устанавливаем куки, чтобы больше не показывать
            await JS.InvokeVoidAsync("eval",
                $"document.cookie = 'userPasswordChanged=dismissed; max-age=31536000; path=/'");
        }

        showPasswordChangeDialog = false;
        StateHasChanged();
    }

    private async Task DetermineUserType()
    {
        var userEmail = HttpContextAccessor.HttpContext?.User?.Identity?.Name;

        if (!string.IsNullOrEmpty(userEmail))
        {
            using var context = DbContextFactory.CreateDbContext();

            // Проверяем, является ли пользователь сотрудником
            var employee = await context.Employees
                .Include(e => e.User)
                .FirstOrDefaultAsync(e => e.User != null && e.User.Email.ToLower() == userEmail.ToLower());

            if (employee != null)
            {
                isManager = true;
                currentUser = employee.User;
                adminEmployee = employee;
            }
            else
            {
                isManager = false;
            }
        }
    }
    
   
    private async Task LoadAdminData()
    {
        if (currentUser == null) return;

        using var context = DbContextFactory.CreateDbContext();

        // Загружаем полные данные сотрудника с филиалом
        adminEmployee = await context.Employees
            .Include(e => e.Branch)
                .ThenInclude(b => b.Town)
                .ThenInclude(t => t.Country)
            .Include(e => e.User)
            .FirstOrDefaultAsync(e => e.UserId == currentUser.Id);

        if (adminEmployee?.Branch != null)
        {
            adminBranch = adminEmployee.Branch;
            adminTown = adminBranch.Town;
            adminCountry = adminTown?.Country;
        }

        // Загружаем заказы для админа (заказы его филиала)
        if (adminBranch != null)
        {
            orders = await context.Orders
                .Include(o => o.Template)
                .Include(o => o.DeliveryType)
                .Include(o => o.TransportType)
                .Include(o => o.OriginTown)
                    .ThenInclude(t => t.Country)
                .Include(o => o.DestinationTown)
                    .ThenInclude(t => t.Country)
                .Include(o => o.Clients)
                .Where(o => o.PickupBranchesId == adminBranch.BranchesId ||
                           o.DestinationBranchId == adminBranch.BranchesId)
                .OrderByDescending(o => o.OrdersId)
                .ToListAsync();
        }
    }

    private async Task LoadClientData()
    {
        var userEmail = HttpContextAccessor.HttpContext?.User?.Identity?.Name;

        if (!string.IsNullOrEmpty(userEmail))
        {
            using var context = DbContextFactory.CreateDbContext();

            client = await context.Clients
                .Include(c => c.IndividualClients)
                .Include(c => c.CompanyClients)
                .FirstOrDefaultAsync(c => c.Email == userEmail);

            if (client == null)
            {
                client = new Client { Email = userEmail };
            }
            else
            {
                // Загружаем посылки клиента
                orders = await context.Orders
                    .Include(o => o.Template)
                    .Include(o => o.DeliveryType)
                    .Include(o => o.TransportType)
                    .Include(o => o.OriginTown)
                        .ThenInclude(t => t.Country)
                    .Include(o => o.DestinationTown)
                        .ThenInclude(t => t.Country)
                    .Where(o => o.ClientsId == client.ClientsId)
                    .OrderByDescending(o => o.OrdersId)
                    .ToListAsync();

                if (client.ClientTypeId == 1 && client.IndividualClients?.Any() == true)
                {
                    individualClient = client.IndividualClients.First();
                    selectedClientTypeId = 1;
                }
                else if (client.ClientTypeId == 2 && client.CompanyClients?.Any() == true)
                {
                    companyClient = client.CompanyClients.First();
                    selectedClientTypeId = 2;
                }
            }
        }
    }


