@page "/managment-system"

<div class="adm-page">
    <div class="lc-stripe"><div class="lc-stripe-inner"></div></div>

    <!-- Верхняя панель -->
    <div class="adm-toolbar">
        <div class="adm-toolbar-left">
            <div class="adm-toolbar-ico" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" />
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                </svg>
            </div>
            <div>
                <div class="adm-toolbar-title">Управление компанией</div>
                <div class="adm-toolbar-sub">Администрирование логистической системы</div>
            </div>
        </div>
        <div class="adm-toolbar-right">
            <NavLink href="/profile" class="adm-profile-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                Профиль
            </NavLink>
        </div>
    </div>

    <!-- Карточки разделов -->
    <div class="adm-wrap">
        <div class="adm-grid">

            <!-- Сотрудники -->
            <div class="adm-card">
                <div class="adm-card-hd">
                    <div class="adm-card-ico ico-green" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </div>
                    <div>
                        <div class="adm-card-title">Сотрудники</div>
                        <div class="adm-card-sub">Управление базой сотрудников</div>
                    </div>
                </div>
                <div class="adm-card-body">
                    <NavLink href="/employees" class="adm-btn adm-btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        Просмотр сотрудников
                    </NavLink>
                </div>
            </div>

            <!-- Панель менеджера -->
            <div class="adm-card">
                <div class="adm-card-hd">
                    <div class="adm-card-ico ico-blue" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7" />
                            <rect x="14" y="3" width="7" height="7" />
                            <rect x="14" y="14" width="7" height="7" />
                            <rect x="3" y="14" width="7" height="7" />
                        </svg>
                    </div>
                    <div>
                        <div class="adm-card-title">Панель менеджера</div>
                        <div class="adm-card-sub">Управление заказами и клиентами</div>
                    </div>
                </div>
                <div class="adm-card-body">
                    <NavLink href="/admin-home" class="adm-btn adm-btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <polyline points="12 5 19 12 12 19" />
                        </svg>
                        Просмотр панели менеджера
                    </NavLink>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    /* ============================================================
       AdminHome.razor.css — тёмно-синий + бежевый + оранжевый
       ============================================================ */

    .lc-stripe {
        height: 4px;
        background: #1C3A5E;
    }

    .lc-stripe-inner {
        height: 100%;
        width: 35%;
        background: #F5A623;
        border-radius: 0 3px 3px 0;
    }

    .adm-page {
        min-height: 100vh;
        background: #F5F3EF;
        font-family: 'Segoe UI', system-ui, sans-serif;
        color: #1C2B3A;
    }

    /* ── Тулбар ──────────────────────────────────────────────── */
    .adm-toolbar {
        background: #1C3A5E;
        padding: .85rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .adm-toolbar-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .adm-toolbar-ico {
        width: 36px;
        height: 36px;
        background: rgba(245,166,35,0.2);
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #F5A623;
        flex-shrink: 0;
    }

    .adm-toolbar-title {
        font-size: 16px;
        font-weight: 500;
        color: #fff;
    }

    .adm-toolbar-sub {
        font-size: 11px;
        color: #A8C4DE;
        margin-top: 1px;
    }

    .adm-profile-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.25);
        background: transparent;
        color: #D8E8F5;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.15s;
    }

        .adm-profile-btn:hover {
            background: rgba(255,255,255,0.1);
            color: #fff;
            border-color: rgba(255,255,255,0.4);
        }

    /* ── Обёртка ─────────────────────────────────────────────── */
    .adm-wrap {
        max-width: 860px;
        margin: 0 auto;
        padding: 1.5rem 1rem 3rem;
    }

    .adm-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    @@media (max-width: 640px) {
        .adm-grid {
            grid-template-columns: 1fr;
        }
    }

    /* ── Карточка ────────────────────────────────────────────── */
    .adm-card {
        background: #fff;
        border: 1px solid #E2DBCF;
        border-radius: 14px;
        overflow: hidden;
    }

    .adm-card-hd {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 1rem 1.1rem;
        border-bottom: 1px solid #EDE8E0;
    }

    .adm-card-ico {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .ico-green {
        background: #EAF7F2;
        color: #0F6E56;
    }

    .ico-blue {
        background: #E8F0F9;
        color: #1C3A5E;
    }

    .adm-card-title {
        font-size: 14px;
        font-weight: 500;
        color: #1C2B3A;
    }

    .adm-card-sub {
        font-size: 12px;
        color: #8A8070;
        margin-top: 1px;
    }

    .adm-card-body {
        padding: 1rem 1.1rem;
        display: flex;
        gap: .6rem;
        flex-wrap: wrap;
    }

    /* ── Кнопки ──────────────────────────────────────────────── */
    .adm-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s;
        text-decoration: none;
        border: none;
        white-space: nowrap;
    }

    .adm-btn-primary {
        background: #1C3A5E;
        color: #fff;
    }

        .adm-btn-primary:hover {
            background: #154E8C;
            color: #fff;
        }

    .adm-btn-outline {
        border: 1px solid #D5CCBC;
        background: #fff;
        color: #1C2B3A;
    }

        .adm-btn-outline:hover {
            background: #F5F3EF;
            border-color: #B0A898;
        }
</style>

