@page "/employees"
@using LogisticCompany.Application.DTO
@using LogisticCompany.Application.Interfaces
@using LogisticCompany.DTO
@using LogisticCompany.Db
@using LogisticCompany.Domain.Entities.Employee
@using LogisticCompany.Domain.Entities.Location
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject IJSRuntime JS
@rendermode InteractiveServer

@inject IClientService ClientService
@inject ILocationService LocationService
@inject IDeliveryDictionaryService DeliveryDictionaryService
@inject IPriceCalculatorService PriceCalculator
@inject IOrderService OrderService
@inject IEmployeeService EmployeeService
@inject IEmployeeService EmployeeService


<div class="page-container">
    <div class="container-fluid">
        <!-- Header -->
        <div class="page-header glass-card">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center">
                        <div class="header-icon me-3">
                            <i class="fas fa-users-cog"></i>
                        </div>
                        <div>
                            <h1 class="page-title">Управление сотрудниками</h1>
                            <p class="page-subtitle">Администрирование персонала компании</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <button class="btn btn-primary btn-lg shadow-sm" @onclick="ShowCreateModal">
                        <i class="fas fa-plus-circle me-2"></i>Добавить сотрудника
                    </button>
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stat-card stat-total">
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-value">@(employees?.Count ?? 0)</h3>
                        <p class="stat-label">Всего сотрудников</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-managers">
                    <div class="stat-icon">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-value">@(employees?.Count(e => e.Position == "Менеджер") ?? 0)</h3>
                        <p class="stat-label">Менеджеров</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-couriers">
                    <div class="stat-icon">
                        <i class="fas fa-shipping-fast"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-value">@(employees?.Count(e => e.Position == "Курьер") ?? 0)</h3>
                        <p class="stat-label">Курьеров</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-active">
                    <div class="stat-icon">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-value">@(employees?.Count(e => e.UserId != null) ?? 0)</h3>
                        <p class="stat-label">С аккаунтом</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="filters-card glass-card mb-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-code-branch me-2"></i>Филиал
                        </label>
                        <select @bind="selectedBranchId" class="form-select filter-select" @oninput="OnBranchChanged">
                            <option value="0">Все филиалы</option>
                            @foreach (var branch in branches)
                            {
                                <option value="@branch.BranchesId">@branch.NameBranches</option>
                            }
                        </select>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="filter-group">
                        <label class="filter-label">
                            <i class="fas fa-briefcase me-2"></i>Должность
                        </label>
                        <select @bind="selectedPosition" class="form-select filter-select" @oninput="LoadEmployees">
                            <option value="">Все должности</option>
                            <option value="Менеджер">Менеджер</option>
                            <option value="Курьер">Курьер</option>
                            <option value="Администратор">Администратор</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Employees Table -->
        <div class="main-card glass-card">
            <div class="card-body">
                @if (employees?.Any() == true)
                {
                    <div class="table-container">
                        <table class="employees-table">
                            <thead>
                                <tr>
                                    <th class="employee-id">№</th>
                                    <th class="employee-name">Сотрудник</th>
                                    <th class="employee-position">Должность</th>
                                    <th class="employee-branch">Филиал</th>
                                    <th class="employee-contacts">Контакты</th>
                                    <th class="employee-status">Статус</th>
                                    <th class="employee-actions">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (employee, index) in employees.Select((value, i) => (value, i)))
                                {
                                    <tr class="employee-row">
                                        <td class="employee-id">@(index + 1)</td>
                                        <td class="employee-name">
                                            <div class="employee-avatar">
                                                <div class="avatar-circle @GetPositionClass(employee.Position)">
                                                    <i class="@GetPositionIcon(employee.Position)"></i>
                                                </div>
                                            </div>
                                            <div class="employee-info">
                                                <div class="employee-fullname">
                                                    @employee.LastName @employee.FirstName @employee.PatronymicName
                                                </div>
                                            </div>
                                        </td>
                                        <td class="employee-position">
                                            <span class="position-badge @GetPositionBadgeClass(employee.Position)">
                                                @employee.Position
                                            </span>
                                        </td>
                                        <td class="employee-branch">
                                            <div class="branch-info">
                                                <i class="fas fa-building me-2 text-muted"></i>
                                                <span>@employee.Branch?.NameBranches</span>
                                            </div>
                                            <small class="text-muted">@employee.Branch?.Town?.TownName</small>
                                        </td>
                                        <td class="employee-contacts">
                                            <div class="contact-item">
                                                <i class="fas fa-envelope text-primary me-2"></i>
                                                <span>@employee.Email</span>
                                            </div>
                                            <div class="contact-item">
                                                <i class="fas fa-phone text-success me-2"></i>
                                                <span>@employee.Phone</span>
                                            </div>
                                        </td>
                                        <td class="employee-status">
                                            @if (employee.UserId != null)
                                            {
                                                <span class="status-badge status-active">
                                                    <i class="fas fa-check-circle me-1"></i>Активен
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-inactive">
                                                    <i class="fas fa-exclamation-circle me-1"></i>Без аккаунта
                                                </span>
                                            }
                                        </td>
                                        <td class="employee-actions">
                                            <div class="action-buttons">
                                                <button class="btn-action btn-view"
                                                        @onclick="() => ShowEmployeeDetails(employee.EmployeeId)"
                                                        >Просмотр
                                                    <i class="fas fa-eye"></i>
                                                </button>
                                                <button class="btn-action btn-delete"
                                                         @onclick="() => DeleteEmployee(employee.EmployeeId)" 
                                                       >Удалить
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <h4 class="empty-title">Сотрудники не найдены</h4>
                        <p class="empty-description">Добавьте первого сотрудника или измените параметры поиска</p>
                        <button class="btn btn-primary" @onclick="ShowCreateModal">
                            <i class="fas fa-plus me-2"></i>Добавить сотрудника
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Employee Details Modal -->
@if (showDetailsModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content glass-modal">
                <div class="modal-header">
                    <div class="modal-title-section">
                        <div class="modal-icon">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <div>
                            <h5 class="modal-title">Информация о сотруднике</h5>
                            <p class="modal-subtitle">Детальная информация и контакты</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseDetailsModal"></button>
                </div>
                <div class="modal-body">
                    @if (selectedEmployee != null)
                    {
                        <div class="employee-details">
                            <!-- Header Info -->
                            <div class="detail-header">
                                <div class="detail-avatar @GetPositionClass(selectedEmployee.Position)">
                                    <i class="@GetPositionIcon(selectedEmployee.Position)"></i>
                                </div>
                                <div class="detail-info">
                                    <h4 class="detail-name">
                                        @selectedEmployee.LastName @selectedEmployee.FirstName @selectedEmployee.PatronymicName
                                    </h4>
                                    <div class="detail-meta">
                                        <span class="detail-position @GetPositionBadgeClass(selectedEmployee.Position)">
                                            @selectedEmployee.Position
                                        </span>
                                        
                                    </div>
                                </div>
                            </div>

                            <div class="row g-4 mt-3">
                                <!-- Personal Info -->
                                <div class="col-md-6">
                                    <div class="detail-card">
                                        <div class="detail-card-header">
                                            <i class="fas fa-id-card text-primary me-2"></i>
                                            <h6>Основная информация</h6>
                                        </div>
                                        <div class="detail-card-body">
                                            <div class="detail-item">
                                                <label>ФИО:</label>
                                                <span>@selectedEmployee.LastName @selectedEmployee.FirstName @selectedEmployee.PatronymicName</span>
                                            </div>
                                            <div class="detail-item">
                                                <label>Должность:</label>
                                                <span class="text-primary fw-bold">@selectedEmployee.Position</span>
                                            </div>
                                            <div class="detail-item">
                                                <label>Статус аккаунта:</label>
                                                @if (selectedEmployee.UserId != null)
                                                {
                                                    <span class="status-badge status-active">
                                                        <i class="fas fa-check-circle me-1"></i>Активен
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge status-inactive">
                                                        <i class="fas fa-exclamation-circle me-1"></i>Без аккаунта
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Contact Info -->
                                <div class="col-md-6">
                                    <div class="detail-card">
                                        <div class="detail-card-header">
                                            <i class="fas fa-address-book text-success me-2"></i>
                                            <h6>Контактная информация</h6>
                                        </div>
                                        <div class="detail-card-body">
                                            <div class="detail-item">
                                                <label>Email:</label>
                                                <span>
                                                    <i class="fas fa-envelope me-1 text-muted"></i>
                                                    @selectedEmployee.Email
                                                </span>
                                            </div>
                                            <div class="detail-item">
                                                <label>Телефон:</label>
                                                <span>
                                                    <i class="fas fa-phone me-1 text-muted"></i>
                                                    @selectedEmployee.Phone
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Branch Info -->
                                <div class="col-12">
                                    <div class="detail-card">
                                        <div class="detail-card-header">
                                            <i class="fas fa-building text-warning me-2"></i>
                                            <h6>Информация о филиале</h6>
                                        </div>
                                        <div class="detail-card-body">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <div class="detail-item">
                                                        <label>Страна филиала:</label>
                                                        <span>
                                                            <i class="fas fa-phone me-1 text-muted"></i>
                                                            @selectedEmployee.Branch?.Town?.Country?.CountryName
                                                        </span>
                                                    </div>
                                                    <div class="detail-item">
                                                        <label>Город филиала:</label>
                                                        <span>
                                                            <i class="fas fa-city me-1 text-muted"></i>
                                                            @selectedEmployee.Branch?.Town?.TownName
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="detail-item">
