                                                    </div>
                                                    <div class="detail-item">
                                                        <label>Адрес:</label>
                                                        <span>
                                                            <i class="fas fa-map-marker-alt me-1 text-muted"></i>
                                                            @selectedEmployee.Branch?.AddressBranches
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="detail-item">
                                                        <label>Телефон филиала:</label>
                                                        <span>
                                                            <i class="fas fa-phone me-1 text-muted"></i>
                                                            @selectedEmployee.Branch?.PhoneBranches
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDetailsModal">
                        <i class="fas fa-times me-2"></i>Закрыть
                    </button>
                    <button class="btn btn-primary"
                            @onclick="() => { EditEmployeeFromDetails(selectedEmployee.EmployeeId); CloseDetailsModal(); }">
                        <i class="fas fa-edit me-2"></i>Редактировать
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Add/Edit Employee Modal -->
@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content glass-modal">
                <div class="modal-header">
                    <div class="modal-title-section">
                        <div class="modal-icon @(isEditing ? "bg-warning" : "bg-primary")">
                            <i class="fas @(isEditing ? "fa-edit" : "fa-user-plus")"></i>
                        </div>
                        <div>
                            <h5 class="modal-title">@(isEditing ? "Редактирование сотрудника" : "Добавление сотрудника")</h5>
                            <p class="modal-subtitle">@(isEditing ? "Обновите информацию о сотруднике" : "Заполните данные нового сотрудника")</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="employeeDto" OnValidSubmit="SaveEmployee">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label required">Фамилия</label>
                                    <InputText @bind-Value="employeeDto.LastName" class="form-control modern-input" />
                                    <ValidationMessage For="() => employeeDto.LastName" class="validation-error" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label required">Имя</label>
                                    <InputText @bind-Value="employeeDto.FirstName" class="form-control modern-input" />
                                    <ValidationMessage For="() => employeeDto.FirstName" class="validation-error" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label class="form-label">Отчество</label>
                                    <InputText @bind-Value="employeeDto.PatronymicName" class="form-control modern-input" />
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label required">Email</label>
                                    <div class="input-with-icon">
                                        <i class="fas fa-envelope input-icon"></i>
                                        <InputText @bind-Value="employeeDto.Email" class="form-control modern-input" />
                                    </div>
                                    <ValidationMessage For="() => employeeDto.Email" class="validation-error" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label required">Телефон</label>
                                    <div class="input-with-icon">
                                        <i class="fas fa-phone input-icon"></i>
                                        <InputText @bind-Value="employeeDto.Phone" class="form-control modern-input" />
                                    </div>
                                    <ValidationMessage For="() => employeeDto.Phone" class="validation-error" />
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label required">Должность</label>
                                    <InputSelect @bind-Value="employeeDto.Position" class="form-select modern-select">
                                        <option value="">Выберите должность</option>
                                        <option value="Менеджер">Менеджер</option>
                                        <option value="Курьер">Курьер</option>
                                        <option value="Администратор">Администратор</option>
                                    </InputSelect>
                                    <ValidationMessage For="() => employeeDto.Position" class="validation-error" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label required">Страна филиала</label>
                                    <InputSelect @bind-Value="employeeDto.CountryId" class="form-select modern-select">
                                        <option value="0">Выберите страну</option>
                                        @foreach (var c in country)
                                        {
                                            <option value="@c.CountryId">@c.CountryName</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => employeeDto.CountryId" class="validation-error" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label required">Город филиала</label>
                                    <InputSelect @bind-Value="employeeDto.TownId" class="form-select modern-select">
                                        <option value="0">Выберите город</option>
                                        @foreach (var t in FilteredTowns)
                                        {
                                            <option value="@t.TownId">@t.TownName</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => employeeDto.TownId" class="validation-error" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label required">Филиал</label>
                                    <InputSelect @bind-Value="employeeDto.BranchId" class="form-select modern-select">
                                        <option value="0">Выберите филиал</option>
                                        @foreach (var branch in FilteredBranches)
                                        {
                                            <option value="@branch.BranchesId">@branch.NameBranches</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => employeeDto.BranchId" class="validation-error" />
                                </div>
                            </div>
                        </div>

                        @if (!isEditing)
                        {
                            <div class="form-check modern-checkbox">
                                <InputCheckbox @bind-Value="employeeDto.CreateUserAccount" class="form-check-input" id="createAccount" />
                                <label class="form-check-label" for="createAccount">
                                    <i class="fas fa-user-plus me-2"></i>Создать учетную запись для входа в систему
                                </label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">
                            <i class="fas fa-times me-2"></i>Отмена
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas @(isEditing ? "fa-save" : "fa-plus-circle") me-2"></i>
                            @(isEditing ? "Обновить" : "Создать")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}


@code {
    [SupplyParameterFromForm]
    private OrdersDTO order { get; set; } = new();
    private List<Employee> employees = new();
    private List<Branch> branches = new();
    private List<Town> town = new();
    private List<Country> country = new();
    private EmployeeDTO employeeDto = new();
    private bool showModal = false;
    private bool isEditing = false;
    private int selectedBranchId = 0;
    private string searchTerm = "";
    private string selectedPosition = "";
    private bool showDetailsModal = false;
    private Employee selectedEmployee = null;

    
    protected override async Task OnInitializedAsync()
    {
		await LoadEmployees();
        branches = await LocationService.GetAllBranchesAsync();
        town = await LocationService.GetAllTownAsync();
        country = await LocationService.GetAllCountriesAsync();

    }
    private async Task LoadEmployees()
    {
        employees = await EmployeeService.GetEmployeesAsync(
            selectedBranchId,
            selectedPosition,
            searchTerm);
    }
    private IEnumerable<Town> FilteredTowns => LocationService.GetTownsByCountry(employeeDto.CountryId, town);
    private IEnumerable<Branch> FilteredBranches => LocationService.GetBranchesByTown(employeeDto.TownId, branches);
   

    private async Task OnBranchChanged()
    {
        await LoadEmployees();
    }

    private async Task SaveEmployee()
    {
        try
        {
            CreateEmployeeResult? result = null;

            if (isEditing)
            {
                await EmployeeService.UpdateAsync(employeeDto);
            }
            else
            {
                result = await EmployeeService.CreateAsync(employeeDto);

                if (result.UserCreated && !string.IsNullOrEmpty(result.TemporaryPassword))
                {
                    await JS.InvokeVoidAsync(
                        "alert",
                        $"Сотрудник создан!\n\nДанные для входа:\n" +
                        $"Логин: {employeeDto.Email}\n" +
                        $"Пароль: {result.TemporaryPassword}"
                    );
                }
            }

            await LoadEmployees();
            CloseModal();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
    }
    private async Task EditEmployee(int employeeId)
    {
        var employee = await EmployeeService.GetByIdAsync(employeeId);

        if (employee == null)
            return;

        employeeDto = new EmployeeDTO
        {
            EmployeeId = employee.EmployeeId,
            FirstName = employee.FirstName,
            LastName = employee.LastName,
            PatronymicName = employee.PatronymicName,
            Email = employee.Email,
            Phone = employee.Phone,
            Position = employee.Position,
            BranchId = employee.BranchId
        };

        isEditing = true;
        showModal = true;
    }
    private async Task DeleteEmployee(int employeeId)
    {
        bool confirmed = await JS.InvokeAsync<bool>(
       "confirm",
       "Вы уверены, что хотите удалить сотрудника?\nЭто действие нельзя отменить."
   );

        if (!confirmed)
            return;

        try
        {
            await EmployeeService.DeleteAsync(employeeId);

            await LoadEmployees();

            await JS.InvokeVoidAsync("alert", "Сотрудник успешно удалён");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
    }

    
    private async Task ToggleEmployeeStatus(int employeeId)
    {
        try
        {
            await EmployeeService.ToggleEmployeeStatusAsync(employeeId);
            await LoadEmployees();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
    }
    private async Task ShowEmployeeDetails(int employeeId)
    {
        try
        {
            showDetailsModal = true;
            selectedEmployee = null;
            StateHasChanged();

            selectedEmployee = await EmployeeService.GetEmployeeDetailsAsync(employeeId);

            if (selectedEmployee == null)
            {
                await JS.InvokeVoidAsync("alert", "Сотрудник не найден");
                CloseDetailsModal();
                return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки деталей сотрудника: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Ошибка загрузки информации о сотруднике");
            CloseDetailsModal();
        }
    }
    private async Task EditEmployeeFromDetails(int employeeId)
    {
        CloseDetailsModal();
        await Task.Delay(300); 
        await EditEmployee(employeeId);
    }

    //иконки
    private string GetPositionClass(string position)
    {
        return position?.ToLower() switch
        {
            "менеджер" => "avatar-manager",
            _ => "avatar-admin"
        };
    }
    private string GetPositionIcon(string position)
    {
        return position?.ToLower() switch
        {
            "менеджер" => "fas fa-user-tie",
            _ => "fas fa-user"
        };
    }
    private string GetPositionBadgeClass(string position)
    {
        return position?.ToLower() switch
        {
            "менеджер" => "badge-manager",
            _ => "badge-admin"
        };
    }
    
	//откртыие/закрытие модалок
    private void ShowCreateModal()
    {
        employeeDto = new EmployeeDTO();
        isEditing = false;
        showModal = true;
    }
    private void CloseDetailsModal()
    {
        showDetailsModal = false;
        selectedEmployee = null;
        StateHasChanged();
    }
    private void CloseModal()
    {
        showModal = false;
        employeeDto = new EmployeeDTO();
        StateHasChanged();
    }

  
}


