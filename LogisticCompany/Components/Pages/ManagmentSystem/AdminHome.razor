@page "/admin-home"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Manager")]

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center">
                        <div class="header-icon me-3">
                            <i class="fas fa-tachometer-alt"></i>
                        </div>
                        <div>
                            <h1 class="fw-bold text-white mb-1">Панель управления</h1>
                            <p class="text-white-50 mb-0">Обзор системы и быстрый доступ</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <NavLink class="btn btn-light btn-gradient fw-semibold" href="/profile">
                        <i class="fas fa-user-circle me-2"></i>Мой аккаунт
                    </NavLink>
                </div>
            </div>
        </div>
    </div>

   
    <!-- Main Cards -->
    <div class="container mt-5">
        <div class="row g-4">
            <!-- Карточка клиентов -->
            <div class="col-xl-6">
                <div class="feature-card clients-card">
                    <div class="card-header">
                        <div class="d-flex align-items-center">
                            <div class="card-icon me-3">
                                <i class="fas fa-users"></i>
                            </div>
                            <div>
                                <h3 class="card-title">Управление клиентами</h3>
                                <p class="card-subtitle">Физическое лица и юридическое лицо</p>
                            </div>
                        </div>
                        
                    </div>
                    <div class="card-body">
                        <div class="card-actions">
                            <NavLink class="btn btn-primary btn-card" href="/clientList">
                                <i class="fas fa-list me-2"></i>Список клиентов
                            </NavLink>
                            <NavLink class="btn btn-outline-primary btn-card" href="/clients/create">
                                <i class="fas fa-list me-2"></i>Добавить клиента
                            </NavLink>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Карточка заказов -->
            <div class="col-xl-6">
                <div class="feature-card orders-card">
                    <div class="card-header">
                        <div class="d-flex align-items-center">
                            <div class="card-icon me-3">
                                <i class="fas fa-boxes"></i>
                            </div>
                            <div>
                                <h3 class="card-title">Управление заказами</h3>
                                <p class="card-subtitle">Все отправления системы</p>
                            </div>
                        </div>
                        
                    </div>
                    <div class="card-body">
                        <div class="card-actions">
                            <NavLink class="btn btn-success btn-card" href="/ordersList">
                                <i class="fas fa-clipboard-list me-2"></i>Все заказы
                            </NavLink>
                            <NavLink class="btn btn-outline-success btn-card" href="/orders/create">
                                <i class="fas fa-clipboard-list me-2"></i>Оформить заказ
                            </NavLink>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dashboard-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    .dashboard-header {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        padding: 2rem 0;
    }

    .header-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.1) 100%);
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: white;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.2);
    }

    .stats-badge {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 25px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        font-size: 0.9rem;
    }

    .stat-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
        margin-right: 1rem;
        flex-shrink: 0;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: bold;
        margin: 0;
        color: #2c3e50;
    }

    .stat-label {
        color: #6c757d;
        margin: 0;
        font-size: 0.9rem;
    }

    .feature-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 24px;
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.3);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 25px 50px rgba(0,0,0,0.15);
        }

        .feature-card .card-header {
            background: linear-gradient(135deg, #f8f9ff 0%, #f0f2ff 100%);
            border-bottom: 1px solid rgba(0,0,0,0.05);
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

    .card-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        color: white;
    }

    .clients-card .card-icon {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .orders-card .card-icon {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    }

    .card-title {
        font-size: 1.4rem;
        font-weight: bold;
        color: #2c3e50;
        margin: 0;
    }

    .card-subtitle {
        color: #6c757d;
        margin: 0;
        font-size: 0.9rem;
    }

    .card-badge .badge {
        background: rgba(102, 126, 234, 0.1);
        color: #667eea;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 500;
    }

    .feature-card .card-body {
        padding: 1.5rem;
    }

    .card-features {
        margin-bottom: 1.5rem;
    }

    .feature {
        display: flex;
        align-items: center;
        padding: 0.75rem 0;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

        .feature:last-child {
            border-bottom: none;
        }

        .feature i {
            width: 20px;
            margin-right: 0.75rem;
            font-size: 1rem;
        }

    .card-actions {
        display: flex;
        gap: 0.75rem;
    }

    .btn-card {
        flex: 1;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .btn-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

    .quick-action-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        padding: 2rem;
        text-align: center;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        transition: all 0.3s ease;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        height: 100%;
    }

        .quick-action-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        }

    .action-icon {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: white;
        margin: 0 auto 1rem;
    }

    .quick-action-card h4 {
        font-weight: bold;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .quick-action-card p {
        color: #6c757d;
        margin-bottom: 1.5rem;
    }

    /* Анимации */
    .feature-card, .stat-card, .quick-action-card {
        animation: slideUp 0.6s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Адаптивность */
    @@media (max-width: 768px) {
        .dashboard-header {
            padding: 1.5rem 0;
        }

        .header-icon {
            width: 50px;
            height: 50px;
            font-size: 1.5rem;
        }

        .stat-card {
            padding: 1rem;
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            font-size: 1.3rem;
        }

        .stat-value {
            font-size: 1.5rem;
        }

        .card-actions {
            flex-direction: column;
        }

        .feature-card .card-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
        }

        .card-badge {
            align-self: flex-start;
        }
    }
</style>

