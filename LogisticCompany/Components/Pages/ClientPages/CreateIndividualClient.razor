@page "/clients/create-individual/{ClientId:int}"
@using LogisticCompany.Application.Interfaces
@using LogisticCompany.DTO
@using LogisticCompany.Db
@using Presentation.Shared
@inherits ClientBaseComponent
@rendermode InteractiveServer

<div class="office-manager-page bg-light min-vh-100">
    <!-- Хлебные крошки -->
    <div class="container-fluid py-2 border-bottom bg-white">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="#" class="text-decoration-none small" @onclick="GoBack">
                            <i class="fas fa-chevron-left me-1"></i>Клиенты
                        </a>
                    </li>
                    <li class="breadcrumb-item active small" aria-current="page">Новое физ. лицо</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container py-3">
        <div class="row">
            <!-- Основной контент -->
            <div class="col-lg-8">
                <!-- Заголовок -->
                <div class="d-flex align-items-center mb-3">
                    <div class="status-badge bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                         style="width: 36px; height: 36px; font-size: 14px;">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <h1 class="h5 fw-bold mb-1">Создание физического лица</h1>
                        <p class="text-muted small mb-0">Заполните персональные данные клиента</p>
                    </div>
                </div>

                @if (Loading)
                {
                    <!-- Loading State -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center py-4">
                            <div class="spinner-border text-primary mb-2" role="status" style="width: 2rem; height: 2rem;">
                                <span class="visually-hidden">Загрузка...</span>
                            </div>
                            <h5 class="text-muted" style="font-size: 14px;">Подготовка формы...</h5>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center mb-3 py-2" role="alert">
                        <i class="fas fa-exclamation-triangle me-2" style="font-size: 14px;"></i>
                        <div class="small">@ErrorMessage</div>
                    </div>
                }
                else
                {
                    <EditForm Model="individualDto" OnValidSubmit="() => HandleAsync(SaveIndividual)" FormName="createInd">
                        <DataAnnotationsValidator />

                        <!-- Персональные данные -->
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-header bg-white border-bottom py-2">
                                <h6 class="fw-semibold mb-0 d-flex align-items-center">
                                    <i class="fas fa-id-card text-primary me-2" style="font-size: 14px;"></i>
                                    Персональные данные
                                </h6>
                            </div>
                            <div class="card-body p-3">
                                <!-- ФИО в одной строке -->
                                <div class="row g-3 mb-4">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="form-label fw-semibold mb-2 d-flex align-items-center"
                                                   style="font-size: 14px; color: #495057;">
                                                <i class="fas fa-user text-muted me-2" style="font-size: 13px;"></i>
                                                Имя *
                                                <span class="ms-1 badge bg-light text-dark border" style="font-size: 11px;">Обязательно</span>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0 py-1 px-2">
                                                    <i class="fas fa-signature text-muted" style="font-size: 14px;"></i>
                                                </span>
                                                <InputText @bind-Value="individualDto.FirstName"
                                                           class="form-control border-start-0 py-1"
                                                           placeholder="Иван"
                                                           style="font-size: 14px;" />
                                            </div>
                                            <ValidationMessage For="() => individualDto.FirstName" class="text-danger" style="font-size: 12px;" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="form-label fw-semibold mb-2"
                                                   style="font-size: 14px; color: #495057;">
                                                Отчество
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0 py-1 px-2">
                                                    <i class="fas fa-user text-muted" style="font-size: 14px;"></i>
                                                </span>
                                                <InputText @bind-Value="individualDto.PatronymicName"
                                                           class="form-control border-start-0 py-1"
                                                           placeholder="Иванович"
                                                           style="font-size: 14px;" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="form-label fw-semibold mb-2 d-flex align-items-center"
                                                   style="font-size: 14px; color: #495057;">
                                                Фамилия *
                                                <span class="ms-1 badge bg-light text-dark border" style="font-size: 11px;">Обязательно</span>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0 py-1 px-2">
                                                    <i class="fas fa-user text-muted" style="font-size: 14px;"></i>
                                                </span>
                                                <InputText @bind-Value="individualDto.LastName"
                                                           class="form-control border-start-0 py-1"
                                                           placeholder="Иванов"
                                                           style="font-size: 14px;" />
                                            </div>
                                            <ValidationMessage For="() => individualDto.LastName" class="text-danger" style="font-size: 12px;" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Паспортные данные -->
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label fw-semibold mb-2 d-flex align-items-center"
                                                   style="font-size: 14px; color: #495057;">
                                                <i class="fas fa-passport text-muted me-2" style="font-size: 13px;"></i>
                                                Паспорт *
                                                <span class="ms-1 badge bg-light text-dark border" style="font-size: 11px;">Обязательно</span>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0 py-1 px-2">
                                                    <i class="fas fa-id-card text-muted" style="font-size: 14px;"></i>
                                                </span>
                                                <InputText @bind-Value="individualDto.PassportNumber"
                                                           maxlength="12"
                                                           class="form-control border-start-0 py-1"
                                                           placeholder="123456789012"
                                                           style="font-size: 14px;" />
                                            </div>
                                            <ValidationMessage For="() => individualDto.PassportNumber" class="text-danger" style="font-size: 12px;" />
                                            <div class="form-text" style="font-size: 12px;">
                                                <i class="fas fa-info-circle me-1"></i>
                                                12-значный номер паспорта
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label fw-semibold mb-2 d-flex align-items-center"
                                                   style="font-size: 14px; color: #495057;">
                                                <i class="fas fa-calendar-alt text-muted me-2" style="font-size: 13px;"></i>
                                                Дата истечения *
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0 py-1 px-2">
                                                    <i class="fas fa-calendar text-muted" style="font-size: 14px;"></i>
                                                </span>
                                                <InputDate @bind-Value="individualDto.PassportDateOfIssue"
                                                           class="form-control border-start-0 py-1"
                                                           style="font-size: 14px;" />
                                            </div>
                                            <ValidationMessage For="() => individualDto.PassportDateOfIssue" class="text-danger" style="font-size: 12px;" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Статус паспорта -->
                                @if (individualDto.PassportDateOfIssue.HasValue)
                                {
                                    <div class="mt-3">
                                        @if (individualDto.IsPassportExpired)
                                        {
                                            <div class="alert alert-danger border py-2 mb-0">
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-exclamation-triangle me-2" style="font-size: 14px;"></i>
                                                    <div class="small" style="font-size: 13px;">
                                                        <strong>Паспорт просрочен!</strong> Невозможно создать клиента с недействительным паспортом.
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else if (individualDto.DaysUntilExpiry <= 30)
                                        {
                                            <div class="alert alert-warning border py-2 mb-0">
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-exclamation-circle me-2" style="font-size: 14px;"></i>
                                                    <div class="small" style="font-size: 13px;">
                                                        <strong>Срок истекает через @individualDto.DaysUntilExpiry дней</strong>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="alert alert-success border py-2 mb-0">
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-check-circle me-2" style="font-size: 14px;"></i>
                                                    <div class="small" style="font-size: 13px;">
                                                        <strong>Паспорт действителен</strong> (осталось @individualDto.DaysUntilExpiry дней)
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Панель действий -->
                        <div class="action-panel bg-white border rounded p-3 shadow-sm">
                            <div class="row g-2 align-items-center">
                                <div class="col-md-8">
                                    <div class="d-flex align-items-center">
                                        <div class="me-3">
                                            <span class="badge bg-primary rounded-pill py-1 px-2" style="font-size: 12px;">
                                                <i class="fas fa-user me-1"></i>
                                                Физ. лицо
                                            </span>
                                        </div>
                                        <div class="text-muted" style="font-size: 12px;">
                                            <i class="fas fa-shield-alt me-1"></i>
                                            Данные защищены в соответствии с ФЗ-152
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                        <button type="button"
                                                class="btn btn-outline-secondary px-3"
                                                @onclick="GoBack"
                                                disabled="@Loading"
                                                style="font-size: 14px; padding: 6px 12px;">
                                            <i class="fas fa-times me-1"></i>
                                            Отмена
                                        </button>
                                        <button type="submit"
                                                class="btn btn-primary px-3"
                                                style="font-size: 14px; padding: 6px 12px;">
                                            @if (Loading)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                <span>Сохранение...</span>
                                            }
                                            else
                                            {
                                                <i class="fas fa-save me-1"></i>
                                                <span>Сохранить</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                }

                <!-- Защита данных -->
                <div class="card border-0 shadow-sm mt-3">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-start">
                            <div class="flex-shrink-0">
                                <i class="fas fa-shield-alt text-success me-2" style="font-size: 14px;"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-bold text-dark mb-2" style="font-size: 14px;">Защита персональных данных</h6>
                                <ul class="text-muted mb-0" style="font-size: 13px; padding-left: 1.2rem;">
                                    <li class="mb-1">Все данные защищены по стандарту ФЗ-152</li>
                                    <li class="mb-1">Паспортные данные используются только для идентификации</li>
                                    <li>Доступ имеют только уполномоченные сотрудники</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Боковая панель -->
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 15px;">
                    <!-- Быстрая проверка -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="fw-semibold mb-0" style="font-size: 14px;">
                                <i class="fas fa-search me-2 text-info" style="font-size: 13px;"></i>
                                Проверка паспорта
                            </h6>
                        </div>
                        <div class="card-body py-2">
                            <div class="mb-2 d-flex">
                                <div class="me-3 text-success">
                                    <i class="fas fa-check-circle" style="font-size: 12px;"></i>
                                </div>
                                <div>
                                    <span class="small d-block" style="font-size: 13px;">12 цифр без пробелов</span>
                                    <span class="text-muted" style="font-size: 12px;">Пример: 123456789012</span>
                                </div>
                            </div>
                            <div class="mb-2 d-flex">
                                <div class="me-3 text-success">
                                    <i class="fas fa-check-circle" style="font-size: 12px;"></i>
                                </div>
                                <div>
                                    <span class="small d-block" style="font-size: 13px;">Дата выдачи</span>
                                    <span class="text-muted" style="font-size: 12px;">Свидетельство о рождении не принимается</span>
                                </div>
                            </div>
                            <div class="d-flex">
                                <div class="me-3 text-success">
                                    <i class="fas fa-check-circle" style="font-size: 12px;"></i>
                                </div>
                                <div>
                                    <span class="small d-block" style="font-size: 13px;">Срок действия</span>
                                    <span class="text-muted" style="font-size: 12px;">Паспорт должен быть действующим</span>
                                </div>
                            </div>
                        </div>
                    </div>

                   
                    
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .office-manager-page {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        font-size: 14px;
    }

    .form-control {
        font-size: 14px;
        padding: 6px 12px;
        height: 36px;
    }

    .input-group-text {
        font-size: 14px;
        padding: 6px 12px;
        height: 36px;
    }

    /* Увеличенные заголовки полей */
    .form-label {
        font-size: 14px;
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
    }

    .btn {
        font-size: 14px;
        padding: 6px 12px;
        height: 36px;
    }

    .btn-sm {
        font-size: 13px;
        padding: 5px 10px;
        height: 32px;
    }

    .action-panel {
        position: sticky;
        bottom: 15px;
        z-index: 1000;
        margin-top: 15px;
        font-size: 14px;
    }

    .status-badge {
        width: 36px;
        height: 36px;
        font-size: 14px;
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
        font-size: 13px;
    }

    .card-header {
        padding: 8px 16px;
    }

    .card-body {
        padding: 16px;
    }

    .alert {
        padding: 8px 12px;
        font-size: 13px;
    }

    .badge {
        font-size: 11px;
        padding: 4px 8px;
    }

    input.form-control:focus,
    select.form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
        outline: none;
    }

    .small {
        font-size: 12px !important;
    }

    .h5 {
        font-size: 1.1rem;
    }

    .h6 {
        font-size: 1rem;
    }
</style>


@code {
    [Parameter] public int ClientId { get; set; }
    private IndividualClientDto individualDto = new();

    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private IIndividualClientService IndividualClientService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await Task.CompletedTask;
    }

    private bool ValidatePassport()
    {
        if (!individualDto.PassportDateOfIssue.HasValue)
            return false;

        if (individualDto.IsPassportExpired)
            return false;

        return true;
    }

    private async Task SaveIndividual()
    {
        try
        {
            await IndividualClientService.CreateAsync(individualDto, ClientId);
            Navigation.NavigateTo("/orders/create");
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

}

