
@page "/clients/create-company/{ClientId:int}"
@using LogisticCompany.Application.DTOs.Clients
@using LogisticCompany.Application.Interfaces
@using Presentation.Shared
@inherits ClientBaseComponent
@inject IClientService ClientService
@rendermode InteractiveServer

<div class="page-bg min-vh-100 py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <!-- Header Card -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-4">
                        <div class="d-flex align-items-center">
                            <div class="icon-circle bg-warning me-3">
                                <i class="fas fa-building text-white"></i>
                            </div>
                            <div>
                                <h1 class="h4 fw-bold text-dark mb-1">Создание компании</h1>
                                <p class="text-muted mb-0">Заполните реквизиты юридического лица</p>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Loading)
                {
                    <!-- Loading State -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center py-5">
                            <div class="spinner-border text-warning mb-3" role="status">
                                <span class="visually-hidden">Загрузка...</span>
                            </div>
                            <h5 class="text-muted">Подготовка формы...</h5>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger">@ErrorMessage</div>
                }
                else
                {
                    <EditForm Model="companyDto" OnValidSubmit="() => HandleAsync(SaveCompany)">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger" />

                        <!-- Company Information Card -->
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-white">
                                <div class="d-flex align-items-center">
                                    <div class="icon-circle-sm bg-warning me-3">
                                        <i class="fas fa-file-contract text-white"></i>
                                    </div>
                                    <h5 class="fw-bold text-dark mb-0">Реквизиты компании</h5>
                                </div>
                            </div>
                            <div class="card-body">
                                <!-- Company Name Field -->
                                <div class="mb-4">
                                    <label class="form-label fw-semibold text-dark">
                                        <i class="fas fa-signature text-muted me-2"></i>Название компании *
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0">
                                            <i class="fas fa-building text-muted"></i>
                                        </span>
                                        <InputText @bind-Value="companyDto.CompanyName"
                                                   class="form-control border-start-0"
                                                   placeholder="ООО 'Ваша Компания'" />
                                    </div>
                                    <ValidationMessage For="() => companyDto.CompanyName" class="text-danger small mt-1" />
                                    <small class="text-muted">Полное юридическое название организации</small>
                                </div>

                                <!-- INN Field -->
                                <div class="mb-3">
                                    <label class="form-label fw-semibold text-dark">
                                        <i class="fas fa-hashtag text-muted me-2"></i>ИИН/БИН *
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0">
                                            <i class="fas fa-id-card text-muted"></i>
                                        </span>
                                        <InputText @bind-Value="companyDto.Inn"
                                                   maxlength="12"
                                                   class="form-control border-start-0"
                                                   placeholder="123456789012" />
                                    </div>
                                    <ValidationMessage For="() => companyDto.Inn" class="text-danger small mt-1" />
                                    <small class="text-muted">12-значный идентификационный номер налогоплательщика</small>
                                </div>
                            </div>
                        </div>

                        <!-- Additional Information -->
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-header bg-white">
                                <div class="d-flex align-items-center">
                                    <div class="icon-circle-sm bg-info me-3">
                                        <i class="fas fa-info-circle text-white"></i>
                                    </div>
                                    <h5 class="fw-bold text-dark mb-0">Дополнительная информация</h5>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-info border-0 mb-0">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-lightbulb text-info me-3 fa-lg"></i>
                                        <div>
                                            <h6 class="alert-heading mb-2">Что дальше?</h6>
                                            <p class="mb-0 small">
                                                После сохранения компании вы сможете создавать заказы от имени
                                                этой организации. Все финансовые документы будут оформляться
                                                на указанные реквизиты.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <button type="submit" class="btn btn-warning w-100 py-3" disabled="@Loading">
                                            <i class="fas fa-save me-2"></i>
                                            @(Loading ? "Сохранение..." : "Сохранить компанию")
                                        </button>
                                    </div>
                                    <div class="col-md-6">
                                        <button type="button" class="btn btn-outline-secondary w-100 py-3"
                                                @onclick="GoBack" disabled="@Loading">
                                            <i class="fas fa-arrow-left me-2"></i>Назад к списку
                                        </button>
                                    </div>
                                </div>
                                <div class="text-center mt-3">
                                    <small class="text-muted">
                                        <i class="fas fa-exclamation-circle me-1"></i>
                                        Поля отмеченные * обязательны для заполнения
                                    </small>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                }

                <!-- Quick Help -->
                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-body">
                        <div class="d-flex align-items-start">
                            <div class="flex-shrink-0">
                                <i class="fas fa-question-circle text-primary me-3 fa-lg"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-bold text-dark mb-2">Где найти реквизиты?</h6>
                                <ul class="text-muted small mb-0">
                                    <li>Название компании - из учредительных документов</li>
                                    <li>ИИН/БИН - из свидетельства о госрегистрации</li>
                                    <li>Убедитесь в правильности написания для корректного документооборота</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int ClientId { get; set; }
    private CompanyClientDto companyDto = new();

    protected override async Task OnInitializedAsync()
    {
        // Можно добавить проверку что клиент существует и его тип = 2
        await Task.CompletedTask;
    }

    private async Task SaveCompany()
    {
        var result = await ClientService.CreateCompanyClientAsync(ClientId, companyDto);

        if (result.IsSuccess)
        {
            NavigateTo("/orders/create");
        }
        else
        {
            ErrorMessage = result.Error;
        }
    }
}


<style>
    .page-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .icon-circle-sm {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
    }

    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border-bottom: 1px solid #e9ecef;
    }

    .form-control, .input-group-text {
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border-color: #e9ecef;
    }

    .form-control:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
    }

    .btn {
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-warning {
        background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%);
        border: none;
        color: #212529;
    }

        .btn-warning:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 193, 7, 0.3);
            color: #212529;
        }

    .btn-outline-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(108, 117, 125, 0.2);
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        margin-bottom: 0.5rem;
    }

    .alert-danger {
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #f8d7da 0%, #f1aeb5 100%);
    }

    .alert-info {
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
    }

    .input-group .form-control:not(:first-child) {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }

    .input-group .input-group-text:not(:last-child) {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

</style>