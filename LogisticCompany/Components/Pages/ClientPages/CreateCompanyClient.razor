@page "/clients/create-company/{ClientId:int}"
@using LogisticCompany.Application.Interfaces
@using LogisticCompany.DTO
@using LogisticCompany.Db
@using Presentation.Shared
@inherits ClientBaseComponent
@rendermode InteractiveServer

<div class="office-manager-page bg-light min-vh-100">
    <!-- Хлебные крошки -->
    <div class="container-fluid py-2 border-bottom bg-white">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="#" class="text-decoration-none " @onclick="GoBack">
                            <i class="fas fa-chevron-left me-1"></i>Компании
                        </a>
                    </li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container py-3">
        <div class="row">
            <!-- Основной контент -->
            <div class="col-lg-8">
                <!-- Заголовок -->
                <div class="d-flex align-items-center mb-3">
                    <div class="status-badge bg-warning text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                         style="width: 36px; height: 36px; font-size: 14px;">
                        <i class="fas fa-building"></i>
                    </div>
                    <div>
                        <h1 class="h5 fw-bold mb-1">Добавление  юридического лица</h1>
                        <p class="text-muted small mb-0">Заполните основные реквизиты юридического лица</p>
                    </div>
                </div>

                @if (Loading)
                {
                    <!-- Loading State -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center py-4">
                            <div class="spinner-border text-warning mb-2" role="status" style="width: 2rem; height: 2rem;">
                                <span class="visually-hidden">Загрузка...</span>
                            </div>
                            <h5 class="text-muted" style="font-size: 14px;">Подготовка формы...</h5>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center mb-3 py-2" role="alert">
                        <i class="fas fa-exclamation-triangle me-2" style="font-size: 14px;"></i>
                        <div class="small">@ErrorMessage</div>
                    </div>
                }
                else
                {
                    <EditForm Model="companyDto" OnValidSubmit="() => HandleAsync(SaveCompany)">
                        <DataAnnotationsValidator />

                        <!-- Основная форма -->
                        <div class="card border-0 shadow-sm mb-3">
                            <div class="card-header bg-white border-bottom py-2">
                                <h6 class="fw-semibold mb-0 d-flex align-items-center">
                                    <i class="fas fa-file-contract text-warning me-2" style="font-size: 14px;"></i>
                                    Реквизиты компании
                                </h6>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label class="form-label fw-semibold mb-1 d-flex align-items-center ">
                                                <i class="fas fa-signature text-muted me-1" style="font-size: 13px;"></i>
                                                Название компании *
                                                <span class="ms-1 badge bg-light text-muted" style="font-size: 11px;">Обязательно</span>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0 py-1 px-2">
                                                    <i class="fas fa-building text-muted" style="font-size: 14px;"></i>
                                                </span>
                                                <InputText @bind-Value="companyDto.CompanyName"
                                                           class="form-control border-start-0 py-1"
                                                           placeholder="ООО 'Ваша Компания'"
                                                           style="font-size: 14px;" />
                                            </div>
                                            <div class="mt-1">
                                                <ValidationMessage For="() => companyDto.CompanyName" class="text-danger" style="font-size: 12px;" />
                                                <div class="form-text" style="font-size: 12px;">
                                                    <i class="fas fa-info-circle me-1"></i>
                                                    Полное юридическое название из учредительных документов
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ИИН/БИН -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label class="form-label fw-semibold mb-1 d-flex align-items-center ">
                                                <i class="fas fa-hashtag text-muted me-1" style="font-size: 13px;"></i>
                                                ИИН/БИН *
                                                <span class="ms-1 badge bg-light text-muted" style="font-size: 11px;">Обязательно</span>
                                            </label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0 py-1 px-2">
                                                    <i class="fas fa-id-card text-muted" style="font-size: 14px;"></i>
                                                </span>
                                                <InputText @bind-Value="companyDto.Inn"
                                                           maxlength="12"
                                                           class="form-control border-start-0 py-1"
                                                           placeholder="123456789012"
                                                           style="font-size: 14px;" />
                                            </div>
                                            <div class="mt-1">
                                                <ValidationMessage For="() => companyDto.Inn" class="text-danger" style="font-size: 12px;" />
                                                <div class="form-text" style="font-size: 12px;">
                                                    <i class="fas fa-key me-1"></i>
                                                    12-значный идентификационный номер налогоплательщика
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Панель действий -->
                        <div class="action-panel bg-white border rounded p-3 shadow-sm">
                            <div class="row g-2 align-items-center">
                                <div class="col-md-8">
                                    <div class="d-flex align-items-center">
                                        </div>
                                        <div class="text-muted" style="font-size: 12px;">
                                            <i class="fas fa-file-contract me-1"></i>
                                            Все документы будут оформляться на эти реквизиты
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                        <button type="button"
                                                class="btn btn-outline-secondary px-3"
                                                @onclick="GoBack"
                                                disabled="@Loading"
                                                style="font-size: 14px; padding: 6px 12px;">
                                            <i class="fas fa-times me-1"></i>
                                            Отмена
                                        </button>
                                        <button type="submit"
                                                class="btn btn-warning px-3"
                                                disabled="@Loading"
                                                style="font-size: 14px; padding: 6px 12px;">
                                            @if (Loading)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                                <span>Сохранение...</span>
                                            }
                                            else
                                            {
                                                <i class="fas fa-save me-1"></i>
                                                <span>Сохранить</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </div>
                    </EditForm>
                }

               
            </div>

            <!-- Боковая панель -->
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 15px;">
                    <!-- Что дальше -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="fw-semibold mb-0" style="font-size: 14px;">
                                <i class="fas fa-forward me-2 text-success" style="font-size: 20px;"></i>
                                Что дальше?
                            </h6>
                        </div>
                        <div class="card-body py-2">
                            <div class="mb-2 d-flex">
                                <div class="me-3 text-success">
                                    <i class="fas fa-check-circle" style="font-size: 12px;"></i>
                                </div>
                                <div>
                                    <span class="small d-block" style="font-size: 13px;">Создание заказов</span>
                                    <span class="text-muted" style="font-size: 12px;">Все заказы будут оформляться от имени этой компании</span>
                                </div>
                            </div>
                            <div class="mb-2 d-flex">
                                <div class="me-3 text-success">
                                    <i class="fas fa-check-circle" style="font-size: 12px;"></i>
                                </div>
                                <div>
                                    <span class="small d-block" style="font-size: 13px;">Финансовые документы</span>
                                    <span class="text-muted" style="font-size: 12px;">Счета и акты будут формироваться на указанные реквизиты</span>
                                </div>
                            </div>
                            <div class="d-flex">
                                <div class="me-3 text-success">
                                    <i class="fas fa-check-circle" style="font-size: 12px;"></i>
                                </div>
                                <div>
                                    <span class="small d-block" style="font-size: 13px;">Отчетность</span>
                                    <span class="text-muted" style="font-size: 12px;">Автоматическое формирование отчетов по компании</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    

                    
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .office-manager-page {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        font-size: 14px;
    }

    .form-control {
        font-size: 14px;
        padding: 6px 12px;
        height: 36px;
    }

    .input-group-text {
        font-size: 14px;
        padding: 6px 12px;
        height: 36px;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #333;
    }

    .btn {
        font-size: 14px;
        padding: 6px 12px;
        height: 36px;
    }

    .btn-sm {
        font-size: 13px;
        padding: 5px 10px;
        height: 32px;
    }

    .action-panel {
        position: sticky;
        bottom: 15px;
        z-index: 1000;
        margin-top: 15px;
        font-size: 14px;
    }

    .status-badge {
        width: 36px;
        height: 36px;
        font-size: 14px;
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
        font-size: 13px;
    }

    .card-header {
        padding: 8px 16px;
    }

    .card-body {
        padding: 16px;
    }

    .alert {
        padding: 8px 12px;
        font-size: 13px;
    }

    .badge {
        font-size: 11px;
        padding: 4px 8px;
    }

    input.form-control:focus,
    select.form-control:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.15);
        outline: none;
    }

    .small {
        font-size: 12px !important;
    }

    .h5 {
        font-size: 1.1rem;
    }

    .h6 {
        font-size: 1rem;
    }

    .text-warning {
        color: #fd7e14 !important;
    }

    .btn-warning {
        background-color: #fd7e14;
        border-color: #fd7e14;
        color: white;
    }

        .btn-warning:hover {
            background-color: #e76a00;
            border-color: #e76a00;
            color: white;
        }
</style>


@code {
    [Parameter] public int ClientId { get; set; }
    private CompanyClientDto companyDto = new();

    [Inject] private AppDbContext Db { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;
    [Inject] private ICompanyClientService CompanyClientService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await Task.CompletedTask;
    }
    private async Task SaveCompany()
    {
        try
        {
            await CompanyClientService.CreateAsync(companyDto, ClientId);
            Navigation.NavigateTo("/orders/create");
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

}

