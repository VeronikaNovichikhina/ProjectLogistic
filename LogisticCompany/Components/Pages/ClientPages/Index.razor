 @page "/clientList"
@using LogisticCompany.Application.Interfaces
@using LogisticCompany.Db
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IClientService ClientService


<div class="cl-page">
    <div class="lc-stripe"><div class="lc-stripe-inner"></div></div>

    <div class="cl-wrap">

        <!-- Заголовок -->
        <div class="pg-hd">
            <div class="pg-hd-left">
                <div class="pg-hd-ico" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <div>
                    <div class="pg-hd-title">Управление клиентами</div>
                    <div class="pg-hd-sub">Администрирование клиентской базы компании</div>
                </div>
            </div>
            <div class="pg-hd-btns">
                <NavLink href="/admin-home" class="cl-btn cl-btn-outline">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="19" y1="12" x2="5" y2="12"/>
                        <polyline points="12 19 5 12 12 5"/>
                    </svg>
                    Назад
                </NavLink>
                <NavLink href="/clients/create" class="cl-btn cl-btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="16"/>
                        <line x1="8" y1="12" x2="16" y2="12"/>
                    </svg>
                    Добавить клиента
                </NavLink>
            </div>
        </div>

        <!-- Статистика -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-ico ico-total" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <div>
                    <div class="stat-val">@clients?.Count.ToString()</div>
                    <div class="stat-lbl">Всего клиентов</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-ico ico-indiv" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <div>
                    <div class="stat-val">@(clients?.Count(c => c.ClientTypeId == 1).ToString() ?? "0")</div>
                    <div class="stat-lbl">Физические лица</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-ico ico-comp" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                    </svg>
                </div>
                <div>
                    <div class="stat-val">@(clients?.Count(c => c.ClientTypeId == 2).ToString() ?? "0")</div>
                    <div class="stat-lbl">Компании</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-ico ico-act" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                        <polyline points="16 11 18 13 22 9"/>
                    </svg>
                </div>
                <div>
                    <div class="stat-val">@(clients?.Count(c => !string.IsNullOrEmpty(c.Phone)).ToString() ?? "0")</div>
                    <div class="stat-lbl">С контактами</div>
                </div>
            </div>
        </div>

        <!-- Таблица / состояния -->
        @if (clients == null)
        {
            <div class="tbl-card">
                <div class="state-box">
                    <div class="state-ico" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </div>
                    <span class="lc-spinner" role="status"></span>
                    <div class="state-title">Загрузка данных клиентов...</div>
                </div>
            </div>
        }
        else if (!clients.Any())
        {
            <div class="tbl-card">
                <div class="state-box">
                    <div class="state-ico" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                    </div>
                    <div class="state-title">Клиенты не найдены</div>
                    <div class="state-sub">Добавьте первого клиента для начала работы</div>
                    <NavLink href="/clients/create" class="cl-btn cl-btn-primary" style="width: auto; margin-top: .5rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="8" x2="12" y2="16"/>
                            <line x1="8" y1="12" x2="16" y2="12"/>
                        </svg>
                        Добавить клиента
                    </NavLink>
                </div>
            </div>
        }
        else
        {
            <div class="tbl-card">
                <div class="tbl-hd">
                    <div class="tbl-hd-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                             style="color: #1C3A5E;" aria-hidden="true">
                            <line x1="8" y1="6" x2="21" y2="6"/>
                            <line x1="8" y1="12" x2="21" y2="12"/>
                            <line x1="8" y1="18" x2="21" y2="18"/>
                            <line x1="3" y1="6" x2="3.01" y2="6"/>
                            <line x1="3" y1="12" x2="3.01" y2="12"/>
                            <line x1="3" y1="18" x2="3.01" y2="18"/>
                        </svg>
                        Список клиентов
                    </div>
                    <span class="tbl-count">@filteredClients.Count() записей</span>
                </div>
                <table class="cl-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;">№</th>
                            <th>Клиент</th>
                            <th>Контактная информация</th>
                            <th>Тип</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (c, index) in filteredClients.Select((value, i) => (value, i)))
                        {
                            <tr @onclick="() => ShowClientDetails(c.ClientsId)">
                                <td class="row-num">@(index + 1)</td>
                                <td>
                                    <div class="cl-info-row">
                                        <div class="cl-av @(c.ClientTypeId == 1 ? "av-indiv" : "av-comp")" aria-hidden="true">
                                            @if (c.ClientTypeId == 1)
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                                    <circle cx="12" cy="7" r="4"/>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                                                </svg>
                                            }
                                        </div>
                                        <div>
                                            @if (c.ClientTypeId == 1 && c.IndividualClients.Any())
                                            {
                                                var i = c.IndividualClients.First();
                                                <div class="cl-name">@i.LastName @i.FirstName @i.PatronymicName</div>
                                                <div class="cl-sub">Паспорт: @i.PassportNumber</div>
                                            }
                                            else if (c.ClientTypeId == 2 && c.CompanyClients.Any())
                                            {
                                                var co = c.CompanyClients.First();
                                                <div class="cl-name">@co.CompanyName</div>
                                                <div class="cl-sub">ИИН: @co.Inn</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="contact-col">
                                        @if (!string.IsNullOrEmpty(c.Phone))
                                        {
                                            <div class="contact-item">
                                                <span class="ci-phone">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"
                                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <path d="M22 16.92V19a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3 5.18 2 2 0 0 1 5 3h2.09a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 10.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z"/>
                                                    </svg>
                                                </span>
                                                @c.Phone
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(c.Email))
                                        {
                                            <div class="contact-item">
                                                <span class="ci-email">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"
                                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                                        <polyline points="22,6 12,13 2,6"/>
                                                    </svg>
                                                </span>
                                                @c.Email
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="type-badge @(c.ClientTypeId == 1 ? "badge-indiv" : "badge-comp")">
                                        @if (c.ClientTypeId == 1)
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"
                                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                                <circle cx="12" cy="7" r="4"/>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"
                                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                                            </svg>
                                        }
                                        @c.ClientType.TypeName
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>

@code {
    private List<Client>? clients;
    private List<Client> filteredClients = new List<Client>();
    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
    }

    private async Task LoadClients()
    {
        clients = await ClientService.GetAllClientAsync();
        filteredClients = new List<Client>(clients);
    }

    private void EditClient(int clientId)
    {
        Navigation.NavigateTo($"/clients/edit/{clientId}");
    }

    private void ShowClientDetails(int clientId)
    {
        Navigation.NavigateTo($"/clients/details/{clientId}");
    }

} 


<style>
/* ── Полоска ─────────────────────────────────────────────── */
.lc-stripe       { height: 4px; background: #1C3A5E; }
.lc-stripe-inner { height: 100%; width: 35%; background: #F5A623; border-radius: 0 3px 3px 0; }

/* ── Страница ────────────────────────────────────────────── */
.cl-page {
    min-height: 100vh;
    background: #F5F3EF;
    font-family: 'Segoe UI', system-ui, sans-serif;
    color: #1C2B3A;
}

.cl-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.25rem 1rem 3rem;
}

/* ── Заголовок ───────────────────────────────────────────── */
.pg-hd {
    background: #fff;
    border: 1px solid #E2DBCF;
    border-radius: 14px;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.pg-hd-left  { display: flex; align-items: center; gap: 10px; }

.pg-hd-ico {
    width: 40px;
    height: 40px;
    background: #1C3A5E;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #F5A623;
    flex-shrink: 0;
}

.pg-hd-title { font-size: 16px; font-weight: 500; color: #1C2B3A; }
.pg-hd-sub   { font-size: 12px; color: #8A8070; margin-top: 1px; }
.pg-hd-btns  { display: flex; gap: 8px; flex-shrink: 0; }

/* ── Кнопки ──────────────────────────────────────────────── */
.cl-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
    border: none;
    white-space: nowrap;
    width: 100%;
    justify-content: center;
}

.cl-btn-outline {
    border: 1px solid #D5CCBC;
    background: #fff;
    color: #1C2B3A;
}
.cl-btn-outline:hover { background: #F5F3EF; border-color: #B0A898; }

.cl-btn-primary {
    background: #1C3A5E;
    color: #fff;
}
.cl-btn-primary:hover { background: #154E8C; color: #fff; }

/* ── Статистика ──────────────────────────────────────────── */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: .75rem;
    margin-bottom: 1rem;
}

@@media (max-width: 768px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
}

.stat-card {
    background: #fff;
    border: 1px solid #E2DBCF;
    border-radius: 12px;
    padding: .85rem 1rem;
    display: flex;
    align-items: center;
    gap: 10px;
}

.stat-ico {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.ico-total { background: #E8F0F9; color: #1C3A5E; }
.ico-indiv { background: #FEF0D8; color: #D98E10; }
.ico-comp  { background: #EEEBE5; color: #5A5248; }
.ico-act   { background: #EAF7F2; color: #0F6E56; }

.stat-val { font-size: 20px; font-weight: 500; color: #1C2B3A; line-height: 1; }
.stat-lbl { font-size: 11px; color: #8A8070; margin-top: 2px; }

/* ── Карточка таблицы ────────────────────────────────────── */
.tbl-card {
    background: #fff;
    border: 1px solid #E2DBCF;
    border-radius: 14px;
    overflow: hidden;
}

.tbl-hd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .75rem 1rem;
    border-bottom: 1px solid #EDE8E0;
    background: #FDFCF9;
}

.tbl-hd-title {
    font-size: 13px;
    font-weight: 500;
    color: #1C2B3A;
    display: flex;
    align-items: center;
    gap: 6px;
}

.tbl-count {
    font-size: 11px;
    font-weight: 500;
    padding: 2px 9px;
    border-radius: 100px;
    background: #E8F0F9;
    color: #1C3A5E;
}

/* ── Таблица ─────────────────────────────────────────────── */
.cl-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
}

.cl-table th {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: #8A8070;
    font-weight: 500;
    padding: .55rem .85rem;
    border-bottom: 1px solid #EDE8E0;
    text-align: left;
    background: #FDFCF9;
}

.cl-table td {
    padding: .65rem .85rem;
    border-bottom: 1px solid #F0EDE8;
    vertical-align: middle;
}

.cl-table tr:last-child td { border-bottom: none; }

.cl-table tbody tr {
    cursor: pointer;
    transition: background 0.12s;
}

.cl-table tbody tr:hover td { background: #FDFCF9; }

.row-num { color: #8A8070; font-size: 12px; }

/* ── Строка клиента ──────────────────────────────────────── */
.cl-info-row {
    display: flex;
    align-items: center;
    gap: 9px;
}

.cl-av {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.av-indiv { background: #E8F0F9; color: #1C3A5E; }
.av-comp  { background: #EEEBE5; color: #5A5248; }

.cl-name { font-size: 13px; font-weight: 500; color: #1C2B3A; }
.cl-sub  { font-size: 11px; color: #8A8070; margin-top: 1px; }

/* ── Контакты ────────────────────────────────────────────── */
.contact-col  { display: flex; flex-direction: column; gap: 3px; }

.contact-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #1C2B3A;
}

.ci-phone { color: #0F6E56; display: flex; }
.ci-email { color: #1C3A5E; display: flex; }

/* ── Тип-бейдж ───────────────────────────────────────────── */
.type-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 9px;
    border-radius: 100px;
    white-space: nowrap;
}

.badge-indiv { background: #E8F0F9; color: #1C3A5E; }
.badge-comp  { background: #EEEBE5; color: #5A5248; }

/* ── Состояния (загрузка / пусто) ────────────────────────── */
.state-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1rem;
    text-align: center;
    gap: .5rem;
}

.state-ico {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: #F5F3EF;
    border: 1px solid #E2DBCF;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #C8BFB0;
    margin-bottom: .35rem;
}

.state-title { font-size: 15px; font-weight: 500; color: #8A8070; }
.state-sub   { font-size: 12px; color: #B0A898; }

/* ── Спиннер ─────────────────────────────────────────────── */
.lc-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 2px solid rgba(28, 58, 94, 0.15);
    border-top-color: #1C3A5E;
    border-radius: 50%;
    animation: cl-spin .7s linear infinite;
}

@@keyframes cl-spin { to { transform: rotate(360deg); } }
</style>
