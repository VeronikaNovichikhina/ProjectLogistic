 @page "/clientList"
@using LogisticCompany.Application.Interfaces
@using LogisticCompany.Db
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<LogisticCompany.Db.AppDbContext> db
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IClientService ClientService

<div class="page-container">
    <div class="container-fluid">
        <!-- Header -->
        <div class="page-header glass-card">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center">
                        <div class="header-icon me-3">
                            <i class="fas fa-users"></i>
                        </div>
                        <div>
                            <h1 class="page-title">Управление клиентами</h1>
                            <p class="page-subtitle">Администрирование клиентской базы компании</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <NavLink href="/admin-home" class="btn btn-secondary btn-lg me-2">
                        <i class="fas fa-arrow-left me-2"></i>Назад
                    </NavLink>
                    <NavLink href="/clients/create" class="btn btn-primary btn-lg shadow-sm">
                        <i class="fas fa-plus-circle me-2"></i>Добавить клиента
                    </NavLink>
                </div>
            </div>
        </div>

        <!-- Quick Stats -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stat-card stat-total">
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-value">@clients?.Count.ToString()</h3>
                        <p class="stat-label">Всего клиентов</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-individual">
                    <div class="stat-icon">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-value">@(clients?.Count(c => c.ClientTypeId == 1).ToString() ?? "0")</h3>
                        <p class="stat-label">Физические лица</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-company">
                    <div class="stat-icon">
                        <i class="fas fa-building"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-value">@(clients?.Count(c => c.ClientTypeId == 2).ToString() ?? "0")</h3>
                        <p class="stat-label">Компании</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card stat-active">
                    <div class="stat-icon">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-value">@(clients?.Count(c => !string.IsNullOrEmpty(c.Phone)).ToString() ?? "0")</h3>
                        <p class="stat-label">С контактами</p>
                    </div>
                </div>
            </div>
        </div>

        

        @if (clients == null)
        {
            <!-- Loading State -->
            <div class="main-card glass-card">
                <div class="card-body text-center py-5">
                    <div class="loading-spinner">
                        <i class="fas fa-users fa-3x text-primary mb-3"></i>
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">Загрузка...</span>
                        </div>
                        <h5 class="text-muted">Загрузка данных клиентов...</h5>
                    </div>
                </div>
            </div>
        }
        else if (!clients.Any())
        {
            <!-- Empty State -->
            <div class="main-card glass-card">
                <div class="card-body text-center py-5">
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <h4 class="empty-title">Клиенты не найдены</h4>
                        <p class="empty-description">Добавьте первого клиента для начала работы</p>
                        <NavLink href="/clients/create" class="btn btn-primary btn-lg">
                            <i class="fas fa-plus-circle me-2"></i>Добавить клиента
                        </NavLink>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Clients Table -->
            <div class="main-card glass-card">
                <div class="card-body">
                    <div class="table-container">
                        <table class="clients-table">
                            <thead>
                                <tr>
                                    <th class="client-id">№</th>
                                    <th class="client-info">Клиент</th>
                                    <th class="client-contacts">Контактная информация</th>
                                    <th class="client-type">Тип</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (c, index) in filteredClients.Select((value, i) => (value, i)))
                                {
                                    <tr class="client-row" @onclick="() => ShowClientDetails(c.ClientsId)">
                                        <td class="client-id">
                                            @(index + 1)
                                        </td>
                                        <td class="client-info">
                                            <div class="d-flex align-items-center">
                                                <div class="client-avatar me-3">
                                                    @if (c.ClientTypeId == 1)
                                                    {
                                                        <div class="avatar-circle avatar-individual">
                                                            <i class="fas fa-user text-white"></i>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="avatar-circle avatar-company">
                                                            <i class="fas fa-building text-white"></i>
                                                        </div>
                                                    }
                                                </div>
                                                <div class="client-details">
                                                    @if (c.ClientTypeId == 1 && c.IndividualClients.Any())
                                                    {
                                                        var i = c.IndividualClients.First();
                                                        <div class="client-name">@i.LastName @i.FirstName @i.PatronymicName</div>
                                                        <div class="client-id">Паспорт: @i.PassportNumber</div>
                                                    }
                                                    else if (c.ClientTypeId == 2 && c.CompanyClients.Any())
                                                    {
                                                        var co = c.CompanyClients.First();
                                                        <div class="client-name">@co.CompanyName</div>
                                                        <div class="client-id">ИИН: @co.Inn</div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="client-contacts">
                                            <div class="contact-info">
                                                @if (!string.IsNullOrEmpty(c.Phone))
                                                {
                                                    <div class="contact-item">
                                                        <i class="fas fa-phone text-success me-2"></i>
                                                        <span>@c.Phone</span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(c.Email))
                                                {
                                                    <div class="contact-item">
                                                        <i class="fas fa-envelope text-primary me-2"></i>
                                                        <span>@c.Email</span>
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                        <td class="client-type">
                                            <span class="type-badge @(c.ClientTypeId == 1 ? "badge-individual" : "badge-company")">
                                                <i class="fas @(c.ClientTypeId == 1 ? "fa-user" : "fa-building") me-1"></i>
                                                @c.ClientType.TypeName
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


@code {
    private List<Client>? clients;
    private AppDbContext context = default!;
    private List<Client> filteredClients = new List<Client>();
    protected override async Task OnInitializedAsync()
    {
        await LoadClients();
    }

    private async Task LoadClients()
    {
        clients = await ClientService.GetAllClientAsync();
        filteredClients = new List<Client>(clients);
    }

    private void EditClient(int clientId)
    {
        Navigation.NavigateTo($"/clients/edit/{clientId}");
    }

    private void ShowClientDetails(int clientId)
    {
        Navigation.NavigateTo($"/clients/details/{clientId}");
    }

} 



