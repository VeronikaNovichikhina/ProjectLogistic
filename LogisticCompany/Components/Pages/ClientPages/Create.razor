@page "/clients/create"
@using LogisticCompany.Application.Interfaces
@using LogisticCompany.DTO
@using LogisticCompany.Db
@using Microsoft.EntityFrameworkCore
@using Presentation.Shared
@inherits ClientBaseComponent
@inject IJSRuntime JS
@rendermode InteractiveServer
@inject IClientService ClientService

<div class="office-manager-page bg-light min-vh-100">
    <!-- Хлебные крошки для навигации -->
    <div class="container-fluid py-2 border-bottom bg-white">
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="#" class="text-decoration-none " @onclick="GoBack">
                            <i class="fas fa-chevron-left me-1"></i>Клиенты
                        </a>
                    </li>
                    <li class="breadcrumb-item active " aria-current="page">Новый клиент</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="container py-3">
        <div class="row">
            <div class="col-lg-8">
                <div class="d-flex align-items-center mb-3">
                    <div class="status-badge bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                         style="width: 36px; height: 36px; font-size: 20px;">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div>
                        <h1 class="h5 fw-bold mb-1">Добавление нового клиента</h1>
                        <p class="text-muted small mb-0">Шаг 1 из 3 • Основные контактные данные</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center mb-3 py-2" role="alert">
                        <i class="fas fa-exclamation-triangle me-2" style="font-size: 20px;"></i>
                        <div class="small">@ErrorMessage</div>
                    </div>
                }

                <EditForm Model="createDto" OnValidSubmit="() => HandleAsync(CreateClient)" FormName="createClient">
                    <DataAnnotationsValidator />

                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="fw-semibold mb-0 d-flex align-items-center">
                                <i class="fas fa-user-circle text-primary me-2" style="font-size: 20px;"></i>
                                Контактная информация
                            </h6>
                        </div>

                        <div class="card-body p-3">
                            <div class="row g-3">
                                <!-- Телефон -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label fw-semibold mb-1 d-flex align-items-center ">
                                            <i class="fas fa-mobile-alt text-muted me-1" style="font-size: 16px;"></i>
                                            Телефон *
                                            <span class="ms-1 badge bg-light text-muted" style="font-size: 12px;">Обязательно</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 py-1 px-2">
                                                <i class="fas fa-phone text-muted" style="font-size: 14px;"></i>
                                            </span>
                                            <input @bind="createDto.Phone" @ref="phoneInput"
                                                   class="form-control border-start-0 py-1"
                                                   placeholder="+7 (___) ___-__-__"
                                                   style="font-size: 16px;" />
                                        </div>
                                        <div class="mt-1">
                                            <ValidationMessage For="() => createDto.Phone" class="text-danger" style="font-size: 12px;" />
                                            <div class="form-text" style="font-size: 12px;">
                                                <i class="fas fa-info-circle me-1"></i>
                                                Формат: +7 (XXX) XXX-XX-XX
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Email -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label fw-semibold mb-1 d-flex align-items-center ">
                                            <i class="fas fa-envelope text-muted me-1" style="font-size: 16px;"></i>
                                            Email *
                                            <span class="ms-1 badge bg-light text-muted" style="font-size: 12px;">Обязательно</span>
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 py-1 px-2">
                                                <i class="fas fa-at text-muted" style="font-size: 14px;"></i>
                                            </span>
                                            <InputText @bind-Value="createDto.Email"
                                                       class="form-control border-start-0 py-1"
                                                       placeholder="ivanov@company.ru"
                                                       style="font-size: 16px;" />
                                        </div>
                                        <div class="mt-1">
                                            <ValidationMessage For="() => createDto.Email" class="text-danger" style="font-size: 12px;" />
                                            <div class="form-text" style="font-size: 12px;">
                                                <i class="fas fa-info-circle me-1"></i>
                                                Для уведомлений и рассылок
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Тип клиента -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label fw-semibold mb-1 d-flex align-items-center ">
                                            <i class="fas fa-tag text-muted me-1" style="font-size: 16px;"></i>
                                            Тип клиента *
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 py-1 px-2">
                                                <i class="fas fa-user-tag text-muted" style="font-size: 14px;"></i>
                                            </span>
                                            <InputSelect @bind-Value="createDto.ClientTypeId"
                                                         class="form-control border-start-0 py-1"
                                                         style="font-size: 14px;">
                                                <option value="">Выберите из списка...</option>
                                                @foreach (var ct in clientTypes)
                                                {
                                                    <option value="@ct.ClientTypeId">@ct.TypeName</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        
                                    </div>
                                </div>
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="button"
                                            class="btn btn-outline-secondary px-3"
                                            @onclick="GoBack"
                                            disabled="@Loading"
                                            style="font-size: 14px; padding: 6px 12px;">
                                        <i class="fas fa-times me-1"></i>
                                        Отмена
                                    </button>
                                    <button type="submit"
                                            class="btn btn-primary px-3"
                                            disabled="@Loading"
                                            style="font-size: 14px; padding: 6px 12px;">
                                        @if (Loading)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            <span>Создание...</span>
                                        }
                                        else
                                        {
                                            <i class="fas fa-save me-1"></i>
                                            <span>Сохранить</span>
                                        }
                                    </button>
                                </div>
                               
                            </div>
                        </div>
                    </div>
                    
                </EditForm>
            </div>

            <div class="col-lg-4">
                <div class="sticky-top" style="top: 15px;">

                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-white border-bottom py-2">
                            <h6 class="fw-semibold mb-0" style="font-size: 14px;">
                                <i class="fas fa-tips me-2 text-primary" style="font-size: 20px;"></i>
                                Советы по заполнению
                            </h6>
                        </div>
                        <div class="card-body py-2">
                            <ul class="list-unstyled mb-0">
                                <li class="mb-2 d-flex">
                                    <i class="fas fa-check-circle text-success me-2 mt-1" style="font-size: 20px;"></i>
                                    <span class="small" style="font-size: 12px;">Проверяйте корректность телефона</span>
                                </li>
                                <li class="mb-2 d-flex">
                                    <i class="fas fa-check-circle text-success me-2 mt-1" style="font-size: 20px;"></i>
                                    <span class="small" style="font-size: 12px;">Указывайте рабочие email для документов</span>
                                </li>
                                <li class="mb-2 d-flex">
                                    <i class="fas fa-check-circle text-success me-2 mt-1" style="font-size: 20px;"></i>
                                    <span class="small" style="font-size: 12px;">Правильный тип клиента = система скидок</span>
                                </li>
                                <li class="d-flex">
                                    <i class="fas fa-check-circle text-success me-2 mt-1" style="font-size: 20px;"></i>
                                    <span class="small" style="font-size: 12px;">Остальное можно добавить позже</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                    
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .office-manager-page {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        font-size: 14px;
    }

    .form-control {
        font-size: 14px;
        padding: 6px 12px;
        height: 36px;
    }

    .input-group-text {
        font-size: 14px;
        padding: 6px 12px;
        height: 36px;
    }

    .form-label {
        font-size: 20px;
        font-weight: 600;
        color: #333;
    }

    .btn {
        font-size: 14px;
        padding: 6px 12px;
        height: 36px;
    }

    .btn-lg {
        font-size: 14px;
        padding: 8px 16px;
        height: 40px;
    }

    .action-panel {
        position: sticky;
        bottom: 15px;
        z-index: 1000;
        margin-top: 15px;
        font-size: 14px;
    }

    .status-badge {
        width: 36px;
        height: 36px;
        font-size: 14px;
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
        font-size: 13px;
    }

    .card-header {
        padding: 8px 16px;
    }

    .card-body {
        padding: 16px;
    }

    .alert {
        padding: 8px 12px;
        font-size: 13px;
    }

    .badge {
        font-size: 11px;
        padding: 4px 8px;
    }

    input.form-control:focus,
    select.form-control:focus {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
        outline: none;
    }

    .small {
        font-size: 12px !important;
    }

    .h5 {
        font-size: 1.1rem;
    }

    .h6 {
        font-size: 1rem;
    }
</style>

@code {
    private CreateClientDto createDto = new();
    private List<ClientType> clientTypes = new();
    private ElementReference phoneInput;

    [Inject] private AppDbContext Db { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("applyPhoneMask", phoneInput);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadClientTypes();
    }

    private async Task LoadClientTypes()
    {
        try
        {
            clientTypes = await ClientService.GetClientTypesAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task CreateClient()
    {
        try
        {
            var result = await ClientService.CreateAsync(createDto);

            if (result.ClientTypeId == 1)
            {
                Navigation.NavigateTo($"/clients/create-individual/{result.ClientId}");
            }
            else if (result.ClientTypeId == 2)
            {
                Navigation.NavigateTo($"/clients/create-company/{result.ClientId}");
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

}




