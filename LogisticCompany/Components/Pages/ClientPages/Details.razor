@page "/clients/details/{clientId:int}"
@using LogisticCompany.Application.Interfaces
@using LogisticCompany.Application.DTO
@using Presentation.Shared
@inherits ClientBaseComponent
@rendermode InteractiveServer


<div class="cd-page">
    <div class="lc-stripe"><div class="lc-stripe-inner"></div></div>

    <div class="cd-wrap">

        @if (Loading)
        {
            <div class="cd-card">
                <div class="state-box">
                    <span class="lc-spinner" role="status"></span>
                    <div class="state-title">Загрузка данных клиента...</div>
                </div>
            </div>
        }
        else if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="cd-alert cd-alert-danger">@ErrorMessage</div>
        }
        else if (Client == null)
        {
            <div class="cd-alert cd-alert-amber">Клиент не найден</div>
        }
        else
        {
            <!-- Заголовок -->
            <div class="hd-card">
                <div class="hd-left">
                    <div class="hd-av @(Client.ClientTypeId == 1 ? "hd-av-indiv" : "hd-av-comp")" aria-hidden="true">
                        @if (Client.ClientTypeId == 1)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="7" width="20" height="14" rx="2"/>
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                            </svg>
                        }
                    </div>
                    <div>
                        <div class="hd-name">
                            @if (Client.ClientTypeId == 1 && Client.IndividualClient != null)
                            {
                                @($"{Client.IndividualClient.LastName} {Client.IndividualClient.FirstName} {Client.IndividualClient.PatronymicName}")
                            }
                            else if (Client.ClientTypeId == 2 && Client.CompanyClient != null)
                            {
                                @Client.CompanyClient.CompanyName
                            }
                        </div>
                        <div class="hd-badges">
                            <span class="cd-badge @(Client.ClientTypeId == 1 ? "badge-blue" : "badge-amber")">
                                @Client.ClientTypeName
                            </span>
                            @if (Client.UserId != null)
                            {
                                <span class="cd-badge badge-green">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="20 6 9 17 4 12"/>
                                    </svg>
                                    Доступ к системе
                                </span>
                            }
                            else
                            {
                                <span class="cd-badge badge-gray">Без доступа</span>
                            }
                        </div>
                    </div>
                </div>
                <button class="cd-back-btn" @onclick="GoBack">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="19" y1="12" x2="5" y2="12"/>
                        <polyline points="12 19 5 12 12 5"/>
                    </svg>
                    Назад
                </button>
            </div>

            <!-- Информационные карточки -->
            <div class="info-grid">

                <!-- Основная информация -->
                <div class="ic">
                    <div class="ic-hd">
                        <div class="ic-hd-ico ico-blue" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                        </div>
                        <span class="ic-hd-title">Основная информация</span>
                    </div>
                    <div class="ic-body">
                        <div class="ii">
                            <span class="ii-lbl">Тип клиента</span>
                            <span class="ii-val">
                                @if (Client.ClientTypeId == 1)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                         style="color: #1C3A5E;" aria-hidden="true">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                    <span>Физическое лицо</span>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                         style="color: #5A5248;" aria-hidden="true">
                                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                                    </svg>
                                    <span>Юридическое лицо</span>
                                }
                            </span>
                        </div>

                        @if (Client.ClientTypeId == 1 && Client.IndividualClient != null)
                        {
                            <div class="ii">
                                <span class="ii-lbl">Фамилия</span>
                                <span class="ii-val">@Client.IndividualClient.LastName</span>
                            </div>
                            <div class="ii">
                                <span class="ii-lbl">Имя</span>
                                <span class="ii-val">@Client.IndividualClient.FirstName</span>
                            </div>
                            <div class="ii">
                                <span class="ii-lbl">Отчество</span>
                                <span class="ii-val">@(string.IsNullOrEmpty(Client.IndividualClient.PatronymicName) ? "—" : Client.IndividualClient.PatronymicName)</span>
                            </div>
                            <div class="ii">
                                <span class="ii-lbl">Паспорт</span>
                                <span class="ii-val">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                         style="color: #8A8070;" aria-hidden="true">
                                        <rect x="2" y="5" width="20" height="14" rx="2"/>
                                        <line x1="2" y1="10" x2="22" y2="10"/>
                                    </svg>
                                    @Client.IndividualClient.PassportNumber
                                </span>
                            </div>
                        }
                        else if (Client.ClientTypeId == 2 && Client.CompanyClient != null)
                        {
                            <div class="ii">
                                <span class="ii-lbl">Название компании</span>
                                <span class="ii-val">@Client.CompanyClient.CompanyName</span>
                            </div>
                            <div class="ii">
                                <span class="ii-lbl">ИИН / БИН</span>
                                <span class="ii-val">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                         style="color: #8A8070;" aria-hidden="true">
                                        <line x1="4" y1="9" x2="20" y2="9"/>
                                        <line x1="4" y1="15" x2="20" y2="15"/>
                                        <line x1="10" y1="3" x2="8" y2="21"/>
                                        <line x1="16" y1="3" x2="14" y2="21"/>
                                    </svg>
                                    @Client.CompanyClient.Inn
                                </span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Контактная информация -->
                <div class="ic">
                    <div class="ic-hd">
                        <div class="ic-hd-ico ico-green" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                <polyline points="22,6 12,13 2,6"/>
                            </svg>
                        </div>
                        <span class="ic-hd-title">Контактная информация</span>
                    </div>
                    <div class="ic-body">
                        <div class="ii">
                            <span class="ii-lbl">Телефон</span>
                            <span class="ii-val">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                     style="color: #0F6E56;" aria-hidden="true">
                                    <path d="M22 16.92V19a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3 5.18 2 2 0 0 1 5 3h2.09a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 10.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z"/>
                                </svg>
                                @Client.Phone
                            </span>
                        </div>
                        <div class="ii">
                            <span class="ii-lbl">Email</span>
                            <span class="ii-val">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                     style="color: #1C3A5E;" aria-hidden="true">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                    <polyline points="22,6 12,13 2,6"/>
                                </svg>
                                @Client.Email
                            </span>
                        </div>
                        <div class="ii">
                            <span class="ii-lbl">Статус в системе</span>
                            @if (Client.UserId != null)
                            {
                                <span class="ii-val" style="color: #0F6E56;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                        <polyline points="22 4 12 14.01 9 11.01"/>
                                    </svg>
                                    Учётная запись активна
                                </span>
                            }
                            else
                            {
                                <span class="ii-val" style="color: #8A8070;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polyline points="12 6 12 12 16 14"/>
                                    </svg>
                                    Учётная запись не создана
                                </span>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- Кнопки действий -->
            <div class="action-card">
                <button class="act-btn act-edit" @onclick="() => EditClient(Client.ClientsId)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                    Редактировать
                </button>
                <button class="act-btn act-del" @onclick="() => DeleteClient(Client.ClientsId)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                        <path d="M10 11v6"/><path d="M14 11v6"/>
                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                    </svg>
                    Удалить
                </button>
            </div>
        }

    </div>
</div>



@code {
    [Parameter] public int clientId { get; set; }
    private ClientDto? Client { get; set; }

    [Inject] private IClientService ClientService { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadClient();
    }

    private async Task LoadClient()
    {
        try
        {
            Client = await ClientService.GetByIdAsync(clientId);
            if (Client == null)
                ErrorMessage = "Клиент не найден";
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private void EditClient(int clientId)
    {
        Navigation.NavigateTo($"/clients/edit/{clientId}");
    }

    private void  DeleteClient(int clientId)
    {
        Navigation.NavigateTo($"/clients/delete/{clientId}");
    }


}


<style>
    /* ============================================================
   ClientDetail.razor.css — тёмно-синий + бежевый + оранжевый
   Совпадает с палитрой всех страниц проекта
   ============================================================ */

/* ── Полоска ─────────────────────────────────────────────── */
.lc-stripe       { height: 4px; background: #1C3A5E; }
.lc-stripe-inner { height: 100%; width: 35%; background: #F5A623; border-radius: 0 3px 3px 0; }

/* ── Страница ────────────────────────────────────────────── */
.cd-page {
    min-height: 100vh;
    background: #F5F3EF;
    font-family: 'Segoe UI', system-ui, sans-serif;
    color: #1C2B3A;
}

.cd-wrap {
    max-width: 780px;
    margin: 0 auto;
    padding: 1.25rem 1rem 3rem;
}

/* ── Алерты ──────────────────────────────────────────────── */
.cd-alert {
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    margin-bottom: .85rem;
}
.cd-alert-danger { background: #FEF2F2; border: 1px solid #FECACA; color: #B91C1C; }
.cd-alert-amber  { background: #FEF3E2; border: 1px solid #F5E4B8; color: #92600A; }

/* ── Состояние загрузки ──────────────────────────────────── */
.cd-card {
    background: #fff;
    border: 1px solid #E2DBCF;
    border-radius: 14px;
    overflow: hidden;
}

.state-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1rem;
    gap: .5rem;
    text-align: center;
}

.state-title { font-size: 14px; color: #8A8070; }

/* ── Заголовок ───────────────────────────────────────────── */
.hd-card {
    background: #fff;
    border: 1px solid #E2DBCF;
    border-radius: 14px;
    padding: 1rem 1.25rem;
    margin-bottom: .75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.hd-left { display: flex; align-items: center; gap: 12px; }

.hd-av {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
}
.hd-av-indiv { background: #1C3A5E; }
.hd-av-comp  { background: #5A5248; }

.hd-name   { font-size: 17px; font-weight: 500; color: #1C2B3A; margin-bottom: 5px; }
.hd-badges { display: flex; gap: 6px; flex-wrap: wrap; }

.cd-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 9px;
    border-radius: 100px;
}
.badge-blue   { background: #E8F0F9; color: #1C3A5E; }
.badge-amber  { background: #FEF0D8; color: #D98E10; }
.badge-green  { background: #EAF7F2; color: #0F6E56; }
.badge-gray   { background: #EEEBE5; color: #5A5248; }

.cd-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 8px;
    border: 1px solid #D5CCBC;
    background: #fff;
    color: #1C2B3A;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
    flex-shrink: 0;
}
.cd-back-btn:hover { background: #F5F3EF; border-color: #B0A898; }

/* ── Сетка карточек ──────────────────────────────────────── */
.info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .75rem;
    margin-bottom: .75rem;
}

@@media (max-width: 600px) {
    .info-grid { grid-template-columns: 1fr; }
}

/* ── Карточка ────────────────────────────────────────────── */
.ic {
    background: #fff;
    border: 1px solid #E2DBCF;
    border-radius: 12px;
    overflow: hidden;
}

.ic-hd {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: .65rem .85rem;
    border-bottom: 1px solid #EDE8E0;
}

.ic-hd-ico {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.ico-blue  { background: #E8F0F9; color: #1C3A5E; }
.ico-green { background: #EAF7F2; color: #0F6E56; }

.ic-hd-title { font-size: 12px; font-weight: 500; color: #1C2B3A; }

.ic-body {
    padding: .75rem .85rem;
    display: flex;
    flex-direction: column;
    gap: .55rem;
}

/* ── Поле информации ─────────────────────────────────────── */
.ii            { display: flex; flex-direction: column; gap: 2px; }
.ii-lbl        { font-size: 10px; text-transform: uppercase; letter-spacing: .06em; color: #8A8070; }
.ii-val        { font-size: 13px; font-weight: 500; color: #1C2B3A; display: flex; align-items: center; gap: 5px; }
.ii-val-muted  { font-size: 13px; color: #8A8070; }

/* ── Кнопки действий ─────────────────────────────────────── */
.action-card {
    background: #fff;
    border: 1px solid #E2DBCF;
    border-radius: 12px;
    padding: .85rem 1.1rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: .6rem;
}

.act-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    border: none;
}

.act-edit {
    background: #FEF0D8;
    color: #D98E10;
    border: 1px solid #F5E4B8;
}
.act-edit:hover { background: #F5E4B8; }

.act-del {
    background: #FEF2F2;
    color: #B91C1C;
    border: 1px solid #FECACA;
}
.act-del:hover { background: #FECACA; }

/* ── Спиннер ─────────────────────────────────────────────── */
.lc-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 2px solid rgba(28, 58, 94, 0.15);
    border-top-color: #1C3A5E;
    border-radius: 50%;
    animation: cd-spin .7s linear infinite;
}
@@keyframes cd-spin { to { transform: rotate(360deg); } }
</style>