@rendermode InteractiveServer
@inject IJSRuntime JS
@page "/clients/delete/{clientId:int}"
@using LogisticCompany.DTO
@using LogisticCompany.Db
@using Microsoft.EntityFrameworkCore
@using Presentation.Shared
@inherits ClientBaseComponent

<div class="page-bg min-vh-100 py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-6 col-xl-5">
                @if (Loading)
                {
                    <!-- Loading State -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-body text-center py-5">
                            <div class="spinner-border text-danger mb-3" role="status">
                                <span class="visually-hidden">Загрузка...</span>
                            </div>
                            <h5 class="text-muted">Загрузка данных клиента...</h5>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <div class="alert alert-danger">@ErrorMessage</div>
                }
                else if (Client == null)
                {
                    <div class="alert alert-warning">Клиент не найден</div>
                }
                else
                {
                    <!-- Header Card -->
                    <div class="card border-0 shadow-sm mb-4" style="border-left: 5px solid #dc3545 !important;">
                        <div class="card-header bg-white py-4">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle bg-danger me-3">
                                    <i class="fas fa-exclamation-triangle text-white"></i>
                                </div>
                                <div>
                                    <h1 class="h4 fw-bold text-dark mb-1">Удаление клиента</h1>
                                    <p class="text-muted mb-0">Подтвердите удаление клиента из системы</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Warning Alert -->
                    <div class="card border-0 shadow-sm mb-4" style="border-left: 5px solid #dc3545 !important;">
                        <div class="card-body">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <i class="fas fa-exclamation-circle text-danger fa-2x me-3"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="fw-bold text-danger mb-2">Внимание! Необратимое действие</h5>
                                    <p class="mb-2">Вы собираетесь удалить клиента из системы. Это действие нельзя отменить.</p>
                                    <div class="alert alert-warning border-0 mb-0">
                                        <small class="fw-bold">
                                            <i class="fas fa-database me-1"></i>
                                            Будут удалены все связанные данные клиента
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Client Information -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle-sm bg-info me-3">
                                    <i class="fas fa-user text-white"></i>
                                </div>
                                <h5 class="fw-bold text-dark mb-0">Информация о клиенте</h5>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="client-info">
                                <div class="info-item mb-3">
                                    <div class="info-label">Тип клиента</div>
                                    <div class="info-value">
                                        @if (Client.ClientTypeId == 1)
                                        {
                                            <span class="badge bg-primary">
                                                <i class="fas fa-user me-1"></i>Физическое лицо
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">
                                                <i class="fas fa-building me-1"></i>Юридическое лицо
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div class="info-item mb-3">
                                    <div class="info-label">Контактные данные</div>
                                    <div class="info-value">
                                        <div class="d-flex align-items-center mb-1">
                                            <i class="fas fa-phone text-muted me-2"></i>
                                            <span>@Client.Phone</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(Client.Email))
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-envelope text-muted me-2"></i>
                                                <span>@Client.Email</span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (Client.ClientTypeId == 1 && Client.IndividualClient != null)
                                {
                                    <div class="info-item mb-3">
                                        <div class="info-label">ФИО</div>
                                        <div class="info-value">
                                            <strong>@Client.IndividualClient.LastName @Client.IndividualClient.FirstName @Client.IndividualClient.PatronymicName</strong>
                                        </div>
                                    </div>
                                    <div class="info-item mb-3">
                                        <div class="info-label">Паспорт</div>
                                        <div class="info-value">
                                            <i class="fas fa-id-card text-muted me-2"></i>
                                            @Client.IndividualClient.PassportNumber
                                        </div>
                                    </div>
                                }
                                else if (Client.ClientTypeId == 2 && Client.CompanyClient != null)
                                {
                                    <div class="info-item mb-3">
                                        <div class="info-label">Название компании</div>
                                        <div class="info-value">
                                            <strong>@Client.CompanyClient.CompanyName</strong>
                                        </div>
                                    </div>
                                    <div class="info-item mb-3">
                                        <div class="info-label">ИИН/БИН</div>
                                        <div class="info-value">
                                            <i class="fas fa-hashtag text-muted me-2"></i>
                                            @Client.CompanyClient.Inn
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Confirmation Check -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="confirmDelete"
                                       @bind="isConfirmed" />
                                <label class="form-check-label fw-semibold text-danger" for="confirmDelete">
                                    <i class="fas fa-check-circle me-2"></i>
                                    Я понимаю, что это действие необратимо и подтверждаю удаление
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <button type="button" class="btn btn-danger w-100 py-3"
                                            @onclick="() => HandleAsync(DeleteClient)"
                                            disabled="@(!isConfirmed || Loading)">
                                        <i class="fas fa-trash-alt me-2"></i>
                                        @(Loading ? "Удаление..." : "Удалить клиента")
                                    </button>
                                </div>
                                <div class="col-md-6">
                                    <button type="button" class="btn btn-outline-secondary w-100 py-3"
                                            @onclick="GoBack" disabled="@Loading">
                                        <i class="fas fa-arrow-left me-2"></i>Отмена
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int ClientId { get; set; }
    private ClientDto? Client { get; set; }
    private bool isConfirmed = false;

    [Inject] private AppDbContext Db { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadClient();
    }

    private async Task LoadClient()
    {
        try
        {
            var clientEntity = await Db.Clients
                .FirstOrDefaultAsync(c => c.ClientsId == ClientId);

            if (clientEntity != null)
            {
                Client = new ClientDto
                {
                    ClientsId = clientEntity.ClientsId,
                    Phone = clientEntity.Phone,
                    Email = clientEntity.Email,
                    ClientTypeId = clientEntity.ClientTypeId
                };
            }
            else
            {
                ErrorMessage = "Клиент не найден";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private async Task DeleteClient()
    {
        try
        {
            var clientEntity = await Db.Clients
                .FirstOrDefaultAsync(c => c.ClientsId == ClientId);

            if (clientEntity != null)
            {
                Db.Clients.Remove(clientEntity);
                await Db.SaveChangesAsync();

                Navigation.NavigateTo("/clients");
            }
            else
            {
                ErrorMessage = "Клиент не найден";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

}

<style>
    .page-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .icon-circle-sm {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
    }

    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border-bottom: 1px solid #e9ecef;
    }

    .client-info {
        padding: 0.5rem 0;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 0.75rem 0;
        border-bottom: 1px solid #f1f3f4;
    }

        .info-item:last-child {
            border-bottom: none;
        }

    .info-label {
        font-weight: 600;
        color: #495057;
        flex: 1;
    }

    .info-value {
        flex: 2;
        text-align: right;
    }

    .btn {
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-danger {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        border: none;
        position: relative;
        overflow: hidden;
    }

        .btn-danger:disabled {
            background: #6c757d;
            transform: none;
            box-shadow: none;
        }

        .btn-danger:not(:disabled):hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
        }

    .btn-outline-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(108, 117, 125, 0.2);
    }

    .form-check-input:checked {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .form-check-label {
        cursor: pointer;
        user-select: none;
    }

    .alert-danger {
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #f8d7da 0%, #f1aeb5 100%);
    }

    .alert-warning {
        border-radius: 8px;
        border: none;
        background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
    }

            </style>