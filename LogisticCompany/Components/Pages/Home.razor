@page "/"
@using LogisticCompany.Application.DTO
@using LogisticCompany.Application.Interfaces
@using LogisticCompany.Application.Services
@using LogisticCompany.DTO
@using LogisticCompany.Db
@using LogisticCompany.Domain.Entities.Location
@using LogisticCompany.Domain.Entities.Orders
@using LogisticCompany.Domain.Entities.Tracking
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

@inject ITrackingService TrackingService
@inject IClientService ClientService
@inject ILocationService LocationService
@inject IDeliveryDictionaryService DeliveryDictionaryService
@inject IPriceCalculatorService PriceCalculator
@inject IOrderService OrderService
@inject IEmployeeService EmployeeService

<div class="main-container">
    <!-- Хедер -->
    <header class="d-flex justify-content-between align-items-center mb-5 p-4 rounded-4 shadow-lg header-main">
        <div class="d-flex align-items-center">
            <i class="fas fa-shipping-fast fa-2x text-white me-3"></i>
            <div>
                <h2 class="fw-bold text-white mb-0">Logistic Company</h2>
                <small class="text-white-50">Быстро. Надежно. Безопасно</small>
            </div>
        </div>
        <div>
            @if (isLoggedIn)
            {
                <NavLink class="btn btn-light btn-gradient fw-semibold" href="/profile">
                    <i class="fas fa-user-circle me-2"></i>Мой аккаунт
                </NavLink>
            }
            else
            {
                <NavLink class="btn btn-outline-light me-2 fw-semibold" href="/login">
                    <i class="fas fa-sign-in-alt me-2"></i>Вход
                </NavLink>
                <NavLink class="btn btn-light btn-gradient fw-semibold" href="/register">
                    <i class="fas fa-user-plus me-2"></i>Регистрация
                </NavLink>
            }
        </div>
    </header>

    <!-- Основной контент -->
    <div class="row g-4">
        <!-- Поиск трекера -->
        <div class="col-lg-8">
            <div class="card tracker-card shadow-lg rounded-4 border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <div class="tracker-icon me-3">
                            <i class="fas fa-search-location"></i>
                        </div>
                        <div>
                            <h4 class="card-title fw-bold text-dark mb-1">Отследить посылку</h4>
                            <p class="text-muted mb-0">Введите номер заказа для получения актуальной информации</p>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <EditForm Model="@trackingModel" OnValidSubmit="SearchTracking">
                        <DataAnnotationsValidator />

                        <div class="input-group input-group-lg mb-3">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="fas fa-barcode text-muted"></i>
                            </span>
                            <InputText @bind-Value="trackingModel.OrderNumber"
                                       class="form-control border-start-0 py-3"
                                       placeholder="Например: 12345" />
                            <button type="submit" class="btn btn-success px-4 fw-bold" disabled="@isSearching">
                                @if (isSearching)
                                {
                                    <span>
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        Поиск...
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        <i class="fas fa-search me-2"></i>Найти
                                    </span>
                                }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => trackingModel.OrderNumber)" class="text-danger small" />
                    </EditForm>

                    <!-- Сообщения об ошибках/результатах -->
                    @if (!string.IsNullOrEmpty(searchMessage))
                    {
                        <div class="alert @(isSearchSuccess ? "alert-success" : "alert-danger") mt-3">
                            <div class="d-flex align-items-center">
                                <i class="fas @(isSearchSuccess ? "fa-check-circle" : "fa-exclamation-triangle") me-2"></i>
                                <span>@searchMessage</span>
                            </div>
                        </div>
                    }

                    <!-- Результаты поиска -->
                    @if (searchResult != null)
                    {
                        <div class="search-results mt-4">
                            <div class="card border-0 bg-light">
                                <div class="card-body">
                                    <h6 class="fw-bold text-dark mb-3">Результаты отслеживания:</h6>

                                    <!-- Информация о заказе -->
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <small class="text-muted">Номер заказа:</small>
                                            <p class="fw-semibold mb-1">#@searchResult.Order.OrderNumber</p>
                                        </div>
                                        <div class="col-md-6">
                                            <small class="text-muted">Текущий статус:</small>
                                            <p class="mb-0">
                                                @if (searchResult?.TrackingHistory != null && searchResult.TrackingHistory.Any())
                                                {

                                                    var latestTracking = searchResult.TrackingHistory
                                                    .OrderByDescending(t => t.UpdateDate)
                                                    .FirstOrDefault();


                                                    @if (latestTracking?.Status != null)
                                                    {
                                                        <span class="">
                                                            @latestTracking.Status.StatusName
                                                        </span>

                                                        <small class="text-muted d-block mt-1">
                                                            <i class="fas fa-clock me-1"></i>
                                                            @latestTracking.UpdateDate.ToString("dd.MM.yyyy HH:mm")
                                                        </small>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Статус не указан</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Нет данных отслеживания</span>
                                                }
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Получатель -->
                                    <div class="row mb-3">
                                        <div class="col-12">
                                            <small class="text-muted">Получатель:</small>
                                            <p class="fw-semibold mb-1">
                                                @searchResult.Order.LastRecepientName @searchResult.Order.FirstRecepientName @searchResult.Order.MiddleRecepientName
                                            </p>
                                            <small class="text-muted">Телефон: @searchResult.Order.PhoneRecepient</small>
                                        </div>
                                    </div>

                                    <!-- История трекинга -->
                                    <div class="tracking-history">
                                        <h6 class="fw-bold text-dark mb-3">История перемещений:</h6>
                                        <div class="timeline">
                                            @foreach (var tracking in searchResult.TrackingHistory.OrderByDescending(t => t.UpdateDate))
                                            {
                                                <div class="timeline-item">
                                                    <div class="timeline-marker @tracking.StatusId"></div>
                                                    <div class="timeline-content">
                                                        <div class="d-flex justify-content-between align-items-start">
                                                            <div class="flex-grow-1">
                                                                <strong class="d-block">@tracking.LocationTrackings</strong>
                                                                <p class="mb-1 text-muted small">
                                                                    <span class="badge @tracking.StatusId me-2">
                                                                        @tracking.Status.StatusName
                                                                    </span>
                                                                </p>
                                                                @if (tracking.Branches != null)
                                                                {
                                                                    <small class="text-primary">
                                                                        <i class="fas fa-building me-1"></i>@tracking.Branches.NameBranches
                                                                    </small>
                                                                }
                                                            </div>
                                                            <small class="text-muted text-nowrap ms-2">
                                                                @tracking.UpdateDate.ToString("dd.MM.yyyy HH:mm")
                                                            </small>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Кнопка для просмотра деталей -->
                                    <div class="text-center mt-3">
                                        @if (isLoggedIn)
                                        {
                                            <NavLink href="/profile" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-eye me-2"></i>Подробнее о заказе
                                            </NavLink>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-primary btn-sm" @onclick="RedirectToLogin">
                                                <i class="fas fa-sign-in-alt me-2"></i>Войдите для просмотра деталей
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Лента новостей -->
        <div class="col-lg-4">
            <div class="card news-card shadow-lg rounded-4 border-0 h-100">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <div class="news-icon me-3">
                                <i class="fas fa-newspaper"></i>
                            </div>
                            <h4 class="card-title fw-bold text-dark mb-0">Новости компании</h4>
                        </div>
                        <span class="badge bg-success">Обновлено</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="news-list">
                        <div class="news-item p-3 rounded-3 mb-3">
                            <div class="d-flex align-items-start">
                                <div class="news-date bg-light rounded-2 text-center me-3 p-2">
                                    <div class="fw-bold text-primary">15</div>
                                    <small class="text-muted">Дек</small>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Запуск экспресс-доставки</h6>
                                    <p class="text-muted small mb-2">Теперь доставляем заказы в течение 24 часов</p>
                                    <span class="badge bg-primary bg-opacity-10 text-primary small">Новое</span>
                                </div>
                            </div>
                        </div>

                        <div class="news-item p-3 rounded-3 mb-3">
                            <div class="d-flex align-items-start">
                                <div class="news-date bg-light rounded-2 text-center me-3 p-2">
                                    <div class="fw-bold text-primary">10</div>
                                    <small class="text-muted">Дек</small>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Новый складской комплекс</h6>
                                    <p class="text-muted small mb-2">Открыли современный склад площадью 5000м²</p>
                                    <span class="badge bg-success bg-opacity-10 text-success small">Развитие</span>
                                </div>
                            </div>
                        </div>

                        <div class="news-item p-3 rounded-3">
                            <div class="d-flex align-items-start">
                                <div class="news-date bg-light rounded-2 text-center me-3 p-2">
                                    <div class="fw-bold text-primary">05</div>
                                    <small class="text-muted">Дек</small>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1">Экологичная упаковка</h6>
                                    <p class="text-muted small mb-2">Переходим на биоразлагаемые материалы</p>
                                    <span class="badge bg-warning bg-opacity-10 text-warning small">Экология</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Быстрые действия -->
    <div class="row g-3 mt-4">
        <div class="col-md-3">
            <div class="quick-action-card text-center p-4 rounded-3">
                <div class="action-icon mb-3">
                    <i class="fas fa-calculator fa-2x text-primary"></i>
                </div>
                <h6 class="fw-bold text-dark">Рассчитать стоимость</h6>
                <small class="text-muted">Узнайте цену доставки</small>
            </div>
        </div>
        @* <div class="col-md-3">
            <div class="quick-action-card text-center p-4 rounded-3">
                <div class="action-icon mb-3">
                    <i class="fas fa-map-marked-alt"></i>
                </div>
                <h6 class="fw-bold">Найти отделение</h6>
                <small class="text-muted">Ближайшие пункты выдачи</small>
            </div>
        </div> *@
        <div class="col-md-3">
            <div class="quick-action-card text-center p-4 rounded-3">
                <div class="action-icon mb-3">
                    <i class="fas fa-headset"></i>
                </div>
                <h6 class="fw-bold">Поддержка 24/7</h6>
                <small class="text-muted">Помощь и консультации</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="quick-action-card text-center p-4 rounded-3">
                <div class="action-icon mb-3">
                    <i class="fas fa-mobile-alt"></i>
                </div>
                <h6 class="fw-bold">Мобильное приложение</h6>
                <small class="text-muted">Управление на ходу</small>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    protected OrdersDTO order { get; set; } = new();
    private TrackingSearchModel trackingModel = new();
    private TrackingSearchResult? searchResult;
    private string searchMessage = "";
    private bool isSearchSuccess = false;
    private bool isSearching = false;
    private bool isLoggedIn = false;
    private string userName = "";
    private bool isCalculatorOpen = false;
    private OrderEditModel orderEditModel = new();
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();         
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            isLoggedIn = true;
            userName =
                user.FindFirst("name")?.Value ??
                user.Identity.Name ??
                "User";
        }
    }
    private async Task RedirectToLogin()
    {
        
        if (searchResult != null)
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "pendingOrderView", searchResult.Order.OrdersId.ToString());
        }

        NavigationManager.NavigateTo("/login", true);
    }
    private async Task SearchTracking()
    {
        isSearching = true;
        searchMessage = "";
        searchResult = null;

        try
        {
            var result = await TrackingService
                .SearchByOrderNumberAsync(trackingModel.OrderNumber);

            if (result == null)
            {
                searchMessage = "Заказ не найден";
                isSearchSuccess = false;
                return;
            }

            if (!result.TrackingHistory.Any())
            {
                searchMessage = "Заказ найден, но история трекинга отсутствует";
                isSearchSuccess = false;
                return;
            }

            searchResult = result;
            searchMessage = "Информация о посылке найдена";
            isSearchSuccess = true;
        }
        catch (Exception ex)
        {
            searchMessage = ex.Message;
            isSearchSuccess = false;
        }
        finally
        {
            isSearching = false;
        }
    }
    private void ClearSearch()
    {
        searchResult = null;
        searchMessage = "";
        trackingModel.OrderNumber = "";
    }


   

}



<style>
