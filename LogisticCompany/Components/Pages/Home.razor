@page "/"
@using LogisticCompany.Application.DTO
@using LogisticCompany.Application.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using LogisticCompany.Application.model
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

@inject ITrackingService TrackingService
@inject IClientService ClientService
@inject ILocationService LocationService
@inject IDeliveryDictionaryService DeliveryDictionaryService
@inject IPriceCalculatorService PriceCalculator
@inject IOrderService OrderService
@inject IEmployeeService EmployeeService

<div class="lc-wrap">

    <!-- Декоративная полоска -->
    <div class="lc-stripe">
        <div class="lc-stripe-inner"></div>
    </div>

    <!-- Хедер -->
    <header class="lc-header">
        <div class="lc-brand">
            <div class="lc-brand-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3" />
                    <rect x="9" y="11" width="14" height="10" rx="2" />
                    <circle cx="12" cy="21" r="1" />
                    <circle cx="20" cy="21" r="1" />
                </svg>
            </div>
            <div>
                <div class="lc-brand-name">Logistic Company</div>
                <div class="lc-brand-sub">Быстро. Надёжно. Безопасно</div>
            </div>
        </div>
        <div class="lc-nav-btns">
            @if (isLoggedIn)
            {
                <NavLink class="lc-btn lc-btn-orange" href="/profile">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    Мой аккаунт
                </NavLink>
            }
            else
            {
                <NavLink class="lc-btn lc-btn-ghost" href="/login">Вход</NavLink>
                <NavLink class="lc-btn lc-btn-orange" href="/register">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <line x1="19" y1="8" x2="19" y2="14" />
                        <line x1="22" y1="11" x2="16" y2="11" />
                    </svg>
                    Регистрация
                </NavLink>
            }
        </div>
    </header>

    <!-- Основная сетка: трекер + новости -->
    <div class="lc-grid">

        <!-- Трекер посылки -->
        <div class="lc-card">
            <div class="lc-card-hd">
                <div class="lc-card-icon lc-icon-blue" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        <path d="M11 8v3l2 2" />
                    </svg>
                </div>
                <div>
                    <div class="lc-card-title">Отследить посылку</div>
                    <div class="lc-card-sub">Введите номер заказа для получения информации</div>
                </div>
            </div>

            <EditForm Model="@trackingModel" OnValidSubmit="SearchTracking">
                <DataAnnotationsValidator />
                <div class="lc-inp-row">
                    <InputText @bind-Value="trackingModel.OrderNumber"
                               class="lc-input"
                               placeholder="Например: 12345" />
                    <button type="submit" class="lc-search-btn" disabled="@isSearching">
                        @if (isSearching)
                        {
                            <span class="lc-spinner" role="status"></span>
                            <span>Поиск...</span>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8" />
                                <line x1="21" y1="21" x2="16.65" y2="16.65" />
                            </svg>
                            <span>Найти</span>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => trackingModel.OrderNumber)" class="lc-validation-msg" />
            </EditForm>

            @if (!string.IsNullOrEmpty(searchMessage))
            {
                <div class="lc-alert @(isSearchSuccess ? "lc-alert-success" : "lc-alert-danger")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        @if (isSearchSuccess)
                        {
                            <polyline points="20 6 9 17 4 12" />
                        }
                        else
                        {
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        }
                    </svg>
                    <span>@searchMessage</span>
                </div>
            }

            @if (searchResult != null)
            {
                <div class="lc-result-box">
                    <div class="lc-result-top">
                        <div>
                            <div class="lc-lbl">Номер заказа</div>
                            <div class="lc-val">#@searchResult.Order.OrderNumber</div>
                        </div>
                        <div style="text-align: right;">
                            <div class="lc-lbl">Статус</div>
                            @if (searchResult?.TrackingHistory != null && searchResult.TrackingHistory.Any())
                            {
                                var latest = searchResult.TrackingHistory.OrderByDescending(t => t.UpdateDate).FirstOrDefault();
                                @if (latest?.Status != null)
                                {
                                    <div class="lc-pill">
                                        <span class="lc-dot"></span>
                                        <span>@latest.Status.StatusName</span>
                                    </div>
                                    <div class="lc-result-date">@latest.UpdateDate.ToString("dd.MM.yyyy HH:mm")</div>
                                }
                            }
                            else
                            {
                                <div class="lc-pill lc-pill-gray">Нет данных</div>
                            }
                        </div>
                    </div>

                    <div class="lc-rsec">
                        <div class="lc-lbl">Получатель</div>
                        <div class="lc-val">
                            @searchResult.Order.LastRecepientName @searchResult.Order.FirstRecepientName @searchResult.Order.MiddleRecepientName
                        </div>
                        <div class="lc-phone">@searchResult.Order.PhoneRecepient</div>
                    </div>

                    <div class="lc-lbl" style="margin-bottom: 0.5rem;">История перемещений</div>
                    <div class="lc-timeline">
                        @foreach (var tracking in searchResult.TrackingHistory.OrderByDescending(t => t.UpdateDate))
                        {
                            <div class="lc-tl-item">
                                <div class="lc-tl-dot lc-tl-done"></div>
                                <div>
                                    <div class="lc-tl-loc">@tracking.LocationTrackings</div>
                                    <div class="lc-tl-meta">
                                        @tracking.Status?.StatusName
                                        @if (tracking.Branches != null)
                                        {
                                            <span class="lc-tl-branch">· @tracking.Branches.NameBranches</span>
                                        }
                                        · @tracking.UpdateDate.ToString("dd.MM.yyyy HH:mm")
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="lc-result-actions">
                        @if (isLoggedIn)
                        {
                            <NavLink href="/profile" class="lc-btn lc-btn-outline-blue">Подробнее о заказе</NavLink>
                        }
                        else
                        {
                            <button class="lc-btn lc-btn-outline-blue" @onclick="RedirectToLogin">
                                Войдите для просмотра деталей
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Новости -->
        <div class="lc-card">
            <div class="lc-card-hd">
                <div class="lc-card-icon lc-icon-orange" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2z" />
                        <path d="M16 2v20M8 6h4M8 10h4M8 14h4" />
                    </svg>
                </div>
                <div>
                    <div class="lc-card-title">Новости компании</div>
                    <div class="lc-card-sub">Последние обновления</div>
                </div>
            </div>

            <div class="lc-news-list">
                <div class="lc-news-item">
                    <div class="lc-news-date">
                        <span class="lc-news-day">15</span>
                        <span class="lc-news-mo">Дек</span>
                    </div>
                    <div>
                        <div class="lc-news-title">Запуск экспресс-доставки</div>
                        <div class="lc-news-desc">Доставляем заказы в течение 24 часов</div>
                        <span class="lc-tag lc-tag-blue">Новое</span>
                    </div>
                </div>
                <div class="lc-news-item">
                    <div class="lc-news-date">
                        <span class="lc-news-day">10</span>
                        <span class="lc-news-mo">Дек</span>
                    </div>
                    <div>
                        <div class="lc-news-title">Новый складской комплекс</div>
                        <div class="lc-news-desc">Открыли склад площадью 5&nbsp;000 м²</div>
                        <span class="lc-tag lc-tag-gray">Развитие</span>
                    </div>
                </div>
                <div class="lc-news-item">
                    <div class="lc-news-date">
                        <span class="lc-news-day">05</span>
                        <span class="lc-news-mo">Дек</span>
                    </div>
                    <div>
                        <div class="lc-news-title">Экологичная упаковка</div>
                        <div class="lc-news-desc">Переходим на биоразлагаемые материалы</div>
                        <span class="lc-tag lc-tag-orange">Экология</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Быстрые действия -->
    <div class="lc-sec-lbl">Быстрые действия</div>
    <div class="lc-actions">

        <div class="lc-action">
            <div class="lc-action-icon lc-icon-blue" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="2" width="16" height="20" rx="2" />
                    <line x1="8" y1="6" x2="16" y2="6" />
                    <line x1="8" y1="10" x2="16" y2="10" />
                    <line x1="8" y1="14" x2="12" y2="14" />
                </svg>
            </div>
            <div class="lc-action-title">Рассчитать стоимость</div>
            <div class="lc-action-sub">Узнайте цену доставки</div>
        </div>

        <div class="lc-action">
            <div class="lc-action-icon lc-icon-orange" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92V19a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3 5.18 2 2 0 0 1 5 3h2.09a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 10.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z" />
                </svg>
            </div>
            <div class="lc-action-title">Поддержка 24/7</div>
            <div class="lc-action-sub">Помощь и консультации</div>
        </div>

        <div class="lc-action">
            <div class="lc-action-icon lc-icon-gray" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
                    <line x1="12" y1="18" x2="12.01" y2="18" />
                </svg>
            </div>
            <div class="lc-action-title">Мобильное приложение</div>
            <div class="lc-action-sub">Управление на ходу</div>
        </div>

    </div>
</div>



@code {
    [SupplyParameterFromForm]
    protected OrdersDTO order { get; set; } = new();
    private TrackingSearchModel trackingModel = new();
    private TrackingSearchResult? searchResult;
    private string searchMessage = "";
    private bool isSearchSuccess = false;
    private bool isSearching = false;
    private bool isLoggedIn = false;
    private string userName = "";
    private bool isCalculatorOpen = false;
    private OrderEditModel orderEditModel = new();
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();         
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            isLoggedIn = true;
            userName =
                user.FindFirst("name")?.Value ??
                user.Identity.Name ??
                "User";
        }
    }
    private async Task RedirectToLogin()
    {
        
        if (searchResult != null)
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "pendingOrderView", searchResult.Order.OrdersId.ToString());
        }

        NavigationManager.NavigateTo("/login", true);
    }
    private async Task SearchTracking()
    {
        isSearching = true;
        searchMessage = "";
        searchResult = null;

        try
        {
            var result = await TrackingService
                .SearchByOrderNumberAsync(trackingModel.OrderNumber);

            if (result == null)
            {
                searchMessage = "Заказ не найден";
                isSearchSuccess = false;
                return;
            }

            if (!result.TrackingHistory.Any())
            {
                searchMessage = "Заказ найден, но история трекинга отсутствует";
                isSearchSuccess = false;
                return;
            }

            searchResult = result;
            searchMessage = "Информация о посылке найдена";
            isSearchSuccess = true;
        }
        catch (Exception ex)
        {
            searchMessage = ex.Message;
            isSearchSuccess = false;
        }
        finally
        {
            isSearching = false;
        }
    }
    private void ClearSearch()
    {
        searchResult = null;
        searchMessage = "";
        trackingModel.OrderNumber = "";
    }


   

}


<style>
    /* ============================================================
       Home.razor.css — тёмно-синий + бежевый + оранжевый
       ============================================================ */

    /* ── Переменные ──────────────────────────────────────────── */
    :root {
        --blue-dark: #1C3A5E;
        --blue-mid: #154E8C;
        --blue-light: #E8F0F9;
        --orange: #F5A623;
        --orange-dark: #D98E10;
        --orange-light: #FEF0D8;
        --beige-bg: #F5F3EF;
        --beige-card: #FAF8F4;
        --beige-border: #E2DBCF;
        --beige-line: #EDE8E0;
        --gray-text: #8A8070;
        --gray-light: #EEEBE5;
        --gray-mid: #5A5248;
        --text-dark: #1C2B3A;
        --white: #ffffff;
    }

    /* ── Фон страницы ────────────────────────────────────────── */
    body {
        background: var(--beige-bg) !important;
        min-height: 100vh;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    /* ── Обёртка ─────────────────────────────────────────────── */
    .lc-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 0 2.5rem;
        color: var(--text-dark);
    }

    /* ── Декоративная полоска ────────────────────────────────── */
    .lc-stripe {
        height: 4px;
        background: var(--blue-dark);
        border-radius: 0 0 3px 3px;
    }

    .lc-stripe-inner {
        height: 100%;
        width: 35%;
        background: var(--orange);
        border-radius: 0 3px 3px 0;
    }

    /* ── Хедер ───────────────────────────────────────────────── */
    .lc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        background: var(--blue-dark);
        margin-bottom: 1.25rem;
    }

    .lc-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .lc-brand-icon {
        width: 38px;
        height: 38px;
        background: var(--orange);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        flex-shrink: 0;
    }

    .lc-brand-name {
        font-size: 16px;
        font-weight: 600;
        color: #fff;
    }

    .lc-brand-sub {
        font-size: 12px;
        color: #A8C4DE;
        margin-top: 1px;
    }

    .lc-nav-btns {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    /* ── Кнопки ──────────────────────────────────────────────── */
    .lc-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 500;
        padding: 7px 16px;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.15s;
        white-space: nowrap;
        text-decoration: none;
        border: none;
    }

    .lc-btn-ghost {
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: transparent;
        color: #D8E8F5;
    }

        .lc-btn-ghost:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.5);
        }

    .lc-btn-orange {
        background: var(--orange);
        border: none;
        color: #fff;
    }

        .lc-btn-orange:hover {
            background: var(--orange-dark);
        }

    .lc-btn-outline-blue {
        border: 1px solid var(--blue-dark);
        background: var(--white);
        color: var(--blue-dark);
    }

        .lc-btn-outline-blue:hover {
            background: var(--blue-light);
        }

    /* ── Основная сетка ──────────────────────────────────────── */
    .lc-grid {
        display: grid;
        grid-template-columns: 3fr 2fr;
        gap: 1rem;
        padding: 0 1rem;
        margin-bottom: 1rem;
    }

    @@media (max-width: 768px) {
        .lc-grid {
            grid-template-columns: 1fr;
        }

        .lc-actions {
            grid-template-columns: 1fr !important;
        }
    }

    /* ── Карточка ────────────────────────────────────────────── */
    .lc-card {
        background: var(--white);
        border: 1px solid var(--beige-border);
        border-radius: 14px;
        padding: 1.25rem;
    }

    .lc-card-hd {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 1rem;
        padding-bottom: .85rem;
        border-bottom: 1px solid var(--beige-line);
    }

    .lc-card-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        flex-shrink: 0;
    }

    .lc-icon-blue {
        background: var(--blue-light);
        color: var(--blue-dark);
    }

    .lc-icon-orange {
        background: var(--orange-light);
        color: var(--orange-dark);
    }

    .lc-icon-gray {
        background: var(--gray-light);
        color: var(--gray-mid);
    }

    .lc-card-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-dark);
    }

    .lc-card-sub {
        font-size: 12px;
        color: var(--gray-text);
        margin-top: 2px;
    }

    /* ── Форма поиска ────────────────────────────────────────── */
    .lc-inp-row {
        display: flex;
        gap: 8px;
        margin-bottom: .5rem;
    }

    .lc-input {
        flex: 1;
        font-size: 13px;
        padding: 9px 12px;
        border-radius: 8px;
        border: 1px solid #D5CCBC;
        background: var(--beige-card);
        color: var(--text-dark);
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
    }

        .lc-input::placeholder {
            color: #B0A898;
        }

        .lc-input:focus {
            border-color: var(--blue-dark);
            box-shadow: 0 0 0 3px rgba(28, 58, 94, 0.1);
            background: var(--white);
        }

    .lc-search-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        font-weight: 500;
        padding: 9px 18px;
        border-radius: 8px;
        border: none;
        background: var(--blue-dark);
        color: #fff;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.15s;
    }

        .lc-search-btn:hover:not(:disabled) {
            background: var(--blue-mid);
        }

        .lc-search-btn:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

    .lc-spinner {
        display: inline-block;
        width: 13px;
        height: 13px;
        border: 2px solid rgba(255, 255, 255, 0.35);
        border-top-color: #fff;
        border-radius: 50%;
        animation: lc-spin 0.7s linear infinite;
    }

    @@keyframes lc-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .lc-validation-msg {
        font-size: 12px;
        color: #b91c1c;
        margin-top: 4px;
        display: block;
    }

    /* ── Алерты ──────────────────────────────────────────────── */
    .lc-alert {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        padding: 9px 12px;
        border-radius: 8px;
        margin-top: .75rem;
    }

    .lc-alert-success {
        background: #EAF7F2;
        color: #0F6E56;
        border: 1px solid #B8E8D8;
    }

    .lc-alert-danger {
        background: #FEF2F2;
        color: #B91C1C;
        border: 1px solid #FECACA;
    }

    /* ── Результаты поиска ───────────────────────────────────── */
    .lc-result-box {
        background: var(--beige-card);
        border: 1px solid #D5CCBC;
        border-radius: 10px;
        padding: 1rem;
        margin-top: .85rem;
