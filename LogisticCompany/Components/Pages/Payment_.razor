@* Pages/Payment.razor *@
@page "/orders/payment/{OrdersId:int}"
@using LogisticCompany.DTO
@using LogisticCompany.Db
@using LogisticCompany.Domain.Entities.Orders
@using LogisticCompany.Domain.Entities.Tracking
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

<div class="page-bg min-vh-100 py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-lg">
                    <div class="card-header bg-success text-white py-4">
                        <div class="text-center">
                            <i class="fas fa-credit-card fa-3x mb-3"></i>
                            <h1 class="h2 fw-bold mb-2">Оплата заказа</h1>
                            <p class="mb-0 opacity-75">Заказ №@OrdersId</p>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <!-- Сообщение -->
                        @if (!string.IsNullOrEmpty(alertMessage))
                        {
                            <div class="alert @(isAlertSuccess ? "alert-success" : "alert-danger") mb-4">
                                <div class="d-flex align-items-center">
                                    <i class="fas @(isAlertSuccess ? "fa-check-circle" : "fa-exclamation-triangle") me-2"></i>
                                    <span>@alertMessage</span>
                                    <button class="btn-close ms-auto" @onclick="ClearAlert"></button>
                                </div>
                            </div>
                        }

                        @if (order == null)
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-success mb-3" role="status"></div>
                                <p>Загрузка данных заказа...</p>
                            </div>
                        }
                        else if (payment == null)
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                                <h5 class="text-warning">Платежная информация не найдена</h5>
                                <p class="text-muted">Для заказа не создана платежная запись</p>
                            </div>
                        }
                        else
                        {
                            <div class="row">
                                <!-- Информация о заказе -->
                                <div class="col-md-6 mb-4">
                                    <div class="card border-0 bg-light h-100">
                                        <div class="card-header bg-white border-0">
                                            <h5 class="fw-bold text-dark mb-0">
                                                <i class="fas fa-info-circle me-2"></i>Информация о заказе
                                            </h5>
                                        </div>
                                        <div class="card-body">
                                            <p class="mb-2"><small class="text-muted">Получатель:</small><br />@order.LastRecepientName @order.FirstRecepientName @order.MiddleRecepientName</p>
                                            <p class="mb-2"><small class="text-muted">Телефон:</small><br />@order.PhoneRecepient</p>
                                            <p class="mb-2"><small class="text-muted">Описание посылки:</small><br />@order.DescriptionParcel</p>
                                            <p class="mb-0">
                                                <small class="text-muted">Статус заказа:</small><br />
                                                <span class="badge @GetStatusBadgeClass(currentTracking?.StatusId)">
                                                    @(currentTracking?.Status?.StatusName ?? "Неизвестно")
                                                </span>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Оплата -->
                                <div class="col-md-6">
                                    <div class="payment-summary bg-light rounded p-4">
                                        <h5 class="fw-bold mb-3">Оплата</h5>

                                        <div class="text-center mb-4">
                                            <span class="display-5 fw-bold text-success">@(payment?.Amount ?? "0.00") ₸</span>
                                        </div>

                                        <!-- Выбор способа оплаты -->
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold text-dark">Способ оплаты</label>
                                            <InputSelect @bind-Value="payment.PaymentMethodId" class="form-select">
                                                <option value="0" disabled>Выберите способ оплаты</option>
                                                @if (paymentMethods != null)
                                                {
                                                    @foreach (var method in paymentMethods)
                                                    {
                                                        <option value="@method.PaymentMethodId">@method.MethodName</option>
                                                    }
                                                }
                                            </InputSelect>
                                        </div>

                                        <!-- Статус платежа -->
                                        <div class="mb-3">
                                            <small class="text-muted">Статус платежа:</small><br />
                                            <span class="badge @GetPaymentStatusBadgeClass()">@GetPaymentStatusText()</span>
                                        </div>

                                        @if (!IsPaymentCompleted())
                                        {
                                            <!-- Не оплачен -->
                                            <div class="alert alert-info mb-4">
                                                <i class="fas fa-info-circle me-2"></i>
                                                Выберите способ оплаты и подтвердите оплату.
                                            </div>

                                            <div class="d-grid gap-2">
                                                <button class="btn btn-success btn-lg"
                                                        @onclick="ProcessPayment">
                                                    @if (isProcessing)
                                                    {
                                                        <span><span class="spinner-border spinner-border-sm me-2"></span>Обработка...</span>
                                                    }
                                                    else
                                                    {
                                                        <span><i class="fas fa-check-circle me-2"></i>Подтвердить оплату</span>
                                                    }
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- Оплачен -->
                                            <div class="alert alert-success text-center">
                                                <i class="fas fa-check-circle me-2"></i>Заказ оплачен
                                                <div class="mt-2">
                                                    <small class="text-muted">
                                                        Дата оплаты: @payment.PaymentDate?.ToString("dd.MM.yyyy HH:mm")
                                                    </small>
                                                </div>
                                            </div>
                                            <div class="d-grid gap-2 mt-3">
                                                <button class="btn btn-primary" @onclick="NavigateToDetails">
                                                    <i class="fas fa-eye me-2"></i>Посмотреть детали заказа
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int OrdersId { get; set; }

    protected Order order;
    protected Payment payment;
    protected Tracking currentTracking;
    protected List<PaymentMethod> paymentMethods = new();
    protected string alertMessage = "";
    protected bool isAlertSuccess = false;
    protected bool isProcessing = false;

    [Inject] protected IDbContextFactory<AppDbContext> DbContextFactory { get; set; }
    [Inject] protected NavigationManager Navigation { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadOrderData();
    }

    protected async Task LoadOrderData()
    {
        try
        {
            using var db = await DbContextFactory.CreateDbContextAsync();

            order = await db.Orders
                .Include(o => o.Payments)
                    .ThenInclude(p => p.PaymentMethod)
                .Include(o => o.Trackings)
                    .ThenInclude(t => t.Status)
                .FirstOrDefaultAsync(o => o.OrdersId == OrdersId);

            paymentMethods = await db.PaymentMethods.ToListAsync();

            if (order != null)
            {
                payment = order.Payments.FirstOrDefault();
                currentTracking = order.Trackings?.OrderByDescending(t => t.UpdateDate).FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Ошибка загрузки данных: {ex.Message}";
            isAlertSuccess = false;
        }
    }

    protected bool IsPaymentCompleted()
    {
        return payment?.PaymentDate != null;
    }

    protected async Task ProcessPayment()
    {
        isProcessing = true;
        try
        {
            using var db = await DbContextFactory.CreateDbContextAsync();

            var existingPayment = await db.Payments.FirstOrDefaultAsync(p => p.PaymentsId == payment.PaymentsId);

            if (existingPayment != null)
            {
                existingPayment.PaymentMethodId = payment.PaymentMethodId;
                existingPayment.PaymentDate = DateTime.Now;

                await db.SaveChangesAsync();

                // Обновляем трекинг (оплачено)
                var newTracking = new Tracking
                {
                    OrdersId = OrdersId,
                    LocationTrackings = "Оплата подтверждена",
                    UpdateDate = DateTime.Now,
                    StatusId = 2, // Оплачено
                    BranchesId = order.PickupBranchesId
                };

                db.Trackings.Add(newTracking);
                await db.SaveChangesAsync();

                alertMessage = "Оплата успешно подтверждена!";
                isAlertSuccess = true;

                await LoadOrderData();
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Ошибка при подтверждении оплаты: {ex.Message}";
            isAlertSuccess = false;
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    protected void NavigateToDetails()
    {
        Navigation.NavigateTo($"/order/details/{OrdersId}");
    }

    protected void ClearAlert()
    {
        alertMessage = "";
    }

    protected string GetStatusBadgeClass(int? statusId)
    {
        return statusId switch
        {
            1 => "bg-warning text-dark",
            2 => "bg-success",
            3 => "bg-info",
            4 => "bg-primary",
            5 => "bg-success",
            _ => "bg-secondary"
        };
    }

    protected string GetPaymentStatusBadgeClass()
    {
        return IsPaymentCompleted() ? "bg-success" : "bg-warning text-dark";
    }

    protected string GetPaymentStatusText()
    {
        return IsPaymentCompleted() ? "Оплачено" : "Ожидает оплаты";
    }
}
