 @page "/ordersList"
@using LogisticCompany.Application.Interfaces
@using LogisticCompany.DTO
@using LogisticCompany.Db
@using LogisticCompany.Domain.Entities.Orders
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@inject AppDbContext context
@inject NavigationManager NavigationManager
@inject IOrderQueryService OrderQueryService
@rendermode InteractiveServer

<div class="page-container">
    <div class="container-fluid">
        <!-- Header -->
        <div class="page-header glass-card">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center">
                        <div class="header-icon me-3">
                            <i class="fas fa-clipboard-list"></i>
                        </div>
                        <div>
                            <h1 class="page-title">Управление заказами</h1>
                            <p class="page-subtitle">Администрирование всех заказов доставки</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <NavLink href="/admin-home" class="btn btn-secondary btn-lg me-2">
                        <i class="fas fa-arrow-left me-2"></i>Назад
                    </NavLink>
                    <NavLink href="/orders/create" class="btn btn-primary btn-lg shadow-sm">
                        <i class="fas fa-plus-circle me-2"></i>Создать заказ
                    </NavLink>
                </div>
            </div>
        </div>

       

        @if (orders == null)
        {
            <!-- Loading State -->
            <div class="main-card glass-card">
                <div class="card-body text-center py-5">
                    <div class="loading-spinner">
                        <i class="fas fa-boxes fa-3x text-primary mb-3"></i>
                        <div class="spinner-border text-primary mb-3" role="status">
                            <span class="visually-hidden">Загрузка...</span>
                        </div>
                        <h5 class="text-muted">Загрузка данных заказов...</h5>
                    </div>
                </div>
            </div>
        }
        else if (!orders.Any())
        {
            <!-- Empty State -->
            <div class="main-card glass-card">
                <div class="card-body text-center py-5">
                    <div class="empty-state">
                        <div class="empty-icon">
                            <i class="fas fa-box-open"></i>
                        </div>
                        <h4 class="empty-title">Заказы не найдены</h4>
                        <p class="empty-description">Создайте первый заказ для начала работы</p>
                        <NavLink href="/orders/create" class="btn btn-primary btn-lg">
                            <i class="fas fa-plus-circle me-2"></i>Создать заказ
                        </NavLink>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Orders Table -->
            <div class="main-card glass-card">
                <div class="card-body">
                    <div class="table-container">
                        <table class="orders-table">
                            <thead>
                                <tr>
                                    <th class="order-id">№</th>
                                    <th class="order-number">Заказ</th>
                                    <th class="order-client">Клиент</th>
                                    <th class="order-route">Маршрут</th>
                                    <th class="order-package">Посылка</th>
                                    <th class="order-status">Статус</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (order, index) in orders.Select((value, i) => (value, i)))
                                {
                                    <tr class="order-row" @onclick="() => NavigateToOrder(order.OrdersId)">
                                        <td class="order-id">
                                            @(index + 1)
                                        </td>
                                        <td class="order-number">
                                            <div class="order-details">
                                                <div class="order-title">
                                                    <i class="fas fa-hashtag text-primary me-1"></i>
                                                    #@order.OrderNumber
                                                </div>
                                            </div>
                                        </td>
                                        <td class="order-client">
                                            @if (order.Clients.ClientTypeId == 1 && order.Clients.IndividualClients.Any())
                                            {
                                                var individual = order.Clients.IndividualClients.First();
                                                <div class="client-info">
                                                    <div class="client-name">@individual.LastName @individual.FirstName</div>
                                                    <div class="client-contact">
                                                        <i class="fas fa-phone text-success me-1"></i>
                                                        @order.Clients.Phone
                                                    </div>
                                                </div>
                                            }
                                            else if (order.Clients.ClientTypeId == 2 && order.Clients.CompanyClients.Any())
                                            {
                                                var company = order.Clients.CompanyClients.First();
                                                <div class="client-info">
                                                    <div class="client-name">@company.CompanyName</div>
                                                    <div class="client-contact">
                                                        <i class="fas fa-id-card text-warning me-1"></i>
                                                        ИНН: @company.Inn
                                                    </div>
                                                </div>
                                            }
                                        </td>
                                        <td class="order-route">
                                            <div class="route-info">
                                                <div class="route-from">
                                                    <i class="fas fa-map-marker-alt text-danger me-1"></i>
                                                    @order.OriginTown.TownName
                                                </div>
                                                <div class="route-arrow">
                                                    <i class="fas fa-arrow-right text-muted"></i>
                                                </div>
                                                <div class="route-to">
                                                    <i class="fas fa-flag-checkered text-success me-1"></i>
                                                    @order.DestinationTown.TownName
                                                </div>
                                            </div>
                                        </td>
                                        <td class="order-package">
                                            <div class="package-info">
                                                @if (order.Template != null)
                                                {
                                                    <div class="package-type">
                                                        <i class="fas fa-box text-primary me-1"></i>
                                                        @order.Template.TemplateName
                                                    </div>
                                                }
                                                @if (order.Weight != null && order.Weight > 0)
                                                {
                                                    <div class="package-weight text-muted">
                                                        <i class="fas fa-weight-hanging me-1"></i>
                                                        @order.Weight 
                                                    </div>
                                                }

                                                @if (order.LengthCm > 0 && order.WidthCm > 0 && order.HeightCm > 0)
                                                {
                                                    <div class="package-size text-muted">
                                                        <i class="fas fa-ruler-combined me-1"></i>
                                                        @order.LengthCm × @order.WidthCm × @order.HeightCm 
                                                    </div>
                                                }
                                            </div>
                                        </td>
                                        <td class="order-status">
                                            @{
                                                var lastTracking = order.Trackings.OrderByDescending(t => t.UpdateDate).FirstOrDefault();
                                            }
                                           <OrderStatusBadge  Status="@lastTracking?.Status" />
                                           
                                            @if (lastTracking != null)
                                            {
                                                <div class="tracking-info">
                                                    <small class="text-muted">
                                                        <i class="fas fa-map-marker-alt me-1"></i>
                                                        @lastTracking.LocationTrackings
                                                    </small>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .page-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
        padding: 2rem 0;
    }

    .page-header {
        background: white;
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        border: 1px solid rgba(0,0,0,0.05);
    }

    .header-icon {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.8rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        color: #6c757d;
        font-size: 1rem;
        margin-bottom: 0;
    }

    /* Statistics Cards */
    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        box-shadow: 0 5px 20px rgba(0,0,0,0.06);
        transition: all 0.3s ease;
        border: 1px solid transparent;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }

        .stat-card.stat-total {
            border-top: 4px solid #667eea;
        }

        .stat-card.stat-new {
            border-top: 4px solid #fd7e14;
        }

        .stat-card.stat-in-transit {
            border-top: 4px solid #0dcaf0;
        }

        .stat-card.stat-delivered {
            border-top: 4px solid #198754;
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
        margin-right: 1rem;
        flex-shrink: 0;
    }

    .stat-card.stat-total .stat-icon {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .stat-card.stat-new .stat-icon {
        background: linear-gradient(135deg, #fd7e14 0%, #e8590c 100%);
    }

    .stat-card.stat-in-transit .stat-icon {
        background: linear-gradient(135deg, #0dcaf0 0%, #0aa2c0 100%);
    }

    .stat-card.stat-delivered .stat-icon {
        background: linear-gradient(135deg, #198754 0%, #146c43 100%);
    }

    .stat-content h3 {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
        color: #2c3e50;
    }

    .stat-content p {
        color: #6c757d;
        margin-bottom: 0;
        font-size: 0.9rem;
    }

    /* Main Card */
    .main-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        border: 1px solid rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .table-container {
        overflow-x: auto;
        border-radius: 15px;
    }

    /* Orders Table */
    .orders-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .orders-table thead {
            background: linear-gradient(135deg, #f8f9ff 0%, #f0f2ff 100%);
        }

        .orders-table th {
            padding: 1.25rem 1rem;
            text-align: left;
            font-weight: 600;
            color: #495057;
            border-bottom: 2px solid #e9ecef;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .orders-table tbody tr {
            transition: all 0.2s ease;
            border-bottom: 1px solid #f8f9fa;
            cursor: pointer;
        }

            .orders-table tbody tr:hover {
                background-color: rgba(13, 110, 253, 0.05);
                transform: scale(1.01);
            }

        .orders-table td {
            padding: 1rem;
            vertical-align: top;
        }

    /* Column styles */
    .order-id {
        width: 60px;
        font-weight: 600;
        color: #495057;
        text-align: center;
    }

    .order-number {
        width: 180px;
    }

    .order-client {
        width: 220px;
    }

    .order-route {
        width: 200px;
    }

    .order-package {
        width: 150px;
    }

    .order-status {
        width: 180px;
    }

    .order-amount {
        width: 140px;
    }

    /* Content styles */
    .order-details {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .order-title {
        font-weight: 600;
        color: #2c3e50;
        font-size: 1.1rem;
    }

    .order-date {
        font-size: 0.85rem;
        color: #6c757d;
    }

    .client-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .client-name {
        font-weight: 500;
        color: #2c3e50;
    }

    .client-contact {
        font-size: 0.85rem;
        color: #6c757d;
    }

    .route-info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .route-from, .route-to {
        display: flex;
        align-items: center;
        font-size: 0.9rem;
    }

    .route-arrow {
        text-align: center;
        color: #adb5bd;
    }

    .package-info {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .package-detail {
        display: flex;
        align-items: center;
        font-size: 0.9rem;
        color: #495057;
    }

    .tracking-info {
        margin-top: 0.5rem;
        font-size: 0.8rem;
    }

    .amount-info {
        text-align: right;
    }

    .amount-value {
        font-weight: 600;
        font-size: 1.1rem;
    }

    .payment-method {
        font-size: 0.8rem;
    }

    /* Loading and Empty States */
    .loading-spinner {
        text-align: center;
    }

        .loading-spinner i.fa-3x {
            opacity: 0.5;
        }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
    }

    .empty-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #667eea;
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
    }

    .empty-title {
        font-size: 1.5rem;
        color: #2c3e50;
        margin-bottom: 0.5rem;
    }

    .empty-description {
        color: #6c757d;
        margin-bottom: 2rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-header {
            padding: 1.5rem;
        }

        .header-icon {
            width: 50px;
            height: 50px;
            font-size: 1.5rem;
        }

        .page-title {
            font-size: 1.5rem;
        }

        .stat-card {
            padding: 1rem;
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            font-size: 1.3rem;
        }

        .stat-content h3 {
            font-size: 1.5rem;
        }

        .orders-table {
            display: block;
        }

            .orders-table thead {
                display: none;
            }

            .orders-table tbody tr {
                display: block;
                margin-bottom: 1rem;
                border: 1px solid #dee2e6;
                border-radius: 10px;
                overflow: hidden;
            }

            .orders-table td {
                display: block;
                padding: 0.75rem 1rem;
                border-bottom: 1px solid #f8f9fa;
                position: relative;
                padding-left: 45%;
            }

                .orders-table td:before {
                    content: attr(data-label);
                    position: absolute;
                    left: 1rem;
                    width: 40%;
                    padding-right: 1rem;
                    font-weight: 600;
                    color: #495057;
                    font-size: 0.85rem;
                }

                .orders-table td:last-child {
                    border-bottom: none;
                }
    }
</style>

@code {
    private List<Order>? orders;
    private List<StatusDelivery> statuses = new();
    protected override async Task OnInitializedAsync()
    {
        orders = await OrderQueryService.GetOrdersWithDetailsAsync();
        statuses = await OrderQueryService.GetStatusesAsync();
    }

   
    private void NavigateToOrder(int orderId)
    {
        NavigationManager.NavigateTo($"/orders/details/{orderId}");
    }

} 
