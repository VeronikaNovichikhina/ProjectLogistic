@page "/orders/create"
@using LogisticCompany.Application.DTO
@using LogisticCompany.Application.Interfaces
@using LogisticCompany.Application.Services
@using LogisticCompany.DTO
@using LogisticCompany.Db
@using LogisticCompany.Domain.Entities.Employee
@using LogisticCompany.Domain.Entities.Location
@using LogisticCompany.Domain.Entities.Orders
@using LogisticCompany.Domain.Entities.Tracking
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject NavigationManager NavigationManager
@using Microsoft.JSInterop
@using System.Security.Cryptography
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IHttpClientFactory HttpClientFactory

@inject IClientService ClientService
@inject ILocationService LocationService
@inject IDeliveryDictionaryService DeliveryDictionaryService
@inject IPriceCalculatorService PriceCalculator
@inject IOrderService OrderService
@inject IEmployeeService EmployeeService




<div class="office-manager-layout bg-light min-vh-100">
    <div class="container-fluid px-4 py-3">
        <!-- Шапка процесса -->
        <div class="process-header mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1 text-dark fw-bold">
                        <i class="fas fa-truck-fast me-2 text-primary"></i>
                        Создание заказа
                    </h4>
                    <p class="text-muted small mb-0">Заполните все этапы для оформления доставки</p>
                </div>
                
            </div>
        </div>

        <div class="row g-4">
            <!-- Основная колонка с формой -->
            <div class="col-lg-9">
                <!-- Процесс-бар (горизонтальный компактный) -->
                <div class="process-tracker mb-4">
                    <div class="d-flex align-items-center justify-content-between position-relative">
                        <div class="progress-line"></div>
                        @foreach (var stepInfo in steps)
                        {
                            <div class="process-step">
                                <button class="step-button @(step >= stepInfo.Number ? "completed" : "") @(step == stepInfo.Number ? "active" : "")"
                                        @onclick="() => { if (stepInfo.Number <= step) this.step = stepInfo.Number; }"
                                        title="@stepInfo.Label">
                                    <div class="step-icon">
                                        @if (step > stepInfo.Number)
                                        {
                                            <i class="fas fa-check"></i>
                                        }
                                        else
                                        {
                                            <span class="step-number">@stepInfo.Number</span>
                                        }
                                    </div>
                                    <span class="step-title">@stepInfo.Label</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>

                @if (step > 1)
                {
                    <div class="mb-3">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="GoBack">
                            <i class="fas fa-arrow-left me-1"></i> Вернуться
                        </button>
                    </div>
                }

                <EditForm Model="@order" OnValidSubmit="SaveOrder" FormName="createOrder">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger alert-sm mb-4" />

                    <div class="form-container">
                        <!-- Шаг 1: Клиенты -->
                        @if (step == 1)
                        {
                            <div class="form-step-card">
                                <div class="step-header bg-primary-soft">
                                    <div class="d-flex align-items-center">
                                        <div class="step-icon-wrapper me-3">
                                            <i class="fas fa-users"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-0">Клиент</h5>
                                            <small class="text-muted">Выберите или создайте нового клиента</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="step-body p-4">
                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">Тип клиента *</label>
                                        <InputRadioGroup @bind-Value="selectedClientTypeId">
                                            <div class="btn-group w-100" role="group">
                                                <label class="btn @(selectedClientTypeId == 1 ? "btn-primary" : "btn-outline-primary")">
                                                    <InputRadio Value="1" />
                                                    <i class="fas fa-user me-2"></i>Физическое лицо
                                                </label>
                                                <label class="btn @(selectedClientTypeId == 2 ? "btn-primary" : "btn-outline-primary")">
                                                    <InputRadio Value="2" />
                                                    <i class="fas fa-building me-2"></i>Компания
                                                </label>
                                            </div>
                                        </InputRadioGroup>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">
                                            Поиск клиента
                                            <span class="text-muted small">(@(selectedClientTypeId == 1 ? "по паспорту" : "по ИИН"))</span>
                                        </label>
                                        <div class="position-relative">
                                            <div class="input-group">
                                                <span class="input-group-text bg-light">
                                                    <i class="fas fa-search text-muted"></i>
                                                </span>
                                                <InputText @bind-Value="clientSearch" class="form-control"
                                                           placeholder="Введите данные для поиска..."
                                                           @oninput="OnClientSearch" />
                                            </div>

                                            @if (FilteredClients.Any() && !string.IsNullOrWhiteSpace(clientSearch))
                                            {
                                                <div class="search-results-dropdown mt-2 border rounded shadow-sm bg-white">
                                                    <div class="list-group">
                                                        @foreach (var ct in FilteredClients)
                                                        {
                                                            if (selectedClientTypeId == 1 && ct.IndividualClients?.Any() == true)
                                                            {
                                                                var indiv = ct.IndividualClients.First();
                                                                <a class="list-group-item list-group-item-action"
                                                                   @onclick="() => SelectClient(ct.ClientsId)">
                                                                    <div class="d-flex justify-content-between align-items-center">
                                                                        <div>
                                                                            <h6 class="mb-1">@indiv.LastName @indiv.FirstName @indiv.PatronymicName</h6>
                                                                            <small class="text-muted">Паспорт: @indiv.PassportNumber</small>
                                                                        </div>
                                                                        <i class="fas fa-chevron-right text-muted"></i>
                                                                    </div>
                                                                </a>
                                                            }
                                                            else if (selectedClientTypeId == 2 && ct.CompanyClients?.Any() == true)
                                                            {
                                                                var comp = ct.CompanyClients.First();
                                                                <a class="list-group-item list-group-item-action"
                                                                   @onclick="() => SelectClient(ct.ClientsId)">
                                                                    <div class="d-flex justify-content-between align-items-center">
                                                                        <div>
                                                                            <h6 class="mb-1">@comp.CompanyName</h6>
                                                                            <small class="text-muted">ИИН: @comp.Inn</small>
                                                                        </div>
                                                                        <i class="fas fa-chevron-right text-muted"></i>
                                                                    </div>
                                                                </a>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        <ValidationMessage For="() => order.ClientsId" class="text-danger small mt-1" />
                                    </div>

                                    @{
                                        var selectedClient = clients?.FirstOrDefault(c => c.ClientsId == order.ClientsId);
                                        var clientHasAccess = selectedClient?.UserId != null;
                                    }

                                    @if (!clientHasAccess && order.ClientsId != 0)
                                    {
                                        <div class="alert alert-info border-0 mb-4">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-key me-3 fs-5"></i>
                                                <div class="flex-grow-1">
                                                    <h6 class="alert-heading mb-2">Создать доступ для клиента</h6>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-white">
                                                            <i class="fas fa-envelope text-muted"></i>
                                                        </span>
                                                        <InputText @bind-Value="newClientEmail" class="form-control"
                                                                   placeholder="email@example.com" />
                                                    </div>
                                                    <small class="text-muted">На этот email будет отправлен пароль для входа в систему</small>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else if (clientHasAccess)
                                    {
                                        <div class="alert alert-success border-0 mb-4">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-check-circle me-3 fs-5"></i>
                                                <div>
                                                    <h6 class="alert-heading mb-1">Доступ к системе активирован</h6>
                                                    <small class="mb-0">Клиент может отслеживать заказы через личный кабинет</small>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="d-flex gap-3 mt-4">
                                        <NavLink href="/clients/create" class="btn btn-outline-primary flex-fill">
                                            <i class="fas fa-plus-circle me-2"></i>Новый клиент
                                        </NavLink>
                                        <button class="btn btn-primary flex-fill"
                                                @onclick="() => NextStep(1)"
                                                disabled="@(order.ClientsId == 0 || (!clientHasAccess && string.IsNullOrWhiteSpace(newClientEmail)))">
                                            Далее <i class="fas fa-arrow-right ms-2"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Шаг 2: Получатель -->
                        @if (step == 2)
                        {
                            <div class="form-step-card">
                                <div class="step-header bg-info-soft">
                                    <div class="d-flex align-items-center">
                                        <div class="step-icon-wrapper me-3">
                                            <i class="fas fa-user-tag"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-0">Получатель</h5>
                                            <small class="text-muted">Укажите данные получателя посылки</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="step-body p-4">
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">Фамилия *</label>
                                            <div class="input-with-icon">
                                                <i class="fas fa-user"></i>
                                                <InputText @bind-Value="order.LastRecepientName" class="form-control"
                                                           placeholder="Иванов" />
                                            </div>
                                            <ValidationMessage For="() => order.LastRecepientName" class="text-danger small mt-1" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">Имя *</label>
                                            <div class="input-with-icon">
                                                <i class="fas fa-user"></i>
                                                <InputText @bind-Value="order.FirstRecepientName" class="form-control"
                                                           placeholder="Иван" />
                                            </div>
                                            <ValidationMessage For="() => order.FirstRecepientName" class="text-danger small mt-1" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label fw-semibold">Отчество</label>
                                            <div class="input-with-icon">
                                                <i class="fas fa-user"></i>
                                                <InputText @bind-Value="order.MiddleRecepientName" class="form-control"
                                                           placeholder="Иванович" />
                                            </div>
                                            <ValidationMessage For="() => order.MiddleRecepientName" class="text-danger small mt-1" />
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">Телефон *</label>
                                        <div class="input-with-icon">
                                            <i class="fas fa-phone"></i>
                                            <input @bind="order.PhoneRecepient" @ref="phoneInput"
                                                   class="form-control" placeholder="+7 (XXX) XXX-XX-XX" />
                                        </div>
                                        <ValidationMessage For="() => order.PhoneRecepient" class="text-danger small mt-1" />
                                    </div>

                                    <div class="text-end">
                                        <button class="btn btn-primary px-5"
                                                @onclick="NextStep2"
                                                disabled="@(string.IsNullOrWhiteSpace(order.FirstRecepientName?.Trim()) ||
                                                                                                           string.IsNullOrWhiteSpace(order.LastRecepientName?.Trim()) ||
                                                                                                           string.IsNullOrWhiteSpace(order.PhoneRecepient?.Trim()))">
                                            Далее <i class="fas fa-arrow-right ms-2"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Шаг 3: Посылка -->
                        @if (step == 3)
                        {
                            <div class="form-step-card">
                                <div class="step-header bg-warning-soft">
                                    <div class="d-flex align-items-center">
                                        <div class="step-icon-wrapper me-3">
                                            <i class="fas fa-box"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-0">Посылка</h5>
                                            <small class="text-muted">Укажите параметры отправления</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="step-body p-4">
                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">Тип посылки *</label>
                                        <InputRadioGroup @bind-Value="selectedTypeParcel">
                                            <div class="d-flex gap-3">
                                                <label class="parcel-type-card @(selectedTypeParcel == 1 ? "active" : "")">
                                                    <InputRadio Value="1" />
                                                    <div class="parcel-type-content">
                                                        <i class="fas fa-cube"></i>
                                                        <span>Стандартные размеры</span>
                                                    </div>
                                                </label>
                                                <label class="parcel-type-card @(selectedTypeParcel == 2 ? "active" : "")">
                                                    <InputRadio Value="2" />
                                                    <div class="parcel-type-content">
                                                        <i class="fas fa-ruler-combined"></i>
                                                        <span>Нестандартные размеры</span>
                                                    </div>
                                                </label>
                                            </div>
                                        </InputRadioGroup>
                                    </div>

                                    @if (selectedTypeParcel == 1)
                                    {
                                        <div class="mb-4">
                                            <label class="form-label fw-semibold">Шаблон посылки</label>
                                            <div class="input-with-icon">
                                                <i class="fas fa-box-open"></i>
                                                <InputSelect @bind-Value="order.ParcelTemplateId" class="form-select">
                                                    <option value="0" disabled selected>Выберите шаблон посылки</option>
                                                    @if (parcelTemplates != null)
                                                    {
                                                        @foreach (var template in parcelTemplates)
                                                        {
                                                            <option value="@template.TemplateId">
                                                                @template.TemplateName — @template.LengthCm×@template.WidthCm×@template.HeightCm см
                                                            </option>
                                                        }
                                                    }
                                                </InputSelect>
                                            </div>
                                            <ValidationMessage For="() => order.ParcelTemplateId" class="text-danger small mt-1" />
                                        </div>
                                    }
                                    else if (selectedTypeParcel == 2)
                                    {
                                        <div class="row g-3 mb-4">
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Длина (см) *</label>
                                                <div class="input-with-icon">
                                                    <i class="fas fa-ruler-vertical"></i>
                                                    <InputNumber @bind-Value="order.LengthCm" class="form-control"
                                                                 placeholder="0" />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Ширина (см) *</label>
                                                <div class="input-with-icon">
                                                    <i class="fas fa-ruler-horizontal"></i>
                                                    <InputNumber @bind-Value="order.WidthCm" class="form-control"
                                                                 placeholder="0" />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Высота (см) *</label>
                                                <div class="input-with-icon">
                                                    <i class="fas fa-arrows-alt-v"></i>
                                                    <InputNumber @bind-Value="order.HeightCm" class="form-control"
                                                                 placeholder="0" />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-semibold">Вес (кг) *</label>
                                                <div class="input-with-icon">
                                                    <i class="fas fa-weight-hanging"></i>
                                                    <InputNumber @bind-Value="order.Weight" class="form-control"
                                                                 placeholder="0" />
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="mb-4">
                                        <label class="form-label fw-semibold">Описание посылки</label>
                                        <div class="input-with-icon">
                                            <i class="fas fa-file-alt"></i>
                                            <InputText @bind-Value="order.DescriptionParcel" class="form-control"
                                                       placeholder="Опишите содержимое посылки..." />
                                        </div>
                                        <ValidationMessage For="() => order.DescriptionParcel" class="text-danger small mt-1" />
                                    </div>

                                    <div class="text-end">
                                        <button class="btn btn-primary px-5"
                                                @onclick="() => NextStep(3)"
                                                disabled="@(!IsParcelValid())">
                                            Далее <i class="fas fa-arrow-right ms-2"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Шаг 4: Доставка -->
                        @if (step == 4)
                        {
                            <div class="form-step-card">
                                <div class="step-header bg-primary-soft">
                                    <div class="d-flex align-items-center">
                                        <div class="step-icon-wrapper me-3">
                                            <i class="fas fa-shipping-fast"></i>
                                        </div>
                                        <div>
                                            <h5 class="mb-0">Доставка</h5>
                                            <small class="text-muted">Настройте параметры доставки</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="step-body p-4">
                                    <div class="row g-4">
                                        <!-- Отправление -->
                                        <div class="col-md-6">
                                            <div class="delivery-section">
                                                <div class="section-header">
                                                    <h6 class="mb-0">
                                                        <i class="fas fa-location-arrow me-2"></i>Отправление
                                                        @if (isManager && managerBranch != null)
                                                        {
                                                            <span class="badge bg-success ms-2">Автозаполнено</span>
                                                        }
                                                    </h6>
                                                </div>
                                                <div class="section-body">
                                                    @if (isManager && managerBranch != null)
                                                    {
                                                        <div class="auto-fill-notice">
                                                            <i class="fas fa-info-circle"></i>
                                                            Заполнено из вашего профиля
                                                        </div>
                                                    }

                                                    <div class="mb-3">
                                                        <label class="form-label">Страна отправления</label>
                                                        <InputSelect @bind-Value="order.OriginCountryId" class="form-control"
                                                                     disabled="@(isManager && managerCountry != null)">
                                                            <option value="0" disabled>Выберите страну</option>
                                                            @if (countries != null)
                                                            {
                                                                @foreach (var ct in countries)
                                                                {
                                                                    <option value="@ct.CountryId">@ct.CountryName</option>
                                                                }
                                                            }
                                                        </InputSelect>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label">Город отправления</label>
                                                        <InputSelect @bind-Value="order.OriginTownId" class="form-control"
                                                                     disabled="@(isManager && managerTown != null)">
                                                            <option value="0" disabled>Выберите город</option>
                                                            @if (towns != null)
                                                            {
                                                                foreach (var town in FilteredTowns)
                                                                {
                                                                    <option value="@town.TownId">@town.TownName</option>
                                                                }
                                                            }
                                                        </InputSelect>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label">Филиал забора</label>
                                                        <InputSelect @bind-Value="order.PickupBranchesId" class="form-control"
                                                                     disabled="@(isManager && managerBranch != null)">
                                                            <option value="0" disabled>Выберите филиал</option>
                                                            @if (branches != null)
                                                            {
                                                                foreach (var branch in FilteredBranches)
                                                                {
                                                                    <option value="@branch.BranchesId">@branch.NameBranches</option>
                                                                }
                                                            }
                                                        </InputSelect>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Настройки доставки -->
                                        <div class="col-12">
                                            <div class="delivery-settings">
                                                <div class="col-md-6">
                                                    <div class="col-md-6">
                                                        <label class="form-label">Тип доставки</label>
                                                        <InputSelect @bind-Value="order.DeliveryTypeId" class="form-control">
                                                            <option value="0" disabled>Выберите тип доставки</option>
                                                            @if (deliveryTypes != null)
                                                            {
                                                                @foreach (var dl in deliveryTypes)
                                                                {
                                                                    <option value="@dl.DeliveryTypeId">@dl.NameDeliveryType</option>
                                                                }
                                                            }
                                                        </InputSelect>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">Тип транспорта</label>
                                                        <InputSelect @bind-Value="order.TransportTypeId" class="form-control">
                                                            <option value="0" disabled>Выберите транспорт</option>
                                                            @if (transportTypes != null)
                                                            {
                                                                @foreach (var transportType in transportTypes)
                                                                {
                                                                    <option value="@transportType.TransportTypeId">@transportType.NameTransportType</option>
                                                                }
                                                            }
                                                        </InputSelect>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <!-- Назначение -->
                                        <div class="col-md-6">
                                            <div class="delivery-section">
                                                <div class="section-header">
                                                    <h6 class="mb-0"><i class="fas fa-map-marker-alt me-2"></i>Назначение</h6>
                                                </div>
                                                <div class="section-body">
                                                    <div class="mb-3">
                                                        <label class="form-label">Страна назначения</label>
                                                        <InputSelect @bind-Value="order.DestinationCountryId" class="form-control">
                                                            <option value="0" disabled>Выберите страну</option>
                                                            @if (countries != null)
                                                            {
                                                                @foreach (var ct in countries)
                                                                {
                                                                    <option value="@ct.CountryId">@ct.CountryName</option>
                                                                }
                                                            }
                                                        </InputSelect>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label">Город назначения</label>
                                                        <InputSelect @bind-Value="order.DestinationTownId" class="form-control">
                                                            <option value="0" disabled>Выберите город</option>
                                                            @if (towns != null)
                                                            {
                                                                @foreach (var town in FilteredTownsDes)
                                                                {
                                                                    <option value="@town.TownId">@town.TownName</option>
                                                                }
                                                            }
                                                        </InputSelect>
                                                    </div>

                                                    @if (order.DeliveryTypeId == 2)
                                                    {
                                                        <div class="mb-3">
                                                            <label class="form-label">Филиал назначения</label>
                                                            <InputSelect @bind-Value="order.DestinationBranchesId" class="form-control">
                                                                <option value="0" disabled>Выберите филиал</option>
                                                                @if (branches != null)
                                                                {
                                                                    @foreach (var branch in FilteredBranchesDes)
                                                                    {
                                                                        <option value="@branch.BranchesId">@branch.NameBranches</option>
                                                                    }
                                                                }
                                                            </InputSelect>
                                                        </div>
                                                    }

                                                    @if (order.DeliveryTypeId == 1)
                                                    {
                                                        <div class="mb-3">
                                                            <label class="form-label">Адрес доставки</label>
                                                            <div class="input-with-icon">
                                                                <i class="fas fa-home"></i>
                                                                <input @bind="order.CourierDestAddress" class="form-control"
                                                                       placeholder="Введите полный адрес доставки" />
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>


                                        <!-- Расчет стоимости -->
                                        @if (order.OriginTownId > 0 && order.DestinationTownId > 0)
                                        {
                                            <div class="col-12">
                                                <div class="price-calculation">
                                                    <div class="calculation-header">
                                                        <h6 class="mb-0"><i class="fas fa-calculator me-2"></i>Расчет стоимости</h6>
                                                    </div>
                                                    <div class="calculation-body">
                                                        @if (calculatedPrice == -1)
                                                        {
                                                            <div class="text-center py-3">
                                                                <div class="spinner-border text-primary" role="status"></div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="price-breakdown">
                                                                <div class="price-item">
                                                                    <span>Расстояние:</span>
                                                                    <span class="fw-semibold">@distance.ToString("F1") км</span>
                                                                </div>
                                                                <div class="price-item">
                                                                    <span>Тариф:</span>
                                                                    <span class="fw-semibold">
                                                                        @(deliveryTariffs.FirstOrDefault(t => t.DeliveryTypeId == order.DeliveryTypeId)?.BasePrice.ToString("F2") ?? "0.00")
                                                                    </span>
                                                                </div>
                                                                <div class="price-total">
                                                                    <span>Итого:</span>
                                                                    <span class="fw-bold fs-5 text-primary">@calculatedPrice.ToString("F2")</span>
                                                                </div>
                                                            </div>
                                                        }

                                                        <div class="text-center mt-3">
                                                            <button type="button" class="btn btn-outline-primary"
                                                                    @onclick="CalculatePrice"
                                                                    disabled="@(order.OriginTownId == 0 || order.DestinationTownId == 0)">
                                                                <i class="fas @(calculatedPrice > 0 ? "fa-sync-alt" : "fa-calculator") me-2"></i>
                                                                @(calculatedPrice > 0 ? "Пересчитать" : "Рассчитать")
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <div class="text-end mt-4">
                                        <button class="btn btn-primary px-5"
                                                @onclick="() => NextStep(4)"
                                                disabled="@(order.OriginCountryId == 0 || order.OriginTownId == 0 || order.PickupBranchesId == 0 ||
                                                                                                           order.DestinationCountryId == 0 || order.DestinationTownId == 0 ||
                                                                                                           (order.DeliveryTypeId == 2 && order.DestinationBranchesId == 0) ||
                                                                                                           (order.DeliveryTypeId == 1 && string.IsNullOrWhiteSpace(order.CourierDestAddress)))">
                                            Далее <i class="fas fa-arrow-right ms-2"></i>
                                        </button>
