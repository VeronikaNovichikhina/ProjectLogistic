        string senderPhone = "-";

        var sender = clients.FirstOrDefault(c => c.ClientsId == order.ClientsId);

        if (sender != null)
        {
            senderPhone = sender.Phone ?? "-";
            if (sender.ClientTypeId == 1)
            {
                var individual = sender.IndividualClients?.FirstOrDefault();
                if (individual != null)
                {
                    senderFio = $"{individual.FirstName} {individual.PatronymicName} {individual.LastName}";

                }
            }
            else if (sender.ClientTypeId == 2)
            {
                var company = sender.CompanyClients?.FirstOrDefault();
                if (company != null)
                {
                    senderFio = $"{company.CompanyName} {company.Inn}";

                }
            }
        }
        string length = "-";
        string width = "-";
        string height = "-";
        string weight = "-";
        string parcelType = selectedTypeParcel == 1 ? "Стандартный шаблон" : "Нестандартный размер";

        if (selectedTypeParcel == 1 && order.ParcelTemplateId > 0)
        {
            var template = parcelTemplates.FirstOrDefault(t => t.TemplateId == order.ParcelTemplateId);
            if (template != null)
            {
                length = template.LengthCm?.ToString() ?? "-";
                width = template.WidthCm?.ToString() ?? "-";
                height = template.HeightCm?.ToString() ?? "-";
                weight = template.MaxWeight?.ToString() ?? "-";
            }
        }
        else if (selectedTypeParcel == 2)
        {
            length = order.LengthCm?.ToString() ?? "-";
            width = order.WidthCm?.ToString() ?? "-";
            height = order.HeightCm?.ToString() ?? "-";
            weight = order.Weight?.ToString() ?? "-";
        }


        var clientFio = $"{order.FirstRecepientName} {order.MiddleRecepientName} {order.LastRecepientName}";
        var clientPhone = order.PhoneRecepient ?? "";

        var originCountry = countries.FirstOrDefault(c => c.CountryId == order.OriginCountryId)?.CountryName ?? "-";
        var originTown = towns.FirstOrDefault(t => t.TownId == order.OriginTownId)?.TownName ?? "-";
