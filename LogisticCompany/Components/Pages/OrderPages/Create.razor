@code {
    [SupplyParameterFromForm]
    private OrdersDTO order { get; set; } = new();
    private int step = 1;
    private int selectedTypeParcel = 1;
    private string clientSearch = "";
    private string newClientEmail = "";
    private string generatedPassword = "";
    private bool isNewClientRegistered = false;
    // Списки для справочников
    private List<Client> clients = new();
    private List<Town> towns = new();
    private List<Branch> branches = new();
    private List<DeliveryType> deliveryTypes = new();
    private List<TransportType> transportTypes = new();
    private List<PaymentMethod> paymentMethods = new();
    private List<Country> countries = new();
    private List<ParcelTemplate> parcelTemplates = new();
    private List<DeliveryTariff> deliveryTariffs = new();
    private decimal calculatedPrice = 0;
    private decimal distance = 0;
    private bool isManager = false;
    private Employee currentManager = null;
    private Branch managerBranch = null;
    private Town managerTown = null;
    private Country managerCountry = null;
    private int selectedClientTypeId = 1;
    private ElementReference phoneInput;
    //Шаги навигации
    private void NextStep(int s)
    {
        if (s == step)
        {
            step++;
            StateHasChanged();
        }
        switch (s)
        {
            case 1 when order.ClientsId != 0:
                step = 2;
                break;
            case 2 when (!string.IsNullOrWhiteSpace(order.FirstRecepientName?.Trim()) &&
             !string.IsNullOrWhiteSpace(order.LastRecepientName?.Trim()) &&
             !string.IsNullOrWhiteSpace(order.PhoneRecepient?.Trim())):
                step = 3;
                break;
            case 3 when IsParcelValid():
                step = 4;
                break;
            case 4 when order.OriginCountryId != 0
     && order.OriginTownId != 0
     && order.PickupBranchesId != 0
     && order.DestinationCountryId != 0
     && order.DestinationTownId != 0
     && ((order.DeliveryTypeId == 2 && order.DestinationBranchesId != 0)
         || (order.DeliveryTypeId == 1 && !string.IsNullOrWhiteSpace(order.CourierDestAddress))):
                step = 5;
                break;
            case 5 when order.PaymentMethodId != 0 && !string.IsNullOrWhiteSpace(order.Amount):
                step = 5;
                break;
        }
    }
    private void GoBack()
    {
        if (step > 1)
        {
            step--;
            StateHasChanged();
        }
    }

    private void NextStep2()
    {
        StateHasChanged();
        NextStep(2);
    }
    private bool IsParcelValid()
    {
        if (selectedTypeParcel == 1)
            return order.ParcelTemplateId != 0;
        else
            return order.LengthCm > 0 && order.WidthCm > 0 && order.HeightCm > 0 && order.Weight > 0;
    }

    //Поиск клиентов
    private void OnClientSearch(ChangeEventArgs e)
    {
        clientSearch = e.Value?.ToString() ?? "";
    }
    private IEnumerable<Client> FilteredClients =>
        clients.Where(c =>
            string.IsNullOrWhiteSpace(clientSearch) ||
            (c.ClientTypeId == 1 && c.IndividualClients?.Any() == true &&
             c.IndividualClients.First().PassportNumber?.StartsWith(clientSearch, StringComparison.OrdinalIgnoreCase) == true) ||
            (c.ClientTypeId == 2 && c.CompanyClients?.Any() == true &&
             c.CompanyClients.First().Inn?.StartsWith(clientSearch, StringComparison.OrdinalIgnoreCase) == true));
    private void SelectClient(int clientId)
    {
        order.ClientsId = clientId;
        var selected = clients.FirstOrDefault(c => c.ClientsId == clientId);
        if (selected != null)
        {
            clientSearch = selected.ClientTypeId switch
            {
                1 => selected.IndividualClients?.FirstOrDefault() is var indiv && indiv != null
                     ? $"{indiv.LastName} {indiv.FirstName} {indiv.PatronymicName} ({indiv.PassportNumber})"
                     : "",
                2 => selected.CompanyClients?.FirstOrDefault() is var comp && comp != null
                     ? $"{comp.CompanyName} ({comp.Inn})"
                     : "",
                _ => ""
            };
        }
    }
    //Создание заказа
    private async Task SaveOrder()
    {

        try
        {
            var createRequest = new CreateOrderRequest
            {
                ClientId = order.ClientsId,
                CourierAddress = order.CourierDestAddress,
                FirstName = order.FirstRecepientName,
                MiddleName = order.MiddleRecepientName,
                LastName = order.LastRecepientName,
                Phone = order.PhoneRecepient,
                ParcelTemplateId = order.ParcelTemplateId,
                Description = order.DescriptionParcel,
                OriginTownId = order.OriginTownId,
                DestinationTownId = order?.DestinationTownId ?? 0,
                PickupBranchId = order.PickupBranchesId,
                DestinationBranchId = order.DestinationBranchesId,
                DeliveryTypeId = order.DeliveryTypeId,
                TransportTypeId = order.TransportTypeId,
                LengthCm = selectedTypeParcel == 2 ? order.LengthCm ?? 0 : 0,
                WidthCm = selectedTypeParcel == 2 ? order.WidthCm ?? 0 : 0,
                HeightCm = selectedTypeParcel == 2 ? order.HeightCm ?? 0 : 0,
                Weight = selectedTypeParcel == 2 ? order.Weight ?? 0 : 0,
                PaymentMethodId = order.PaymentMethodId,
                Amount = order.Amount
            };
            if (selectedTypeParcel == 1 && order.ParcelTemplateId > 0)
            {
                createRequest.ParcelTemplateId = order.ParcelTemplateId;
                var template = parcelTemplates.FirstOrDefault(t => t.TemplateId == order.ParcelTemplateId);
                if (template != null)
                {
                    createRequest.LengthCm = template.LengthCm ?? 0;
                    createRequest.WidthCm = template.WidthCm ?? 0;
                    createRequest.HeightCm = template.HeightCm ?? 0;
                    createRequest.Weight = template.MaxWeight ?? 0;
                }
            }
            var result = await OrderService.CreateOrderAsync(createRequest, newClientEmail);

            string message = "Заказ успешно создан!";

            if (!string.IsNullOrEmpty(result.Email) &&
                !string.IsNullOrEmpty(result.TemporaryPassword))
            {
                message += $"\n\nДанные для входа:\nЛогин: {result.Email}\nПароль: {result.TemporaryPassword}";
            }

            await JS.InvokeVoidAsync("alert", message);
            NavigationManager.NavigateTo("/ordersList");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Ошибка при создании заказа: {ex.Message}");
        }
    }
    //Загрузка списков
    protected override async Task OnInitializedAsync()
    {
        using var db = await DbContextFactory.CreateDbContextAsync();

        clients = await ClientService.GetAllClientAsync();
        towns = await LocationService.GetAllTownAsync();
        countries = await LocationService.GetAllCountriesAsync();
        branches = await LocationService.GetAllBranchesAsync();
        deliveryTypes = await DeliveryDictionaryService.GetDeliveryTypesAsync();
        transportTypes = await DeliveryDictionaryService.GetTransportTypesAsync();
        paymentMethods = await DeliveryDictionaryService.GetPaymentMethodsAsync();
        parcelTemplates = await DeliveryDictionaryService.GetParcelTemplatesAsync();
        deliveryTariffs = await DeliveryDictionaryService.GetDeliveryTariffAsync();

        order.StatusId = 1;
        order.TrackingBranchId = order.PickupBranchesId;
        await LoadCurrentUserData();

        if (order.OriginTownId > 0)
        {
            var originTown = towns.FirstOrDefault(t => t.TownId == order.OriginTownId);
            order.LocationTracking = originTown?.TownName ?? "Неизвестно";
        }

    }
    //Подсчет цены
    private async Task CalculatePrice()
    {
        try
        {
            calculatedPrice = -1;

            var result = await PriceCalculator.CalculateAsync(order,towns, deliveryTariffs,parcelTemplates,selectedTypeParcel);

            calculatedPrice = result.Price;
            distance = result.Distance;
            order.Amount = result.Price.ToString("F2");
            order.Distance = result.Distance;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка расчета: {ex.Message}");
            calculatedPrice = 0;
        }
    }
    
  
