        var deliveryType = deliveryTypes.FirstOrDefault(d => d.DeliveryTypeId == order.DeliveryTypeId)?.NameDeliveryType ?? "-";
        var transportType = transportTypes.FirstOrDefault(t => t.TransportTypeId == order.TransportTypeId)?.NameTransportType ?? "-";
        var paymentMethod = paymentMethods.FirstOrDefault(p => p.PaymentMethodId == order.PaymentMethodId)?.MethodName ?? "-";
        var paymentDate = order.PaymentDate.ToString("dd.MM.yyyy") ?? "-";

        var htmlContent = $@"
    <html>
