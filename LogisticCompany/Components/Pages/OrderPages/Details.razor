 @page "/orders/details/{OrdersId:int}"
@using LogisticCompany.Db
@using LogisticCompany.Domain.Entities.Orders
@using Microsoft.EntityFrameworkCore
@inject AppDbContext context
@inject NavigationManager NavigationManager

<style>
    .page-bg {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .order-detail-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .info-section {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
        border-radius: 15px;
        padding: 1.5rem;
        height: 100%;
        transition: transform 0.3s ease;
    }

        .info-section:hover {
            transform: translateY(-5px);
        }

    .status-badge {
        font-size: 0.9rem;
        padding: 0.5rem 1rem;
        border-radius: 25px;
    }

    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .route-arrow {
        color: #28a745;
        animation: bounce 2s infinite;
    }

    @@keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateX(0);
        }

        40% {
            transform: translateX(5px);
        }

        60% {
            transform: translateX(3px);
        }
    }

    .detail-item {
        border-bottom: 1px solid #e9ecef;
        padding: 0.75rem 0;
    }

        .detail-item:last-child {
            border-bottom: none;
        }
</style>

<div class="page-bg min-vh-100 py-5">
    <div class="container">
        @if (order == null)
        {
            <div class="card order-detail-card">
                <div class="card-body text-center py-5">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Загрузка...</span>
                    </div>
                    <h4 class="text-muted">Загрузка данных заказа...</h4>
                </div>
            </div>
        }
        else
        {
            <!-- Header Card -->
            <div class="card order-detail-card mb-4">
                <div class="card-header bg-white py-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center">
                                <div class="icon-circle bg-success me-3">
                                    <i class="fas fa-clipboard-check text-white"></i>
                                </div>
                                <div>
                                    <h1 class="h3 fw-bold text-dark mb-1">Заказ №@order.OrdersId</h1>
                                    <div class="d-flex align-items-center">
                                        
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <NavLink href="/ordersList" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Назад к списку
                            </NavLink>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Клиент и получатель -->
                <div class="col-lg-6">
                    <div class="info-section">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-circle bg-success me-3">
                                <i class="fas fa-users text-white"></i>
                            </div>
                            <h4 class="fw-bold text-dark mb-0">Информация о клиенте</h4>
                        </div>

                        <div class="detail-item">
                            <small class="text-muted d-block">Тип клиента</small>
                            <div class="d-flex align-items-center">
                                @if (order.Clients.ClientTypeId == 1)
                                {
                                    <span class="badge bg-info me-2">Физ. лицо</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning me-2">Компания</span>
                                }
                                @if (order.Clients.ClientTypeId == 1 && order.Clients.IndividualClients.Any())
                                {
                                    var individual = order.Clients.IndividualClients.First();
                                    <strong>@individual.LastName @individual.FirstName @individual.PatronymicName</strong>
                                }
                                else if (order.Clients.ClientTypeId == 2 && order.Clients.CompanyClients.Any())
                                {
                                    var company = order.Clients.CompanyClients.First();
                                    <strong>@company.CompanyName</strong>
                                }
                            </div>
                        </div>

                        <div class="detail-item">
                            <small class="text-muted d-block">Контактные данные</small>
                            <div>
                                <i class="fas fa-phone text-muted me-2"></i>
                                <span>@order.Clients.Phone</span>
                            </div>
                            @if (!string.IsNullOrEmpty(order.Clients.Email))
                            {
                                <div class="mt-1">
                                    <i class="fas fa-envelope text-muted me-2"></i>
                                    <span>@order.Clients.Email</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Получатель -->
                <div class="col-lg-6">
                    <div class="info-section">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-circle bg-info me-3">
                                <i class="fas fa-user-tag text-white"></i>
                            </div>
                            <h4 class="fw-bold text-dark mb-0">Данные получателя</h4>
                        </div>

                        <div class="detail-item">
                            <small class="text-muted d-block">ФИО получателя</small>
                            <strong>@order.LastRecepientName @order.FirstRecepientName @order.MiddleRecepientName</strong>
                        </div>

                        <div class="detail-item">
                            <small class="text-muted d-block">Контактный телефон</small>
                            <div>
                                <i class="fas fa-mobile-alt text-muted me-2"></i>
                                <strong>@order.PhoneRecepient</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Информация о посылке -->
                <div class="col-lg-6">
                    <div class="info-section">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-circle bg-warning me-3">
                                <i class="fas fa-box text-white"></i>
                            </div>
                            <h4 class="fw-bold text-dark mb-0">Информация о посылке</h4>
                        </div>

                        @if (order.TemplateId > 0 && order.Template != null)
                        {
                            <div class="detail-item">
                                <small class="text-muted d-block">Шаблон посылки</small>
                                <strong>@order.Template.TemplateName</strong>
                            </div>

                            <div class="detail-item">
                                <small class="text-muted d-block">Габариты</small>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-ruler-combined text-muted me-2"></i>
                                    <span>@order.Template.LengthCm × @order.Template.WidthCm × @order.Template.HeightCm см</span>
                                </div>
                            </div>

                            <div class="detail-item">
                                <small class="text-muted d-block">Вес</small>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-weight-hanging text-muted me-2"></i>
                                    <span>До @order.Template.MaxWeight кг</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="detail-item">
                                <small class="text-muted d-block">Габариты</small>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-ruler-combined text-muted me-2"></i>
                                    <span>@order.LengthCm × @order.WidthCm × @order.HeightCm см</span>
                                </div>
                            </div>

                            <div class="detail-item">
                                <small class="text-muted d-block">Вес</small>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-weight-hanging text-muted me-2"></i>
                                    <span>@order.Weight кг</span>
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(order.DescriptionParcel))
                        {
                            <div class="detail-item">
                                <small class="text-muted d-block">Описание</small>
                                <p class="mb-0">@order.DescriptionParcel</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Маршрут доставки -->
                <div class="col-lg-6">
                    <div class="info-section">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-circle bg-primary me-3">
                                <i class="fas fa-route text-white"></i>
                            </div>
                            <h4 class="fw-bold text-dark mb-0">Маршрут доставки</h4>
                        </div>

                        <div class="detail-item">
                            <small class="text-muted d-block">Отправление</small>
                            <div class="d-flex align-items-center mb-2">
                                <div class="bg-light rounded-circle p-2 me-3">
                                    <i class="fas fa-map-marker-alt text-danger"></i>
                                </div>
                                <div>
                                    <strong>@order.OriginTown.TownName</strong>
                                    <div class="text-muted small">@order.PickupBranches?.NameBranches</div>
                                </div>
                            </div>
                        </div>

                        <div class="text-center my-3">
                            <i class="fas fa-arrow-down route-arrow fa-2x"></i>
                        </div>

                        <div class="detail-item">
                            <small class="text-muted d-block">Назначение</small>
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded-circle p-2 me-3">
                                    <i class="fas fa-flag-checkered text-success"></i>
                                </div>
                                <div>
                                    <strong>@order.DestinationTown.TownName</strong>
                                    @if (order.DeliveryTypeId == 1)
                                    {
                                        <div class="text-muted small">Адрес: @order.CourierDestAddress</div>
                                    }
                                    else if (order.DeliveryTypeId == 2)
                                    {
                                        <div class="text-muted small">Филиал: @order.PickupBranches?.NameBranches</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Информация о доставке -->
                <div class="col-lg-6">
                    <div class="info-section">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-circle bg-info me-3">
                                <i class="fas fa-shipping-fast text-white"></i>
                            </div>
                            <h4 class="fw-bold text-dark mb-0">Детали доставки</h4>
                        </div>

                        <div class="detail-item">
                            <small class="text-muted d-block">Тип доставки</small>
                            <div class="d-flex align-items-center">
                                <i class="fas fa-truck text-muted me-2"></i>
                                <strong>@order.DeliveryType.NameDeliveryType</strong>
                            </div>
                        </div>

                        <div class="detail-item">
                            <small class="text-muted d-block">Тип транспорта</small>
                            <div class="d-flex align-items-center">
                                <i class="fas fa-bus text-muted me-2"></i>
                                <strong>@order.TransportType.NameTransportType</strong>
                            </div>
                        </div>

                        @* @if (order.UpdatedAt.HasValue)
                        {
                            <div class="detail-item">
                                <small class="text-muted d-block">Последнее обновление</small>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-sync text-muted me-2"></i>
                                    <span>@order.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                            </div>
                        } *@
                    </div>
                </div>

                <!-- Оплата -->
                <div class="col-lg-6">
                    <div class="info-section">
                        <div class="d-flex align-items-center mb-3">
                            <div class="icon-circle bg-success me-3">
                                <i class="fas fa-credit-card text-white"></i>
                            </div>
                            <h4 class="fw-bold text-dark mb-0">Информация об оплате</h4>
                        </div>

                        @if (payment != null && payment.PaymentDate != null)
                        {
                            <!-- Если платеж оплачен -->
                            <div class="detail-item">
                                <small class="text-muted d-block">Метод оплаты</small>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-wallet text-muted me-2"></i>
                                    <strong>@payment.PaymentMethod?.MethodName</strong>
                                </div>
                            </div>

                            <div class="detail-item">
                                <small class="text-muted d-block">Сумма оплаты</small>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-money-bill-wave text-muted me-2"></i>
                                    <strong class="h5 text-success mb-0">@payment.Amount ₸</strong>
                                </div>
                            </div>

                            <div class="detail-item">
                                <small class="text-muted d-block">Дата оплаты</small>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-calendar-check text-muted me-2"></i>
                                    <span>@payment.PaymentDate?.ToString("dd.MM.yyyy HH:mm")</span>
                                </div>
                            </div>

                            <div class="mt-3 p-3 bg-success bg-opacity-10 rounded">
                                <small class="text-muted d-block mb-1">Статус оплаты</small>
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle me-1"></i>Оплачено
                                </span>
                            </div>
                        }
                        else
                        {
                            <!-- Если платежа нет или он не оплачен -->
                            <div class="text-center py-4">
                                <i class="fas fa-money-bill-wave fa-3x text-muted mb-3"></i>
                                <h6 class="text-muted">Платёжная информация отсутствует</h6>
                                <small class="text-muted">Перейдите к оплате заказа</small>

                                <div class="d-grid gap-2 mt-3">
                                    <NavLink href="@($"/orders/payment-edit/{order.OrdersId}")" class="btn btn-warning">
                                        <i class="fas fa-plus me-2"></i>Создать платёж
                                    </NavLink>
                                </div>
                            </div>
                        }
                    </div>
                </div>


            </div>
        }
    </div>
</div>
@code {
    [Parameter] public int OrdersId { get; set; }
    private Order? order { get; set; }
    protected Payment payment;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrder();
    }

    private async Task LoadOrder()
    {
        order = await context.Orders
            .Include(o => o.Clients)
                .ThenInclude(c => c.IndividualClients)
            .Include(o => o.Clients)
                .ThenInclude(c => c.CompanyClients)
            .Include(o => o.OriginTown)
            .Include(o => o.DestinationTown)
            .Include(o => o.DeliveryType)
            .Include(o => o.TransportType)
            .Include(o => o.Template)
            .Include(o => o.PickupBranches)
            .Include(o => o.Payments)
                .ThenInclude(p => p.PaymentMethod)
            .FirstOrDefaultAsync(o => o.OrdersId == OrdersId);

        
    }
}

