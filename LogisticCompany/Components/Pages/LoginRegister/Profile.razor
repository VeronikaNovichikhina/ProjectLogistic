                                                    {
                                                        <span title="@order.DescriptionParcel">
                                                            @(order.DescriptionParcel.Length > 50 ? order.DescriptionParcel[..50] + "…" : order.DescriptionParcel)
                                                        </span>
                                                    }
                                                    else { <span class="text-muted">Без описания</span> }
                                                </td>
                                                <td>
                                                    @if (order.Template != null) { <span>@order.Template.TemplateName</span> }
                                                    @if (order.LengthCm > 0 && order.WidthCm > 0 && order.HeightCm > 0)
                                                    { <div class="pkg-dim">@order.LengthCm × @order.WidthCm × @order.HeightCm см</div> }
                                                </td>
                                                <td>
                                                    @if (order.Weight != null && order.Weight > 0) { <span>@order.Weight кг</span> }
                                                    else { <span class="text-muted">—</span> }
                                                </td>
                                                <td style="text-align: right;">
                                                    <button class="view-btn" type="button" @onclick="() => ShowOrderDetails(order.OrdersId)">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                            <circle cx="12" cy="12" r="3"/>
                                                        </svg>
                                                        Подробнее
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="lc-card">
                            <div class="lc-card-body empty-state">
                                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                                     style="color: #C8BFB0; margin-bottom: .75rem;" aria-hidden="true">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                </svg>
                                <div class="empty-title">У вас пока нет посылок</div>
                                <div class="empty-sub">Все ваши заказы будут отображаться здесь</div>
                                <NavLink href="/create/order/for/user" class="save-btn" style="margin-top: .75rem;">Создать заказ</NavLink>
                            </div>
                        </div>
                    }
                </div>

                <!-- НАСТРОЙКИ -->
                <div class="tab-pane fade" id="settings" role="tabpanel">
                    <div class="settings-grid">

                        <!-- Уведомления -->
                        <div class="lc-card">
                            <div class="lc-card-hd">
                                <div class="lc-card-title">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                         style="color: #D98E10;" aria-hidden="true">
                                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                                    </svg>
                                    Уведомления
                                </div>
                            </div>
                            <div class="lc-card-body">
                                <div class="toggle-row">
                                    <div>
                                        <div class="toggle-lbl">Email уведомления</div>
                                        <div class="toggle-sub">Получать на почту</div>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" checked />
                                        <span class="toggle-track"></span>
                                    </label>
                                </div>
                                <div class="toggle-row">
                                    <div>
                                        <div class="toggle-lbl">SMS уведомления</div>
                                        <div class="toggle-sub">Получать на телефон</div>
                                    </div>
                                    <label class="toggle-switch">
                                        <input type="checkbox" />
                                        <span class="toggle-track"></span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Безопасность / смена пароля -->
                        <div class="lc-card">
                            <div class="lc-card-hd">
                                <div class="lc-card-title">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                         style="color: #1C3A5E;" aria-hidden="true">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                                    </svg>
                                    Безопасность
                                </div>
                            </div>
                            <div class="lc-card-body">
                                <EditForm Model="changePasswordModel" OnValidSubmit="ChangePassword" FormName="changePassword">
                                    <DataAnnotationsValidator />

                                    <div class="field" style="margin-bottom: .75rem;">
                                        <span class="field-lbl">Текущий пароль</span>
                                        <div class="pw-wrap">
                                            <InputText type="@(showCurrentPassword ? "text" : "password")"
                                                       class="lc-inp"
                                                       @bind-Value="changePasswordModel.CurrentPassword"
                                                       placeholder="Введите текущий пароль" />
                                            <button type="button" class="pw-toggle"
                                                    @onclick="() => showCurrentPassword = !showCurrentPassword"
                                                    aria-label="Показать пароль">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    @if (showCurrentPassword)
                                                    {
                                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                                                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                                                        <line x1="1" y1="1" x2="23" y2="23"/>
                                                    }
                                                    else
                                                    {
                                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                        <circle cx="12" cy="12" r="3"/>
                                                    }
                                                </svg>
                                            </button>
                                        </div>
                                        <ValidationMessage For="() => changePasswordModel.CurrentPassword" class="lc-validation-msg" />
                                    </div>

                                    <div class="field" style="margin-bottom: .75rem;">
                                        <span class="field-lbl">Новый пароль</span>
                                        <div class="pw-wrap">
                                            <InputText type="@(showNewPassword ? "text" : "password")"
                                                       class="lc-inp"
                                                       @bind-Value="changePasswordModel.NewPassword"
                                                       placeholder="Введите новый пароль" />
                                            <button type="button" class="pw-toggle"
                                                    @onclick="() => showNewPassword = !showNewPassword"
                                                    aria-label="Показать пароль">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                    <circle cx="12" cy="12" r="3"/>
                                                </svg>
                                            </button>
                                        </div>
                                        <ValidationMessage For="() => changePasswordModel.NewPassword" class="lc-validation-msg" />
                                    </div>

                                    <div class="field" style="margin-bottom: .75rem;">
                                        <span class="field-lbl">Подтвердите новый пароль</span>
                                        <div class="pw-wrap">
                                            <InputText type="@(showConfirmPassword ? "text" : "password")"
                                                       class="lc-inp"
                                                       @bind-Value="changePasswordModel.ConfirmPassword"
                                                       placeholder="Повторите новый пароль" />
                                            <button type="button" class="pw-toggle"
                                                    @onclick="() => showConfirmPassword = !showConfirmPassword"
                                                    aria-label="Показать пароль">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                    <circle cx="12" cy="12" r="3"/>
                                                </svg>
                                            </button>
                                        </div>
                                        <ValidationMessage For="() => changePasswordModel.ConfirmPassword" class="lc-validation-msg" />
                                    </div>

                                    @if (!string.IsNullOrEmpty(passwordChangeMessage))
                                    {
                                        <div class="lc-alert @(isPasswordChangeSuccess ? "lc-alert-success" : "lc-alert-danger")" style="margin-bottom: .75rem;">
                                            <span>@passwordChangeMessage</span>
                                        </div>
                                    }

                                    <button type="submit" class="save-btn" style="width: 100%; justify-content: center;" disabled="@isChangingPassword">
                                        @if (isChangingPassword)
                                        {
                                            <span class="lc-spinner" role="status"></span>
                                            <span>Меняем пароль...</span>
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                                            </svg>
                                            <span>Сменить пароль</span>
                                        }
                                    </button>
                                </EditForm>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </main>
    </div>
</div>



@if (showOrderDetailsModal && selectedOrder != null)
{
    <div class="modal-overlay">
        <div class="modal-box">

            <!-- Заголовок -->
            <div class="modal-hd">
                <div class="modal-hd-ico" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    </svg>
                </div>
                <div>
                    <div class="modal-hd-title">Детали заказа #@selectedOrder.OrderNumber</div>
                    <div class="modal-hd-sub">Полная информация о посылке</div>
                </div>
                <button class="modal-close" @onclick="CloseOrderDetails" aria-label="Закрыть">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>

            <!-- Тело -->
            <div class="modal-body">

                <div class="info-grid">

                    <!-- Получатель -->
                    <div class="ic">
                        <div class="ic-hd">
                            <div class="ic-hd-ico ico-blue" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                            <span class="ic-hd-title">Получатель</span>
                        </div>
                        <div class="ic-body">
                            <div class="ii">
                                <span class="ii-lbl">Фамилия</span>
                                <span class="ii-val">@selectedOrder.LastRecepientName</span>
                            </div>
                            <div class="ii">
                                <span class="ii-lbl">Имя</span>
                                <span class="ii-val">@selectedOrder.FirstRecepientName</span>
                            </div>
                            <div class="ii">
                                <span class="ii-lbl">Отчество</span>
                                <span class="ii-val">@(string.IsNullOrEmpty(selectedOrder.MiddleRecepientName) ? "—" : selectedOrder.MiddleRecepientName)</span>
                            </div>
                            <div class="ii">
                                <span class="ii-lbl">Телефон</span>
                                <span class="ii-val">@selectedOrder.PhoneRecepient</span>
                            </div>
                        </div>
                    </div>

                    <!-- Посылка -->
                    <div class="ic">
                        <div class="ic-hd">
                            <div class="ic-hd-ico ico-orange" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                                </svg>
                            </div>
                            <span class="ic-hd-title">Посылка</span>
                        </div>
                        <div class="ic-body">
                            <div class="ii">
                                <span class="ii-lbl">Описание</span>
                                <span class="ii-val">@(string.IsNullOrEmpty(selectedOrder.DescriptionParcel) ? "Не указано" : selectedOrder.DescriptionParcel)</span>
                            </div>
                            @if (selectedOrder.Template != null)
                            {
                                <div class="ii">
                                    <span class="ii-lbl">Шаблон</span>
                                    <span class="ii-val">@selectedOrder.Template.TemplateName</span>
                                </div>
                            }
                            @if (selectedOrder.LengthCm > 0 && selectedOrder.WidthCm > 0 && selectedOrder.HeightCm > 0)
                            {
                                <div class="ii">
                                    <span class="ii-lbl">Размеры (Д×Ш×В)</span>
                                    <span class="ii-val">@selectedOrder.LengthCm × @selectedOrder.WidthCm × @selectedOrder.HeightCm см</span>
                                </div>
                            }
                            @if (selectedOrder.Weight != null && selectedOrder.Weight > 0)
                            {
                                <div class="ii">
                                    <span class="ii-lbl">Вес</span>
                                    <span class="ii-val">@selectedOrder.Weight кг</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Доставка -->
                    <div class="ic">
                        <div class="ic-hd">
                            <div class="ic-hd-ico ico-blue" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/>
                                    <rect x="9" y="11" width="14" height="10" rx="2"/>
                                    <circle cx="12" cy="21" r="1"/>
                                    <circle cx="20" cy="21" r="1"/>
                                </svg>
                            </div>
                            <span class="ic-hd-title">Доставка</span>
                        </div>
                        <div class="ic-body">
                            <div class="ii">
                                <span class="ii-lbl">Тип доставки</span>
                                <span class="ii-val">@(selectedOrder.DeliveryType?.NameDeliveryType ?? "—")</span>
                            </div>
                            <div class="ii">
                                <span class="ii-lbl">Транспорт</span>
                                <span class="ii-val">@(selectedOrder.TransportType?.NameTransportType ?? "—")</span>
                            </div>
                            <div class="ii">
                                <span class="ii-lbl">Откуда</span>
                                <span class="ii-val">@selectedOrder.OriginTown?.TownName, @selectedOrder.OriginTown?.Country?.CountryName</span>
                            </div>
                            <div class="ii">
                                <span class="ii-lbl">Куда</span>
                                <span class="ii-val">@selectedOrder.DestinationTown?.TownName, @selectedOrder.DestinationTown?.Country?.CountryName</span>
                            </div>
                        </div>
                    </div>

                    <!-- Дополнительно -->
                    <div class="ic">
                        <div class="ic-hd">
                            <div class="ic-hd-ico ico-gray" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="12" y1="8" x2="12" y2="12"/>
                                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                                </svg>
                            </div>
                            <span class="ic-hd-title">Дополнительно</span>
                        </div>
                        <div class="ic-body">
                            <div class="ii">
                                <span class="ii-lbl">Филиал забора</span>
                                <span class="ii-val">@(selectedOrder.PickupBranches?.NameBranches ?? "—")</span>
                            </div>
                            <div class="ii">
                                <span class="ii-lbl">Текущий статус</span>
                                @if (selectedOrder?.Trackings?.Any() == true)
                                {
                                    var latest = selectedOrder.Trackings.OrderByDescending(t => t.UpdateDate).FirstOrDefault();
                                    @if (latest?.Status != null)
                                    {
                                        <span class="od-pill"><span class="od-pill-dot"></span>@latest.Status.StatusName</span>
                                        <span class="ii-date">@latest.UpdateDate.ToString("dd.MM.yyyy HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="ii-val-muted">Статус не указан</span>
                                    }
                                }
                                else
                                {
                                    <span class="ii-val-muted">Нет данных</span>
                                }
                            </div>
                            <div class="ii">
                                <span class="ii-lbl">Дата создания</span>
                                @if (selectedOrder?.Trackings?.Any() == true)
                                {
                                    var first = selectedOrder.Trackings.OrderBy(t => t.UpdateDate).FirstOrDefault();
                                    <span class="ii-val">@first?.UpdateDate.ToString("dd.MM.yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="ii-val-muted">—</span>
                                }
                            </div>
                        </div>
                    </div>

                </div>

                <!-- История перемещений -->
                @if (selectedOrder?.Trackings?.Any() == true)
                {
                    <div class="ic">
                        <div class="ic-hd">
                            <div class="ic-hd-ico ico-blue" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="12 8 12 12 14 14"/>
                                    <path d="M3.05 11a9 9 0 1 1 .5 4m-.5 5v-5h5"/>
                                </svg>
                            </div>
                            <span class="ic-hd-title">История перемещений</span>
                        </div>
                        <div class="ic-body">
                            <div class="od-timeline">
                                @foreach (var tracking in selectedOrder.Trackings.OrderByDescending(t => t.UpdateDate))
                                {
                                    <div class="od-tl-item">
                                        <div class="od-tl-dot od-tl-done"></div>
                                        <div class="od-tl-content">
                                            <div class="od-tl-row">
                                                <span class="od-tl-status">@tracking.Status.StatusName</span>
                                                <span class="od-tl-date">@tracking.UpdateDate.ToString("dd.MM.yyyy HH:mm")</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(tracking.LocationTrackings))
                                            {
                                                <div class="od-tl-meta">@tracking.LocationTrackings</div>
                                            }
                                            @if (tracking.Branches != null)
                                            {
                                                <div class="od-tl-branch">Филиал: @tracking.Branches.NameBranches</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

            </div>

            <!-- Футер -->
            <div class="modal-ft">
                <button class="od-close-btn" @onclick="CloseOrderDetails">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                    Закрыть
                </button>
            </div>

        </div>
    </div>
}



@code {
    [SupplyParameterFromForm]
    private Client client { get; set; } = new();
    private IndividualClient individualClient { get; set; } = new();
    private CompanyClient companyClient { get; set; } = new();
    private List<Client> clients = new List<Client>();
    private List<Order> orders = new List<Order>();
    private Order selectedOrder = null;
    private List<StatusDelivery> statusDelivery = new();

    [Inject]
    private IJSRuntime JS { get; set; }

    private ElementReference phoneInput;
    private int selectedClientTypeId;

    private ChangePasswordModel changePasswordModel = new();
    private bool showCurrentPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;
    private string passwordChangeMessage = "";
    private bool isPasswordChangeSuccess = false;
    private bool isChangingPassword = false;
    private bool showOrderDetailsModal = false;

    private User currentUser;
    private Employee adminEmployee;
    private Branch adminBranch;
    private Town adminTown;
    private Country adminCountry;
    private bool isManager = false;
    private string adminEmail => currentUser?.Email ?? "";

    private bool isSaving = false;
    private string saveMessage = "";
    private bool isSaveSuccess = false;

    private bool showPasswordChangeDialog = false;
    private bool isFirstLogin = false;
    private bool isTempPassword = false;

    protected override async Task OnInitializedAsync()
    {
        var email = GetCurrentUserEmail();
        if (string.IsNullOrEmpty(email)) return;

        // Проверка временного пароля
        isTempPassword = await UserService.IsTemporaryPasswordAsync(email);
        showPasswordChangeDialog = isTempPassword;



        adminEmployee = await EmployeeService.GetEmployeeWithBranchAsync(email);
        if (adminEmployee != null)
        {
            isManager = true;
            orders = await OrderService.GetOrdersForAdminAsync(adminEmployee.Branch.BranchesId);
        }
        else
        {
            isManager = false;
            client = await ClientService.GetClientByEmailAsync(email) ?? new Client { Email = email };
            selectedClientTypeId = client.ClientTypeId;
            if (client.ClientTypeId == 1)
                individualClient = client.IndividualClients.FirstOrDefault() ?? new IndividualClient();
            else if (client.ClientTypeId == 2)
                companyClient = client.CompanyClients.FirstOrDefault() ?? new CompanyClient();

            orders = await OrderService.GetOrdersForClientAsync(client.ClientsId);
        }
        statusDelivery = await OrderService.GetStatusDeliveriesAsync();
    }


    private string? GetCurrentUserEmail()
    {
        return HttpContextAccessor.HttpContext?.User?.Identity?.Name;
    }

    private async Task CheckFirstLogin()
    {
        try
        {
            var email = GetCurrentUserEmail();
            if (string.IsNullOrEmpty(email)) return;

               var cookieVal = await JS.InvokeAsync<string>("eval",
                "document.cookie.replace(/(?:(?:^|.*;\\s*)userPasswordChanged\\s*\\=\\s*([^;]*).*$)|^.*$/, '$1')");
            bool hasChangedPassword = !string.IsNullOrEmpty(cookieVal) && cookieVal != "dismissed"; 
            isTempPassword = await UserService.IsTemporaryPasswordAsync(email);

            showPasswordChangeDialog = isTempPassword && !hasChangedPassword;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка при проверке первого входа: {ex.Message}");
        }
    }

    private async Task ChangePassword()
    {
        try
        {
            var email = client.Email;
            await UserService.ChangePasswordAsync(email, changePasswordModel.CurrentPassword, changePasswordModel.NewPassword);
            showPasswordChangeDialog = false;
            await JS.InvokeVoidAsync("alert", "Пароль успешно изменен");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", ex.Message);
        }
    }

    private async Task DismissPasswordChange()
    {
        var userEmail = HttpContextAccessor.HttpContext?.User?.Identity?.Name;

        if (!string.IsNullOrEmpty(userEmail))
        {
            await JS.InvokeVoidAsync("eval",
                $"document.cookie = 'userPasswordChanged=dismissed; max-age=31536000; path=/'");
        }

        showPasswordChangeDialog = false;
        StateHasChanged();
    }


    private async Task ShowOrderDetails(int orderId)
    {
        selectedOrder = await OrderService.GetOrderDetailsAsync(orderId);
        if (selectedOrder != null) showOrderDetailsModal = true;
    }

    private void CloseOrderDetails()
    {
        showOrderDetailsModal = false;
        selectedOrder = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("applyPhoneMask", phoneInput);
        }
    }

    private async Task SaveClient()
    {
        try
        {
            await ClientService.SaveClientAsync(client, individualClient, companyClient);
            await JS.InvokeVoidAsync("alert", "Данные успешно сохранены!");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Ошибка при сохранении: {ex.Message}");
        }
    }

    private async Task Logout()
    {
        Navigation.NavigateTo("/logout", forceLoad: true);
    }

    private async Task SaveEmployee()
    {
        isSaving = true;
        saveMessage = "";
        StateHasChanged();

        try
        {
            adminEmployee = await EmployeeService.SaveEmployeeAsync(adminEmployee);
            saveMessage = "Данные успешно сохранены!";
            isSaveSuccess = true;

            _ = HideMessageAfterDelay();
        }
        catch (ArgumentException ex)
        {
            saveMessage = ex.Message;
            isSaveSuccess = false;
        }
        catch (Exception ex)
        {
            saveMessage = $"Ошибка при сохранении: {ex.Message}";
            isSaveSuccess = false;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task HideMessageAfterDelay()
    {
        await Task.Delay(5000);
        saveMessage = "";
        StateHasChanged();
    }
    

}



