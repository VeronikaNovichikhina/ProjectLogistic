@page "/profile"
@using LogisticCompany.Application.Interfaces
@using LogisticCompany.Application.model
@using LogisticCompany.Domain.Entities.Employee
@using LogisticCompany.Domain.Entities.Location

@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation

@rendermode InteractiveServer
@inject IClientService ClientService
@inject IUserService UserService
@inject IAuthService AuthService
@inject IOrderService OrderService
@inject IEmployeeService EmployeeService


@if (showPasswordChangeDialog)
{
    <div class="modal-overlay">
        <div class="modal-box">
            <div class="modal-hd">
                <div class="modal-hd-ico" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                </div>
                <div>
                    <div class="modal-title">Требуется смена пароля</div>
                    <div class="modal-sub">Установите постоянный пароль для безопасности</div>
                </div>
            </div>
            <div class="modal-body">
                <div class="modal-info">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         style="flex-shrink:0;margin-top:1px" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span>Вы вошли с временным паролем. Установите постоянный пароль для защиты аккаунта.</span>
                </div>
                <div class="req-list">
                    <div class="req-item">
                        <span class="req-check">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </span>
                        Минимум 8 символов
                    </div>
                    <div class="req-item">
                        <span class="req-check">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </span>
                        Как минимум одна цифра
                    </div>
                    <div class="req-item">
                        <span class="req-check">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </span>
                        Как минимум одна заглавная буква
                    </div>
                    <div class="req-item">
                        <span class="req-check">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </span>
                        Как минимум один специальный символ
                    </div>
                </div>
                <div class="modal-ft">
                    <button class="dismiss-btn" @onclick="DismissPasswordChange">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                        Больше не показывать
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="profile-page">

    <!-- Декоративная полоска -->
    <div class="lc-stripe"><div class="lc-stripe-inner"></div></div>

    <div class="profile-layout">

        <!-- ── Сайдбар ──────────────────────────────────────── -->
        <aside class="sidebar">
            <div class="sb-head">
                <div class="sb-avatar-row">
                    <div class="sb-avatar @(isManager ? "sb-avatar-manager" : "sb-avatar-client")" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <div>
                        <div class="sb-name">@(isManager ? "Кабинет сотрудника" : "Личный кабинет")</div>
                        @if (isManager && adminEmployee != null)
                        {
                            <div class="sb-email">@adminEmployee.Email</div>
                            <div class="sb-role">@adminEmployee.FirstName @adminEmployee.LastName</div>
                        }
                    </div>
                </div>
            </div>

            <nav class="sb-nav" role="tablist">
                <button class="sb-nav-item active" id="tab-main" data-bs-toggle="tab" data-bs-target="#main" type="button" role="tab">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                    <span>Главная</span>
                </button>

                <button class="sb-nav-item" id="tab-data" data-bs-toggle="tab" data-bs-target="#data" type="button" role="tab">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                        <line x1="19" y1="8" x2="19" y2="14"/>
                        <line x1="22" y1="11" x2="16" y2="11"/>
                    </svg>
                    <span>Личные данные</span>
                </button>

                @if (!isManager)
                {
                    <button class="sb-nav-item" id="tab-packages" data-bs-toggle="tab" data-bs-target="#packages" type="button" role="tab">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                        </svg>
                        <span>Мои посылки</span>
                        @if (orders?.Any() == true)
                        {
                            <span class="sb-badge">@orders.Count</span>
                        }
                    </button>
                }

                <button class="sb-nav-item" id="tab-settings" data-bs-toggle="tab" data-bs-target="#settings" type="button" role="tab">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                    <span>Настройки</span>
                </button>
            </nav>

            <div class="sb-foot">
                <button class="sb-logout" @onclick="Logout">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <polyline points="16 17 21 12 16 7"/>
                        <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    Выйти
                </button>
            </div>
        </aside>

        <!-- ── Контент ───────────────────────────────────────── -->
        <main class="profile-content">
            <div class="tab-content">

                <!-- ГЛАВНАЯ -->
                <div class="tab-pane fade show active" id="main" role="tabpanel">
                    <div class="welcome-card">
                        <div>
                            <div class="wc-title">Добро пожаловать!</div>
                            <div class="wc-sub">Рады видеть вас в личном кабинете Logistic Company</div>
                        </div>
                        <div class="wc-ico" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/>
                                <rect x="9" y="11" width="14" height="10" rx="2"/>
                                <circle cx="12" cy="21" r="1"/>
                                <circle cx="20" cy="21" r="1"/>
                            </svg>
                        </div>
                    </div>

                    <div class="sec-lbl">Быстрые действия</div>
                    <div class="action-grid">
                        @if (!isManager)
                        {
                            <NavLink href="/create-order" class="action-card">
                                <div class="action-ico ico-blue" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"/>
                                        <line x1="12" y1="8" x2="12" y2="16"/>
                                        <line x1="8" y1="12" x2="16" y2="12"/>
                                    </svg>
                                </div>
                                <div class="action-title">Создать заказ</div>
                                <div class="action-sub">Новая отправка</div>
                            </NavLink>
                            <div class="action-card">
                                <div class="action-ico ico-orange" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 16.92V19a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3 5.18 2 2 0 0 1 5 3h2.09a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 10.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z"/>
                                    </svg>
                                </div>
                                <div class="action-title">Помощь</div>
                                <div class="action-sub">Поддержка 24/7</div>
                            </div>
                        }
                        else
                        {
                            <NavLink href="/admin-home" class="action-card">
                                <div class="action-ico ico-blue" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="3" width="7" height="7"/>
                                        <rect x="14" y="3" width="7" height="7"/>
                                        <rect x="14" y="14" width="7" height="7"/>
                                        <rect x="3" y="14" width="7" height="7"/>
                                    </svg>
                                </div>
                                <div class="action-title">Перейти к управлению</div>
                                <div class="action-sub">Панель администратора</div>
                            </NavLink>
                        }
                    </div>
                </div>

                <!-- ЛИЧНЫЕ ДАННЫЕ -->
                <div class="tab-pane fade" id="data" role="tabpanel">
                    <EditForm Model="@(isManager ? adminEmployee : client)" OnValidSubmit="@(isManager ? SaveEmployee : SaveClient)" FormName="profile">
                        <DataAnnotationsValidator />

                        @if (!string.IsNullOrEmpty(saveMessage))
                        {
                            <div class="lc-alert @(isSaveSuccess ? "lc-alert-success" : "lc-alert-danger")">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    @if (isSaveSuccess) { <polyline points="20 6 9 17 4 12"/> }
                                    else { <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/> }
                                </svg>
                                <span>@saveMessage</span>
                            </div>
                        }

                        <div class="lc-card">
                            <div class="lc-card-hd">
                                <div class="lc-card-title">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                    </svg>
                                    @(isManager ? "Данные сотрудника" : "Личные данные")
                                </div>
                                <span class="@(isManager ? "lc-badge-blue" : "lc-badge-orange")">
                                    @(isManager ? "Сотрудник" : "Клиент")
                                </span>
                            </div>
                            <div class="lc-card-body">
                                <div class="form-row-2">
                                    <div>
                                        <span class="field-lbl">Email</span>
                                        <div class="inp-wrap">
                                            <div class="inp-ico" aria-hidden="true">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                                    <polyline points="22,6 12,13 2,6"/>
                                                </svg>
                                            </div>
                                            <input class="lc-inp" value="@(isManager ? adminEmployee?.Email : client?.Email)" disabled />
                                        </div>
                                    </div>
                                    <div>
                                        <span class="field-lbl">Телефон *</span>
                                        <div class="inp-wrap">
                                            <div class="inp-ico" aria-hidden="true">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M22 16.92V19a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3 5.18 2 2 0 0 1 5 3h2.09a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 10.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17z"/>
                                                </svg>
                                            </div>
                                            @if (isManager)
                                            {
                                                <InputText class="lc-inp" @bind-Value="adminEmployee.Phone" />
                                            }
                                            else
                                            {
                                                <input @bind="client.Phone" @ref="phoneInput" class="lc-inp" />
                                            }
                                        </div>
                                        @if (isManager)
                                        { <ValidationMessage For="() => adminEmployee.Phone" class="lc-validation-msg" /> }
                                        else
                                        { <ValidationMessage For="() => client.Phone" class="lc-validation-msg" /> }
                                    </div>
                                </div>

                                @if (isManager)
                                {
                                    <div class="form-row-3">
                                        <div>
                                            <span class="field-lbl">Фамилия *</span>
                                            <div class="inp-wrap"><InputText class="lc-inp" @bind-Value="adminEmployee.LastName" /></div>
                                            <ValidationMessage For="() => adminEmployee.LastName" class="lc-validation-msg" />
                                        </div>
                                        <div>
                                            <span class="field-lbl">Имя *</span>
                                            <div class="inp-wrap"><InputText class="lc-inp" @bind-Value="adminEmployee.FirstName" /></div>
                                            <ValidationMessage For="() => adminEmployee.FirstName" class="lc-validation-msg" />
                                        </div>
                                        <div>
                                            <span class="field-lbl">Отчество</span>
                                            <div class="inp-wrap"><InputText class="lc-inp" @bind-Value="adminEmployee.PatronymicName" /></div>
                                        </div>
                                    </div>
                                    <div class="form-row-2">
                                        <div>
                                            <span class="field-lbl">Должность</span>
                                            <div class="inp-wrap"><InputText class="lc-inp" @bind-Value="adminEmployee.Position" Disabled="true" /></div>
                                            <div class="field-hint">Для изменения обратитесь к администратору</div>
                                        </div>
                                        <div>
                                            <span class="field-lbl">Филиал</span>
                                            <div class="inp-wrap"><InputText class="lc-inp" @bind-Value="adminEmployee.Branch.NameBranches" Disabled="true" /></div>
                                            <div class="field-hint">Филиал назначается администратором</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div style="margin-bottom: .85rem;">
                                        <span class="field-lbl">Тип клиента *</span>
                                        <InputRadioGroup @bind-Value="selectedClientTypeId">
                                            <div class="client-type-row">
                                                <label class="client-type-opt @(selectedClientTypeId == 1 ? "selected" : "")">
                                                    <InputRadio Value="1" />
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                                        <circle cx="12" cy="7" r="4"/>
                                                    </svg>
                                                    Физическое лицо
                                                </label>
                                                <label class="client-type-opt @(selectedClientTypeId == 2 ? "selected" : "")">
                                                    <InputRadio Value="2" />
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                                                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                                                    </svg>
                                                    Компания
                                                </label>
                                            </div>
                                        </InputRadioGroup>
                                    </div>

                                    @if (selectedClientTypeId == 1)
                                    {
                                        <div class="form-row-3">
                                            <div>
                                                <span class="field-lbl">Фамилия *</span>
                                                <div class="inp-wrap"><InputText class="lc-inp" @bind-Value="individualClient.LastName" /></div>
                                                <ValidationMessage For="() => individualClient.LastName" class="lc-validation-msg" />
                                            </div>
                                            <div>
                                                <span class="field-lbl">Имя *</span>
                                                <div class="inp-wrap"><InputText class="lc-inp" @bind-Value="individualClient.FirstName" /></div>
                                                <ValidationMessage For="() => individualClient.FirstName" class="lc-validation-msg" />
                                            </div>
                                            <div>
                                                <span class="field-lbl">Отчество</span>
                                                <div class="inp-wrap"><InputText class="lc-inp" @bind-Value="individualClient.PatronymicName" /></div>
                                            </div>
                                        </div>
                                        <div class="form-row-2">
                                            <div>
                                                <span class="field-lbl">Паспорт *</span>
                                                <div class="inp-wrap"><InputText class="lc-inp" @bind-Value="individualClient.PassportNumber" /></div>
                                                <ValidationMessage For="() => individualClient.PassportNumber" class="lc-validation-msg" />
                                            </div>
                                            <div>
                                                <span class="field-lbl">Дата выдачи паспорта *</span>
                                                <div class="inp-wrap"><InputDate class="lc-inp" @bind-Value="individualClient.PassportDateOfIssue" /></div>
                                                <ValidationMessage For="() => individualClient.PassportDateOfIssue" class="lc-validation-msg" />
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-row-2">
                                            <div>
                                                <span class="field-lbl">Название компании *</span>
                                                <div class="inp-wrap"><InputText class="lc-inp" @bind-Value="companyClient.CompanyName" /></div>
                                                <ValidationMessage For="() => companyClient.CompanyName" class="lc-validation-msg" />
                                            </div>
                                            <div>
                                                <span class="field-lbl">ИИН *</span>
                                                <div class="inp-wrap"><InputText class="lc-inp" @bind-Value="companyClient.Inn" /></div>
                                                <ValidationMessage For="() => companyClient.Inn" class="lc-validation-msg" />
                                            </div>
                                        </div>
                                    }
                                }

                                <div class="form-actions">
                                    <button type="submit" class="save-btn">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                            <polyline points="17 21 17 13 7 13 7 21"/>
                                            <polyline points="7 3 7 8 15 8"/>
                                        </svg>
                                        Сохранить изменения
                                    </button>
                                </div>
                            </div>
                        </div>
                    </EditForm>
                </div>

                <!-- ПОСЫЛКИ -->
                <div class="tab-pane fade" id="packages" role="tabpanel">
                    @if (orders?.Any() == true)
                    {
                        <div class="lc-card">
                            <div class="lc-card-hd">
                                <div class="lc-card-title">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                    </svg>
                                    Мои посылки
                                </div>
                                <NavLink href="/create/order/for/user" class="save-btn" style="font-size: 12px; padding: 6px 14px;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"/>
                                        <line x1="12" y1="8" x2="12" y2="16"/>
                                        <line x1="8" y1="12" x2="16" y2="12"/>
                                    </svg>
                                    Создать заказ
                                </NavLink>
                            </div>
                            <div class="lc-card-body" style="padding: 0;">
                                <table class="pkg-table">
                                    <thead>
                                        <tr>
                                            <th>№ Заказа</th>
                                            <th>Описание</th>
                                            <th>Размеры</th>
                                            <th>Вес</th>
                                            <th style="text-align: right;">Действия</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in orders)
                                        {
                                            <tr>
                                                <td><span class="order-num">#@order.OrderNumber</span></td>
                                                <td>
