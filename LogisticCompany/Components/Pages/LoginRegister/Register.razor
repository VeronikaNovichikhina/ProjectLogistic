@page "/register"
@using LogisticCompany.Application.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@using LogisticCompany.Application.model
@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject IAuthService AuthService


<div class="register-page">

    <!-- Декоративная полоска -->
    <div class="lc-stripe">
        <div class="lc-stripe-inner"></div>
    </div>

    <div class="register-grid">

        <!-- Левая панель — брендинг -->
        <div class="register-left">
            <div class="register-left-inner">

                <div class="brand-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/>
                        <rect x="9" y="11" width="14" height="10" rx="2"/>
                        <circle cx="12" cy="21" r="1"/>
                        <circle cx="20" cy="21" r="1"/>
                    </svg>
                </div>
                <div class="brand-name">Logistic Company</div>
                <div class="brand-sub">Станьте частью нашей логистической сети</div>

                <div class="feat-list">

                    <div class="feat-item">
                        <div class="feat-ico" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                <path d="M2 17l10 5 10-5"/>
                                <path d="M2 12l10 5 10-5"/>
                            </svg>
                        </div>
                        <div>
                            <div class="feat-title">Мгновенная регистрация</div>
                            <div class="feat-desc">Всего 2 минуты для начала работы</div>
                        </div>
                    </div>

                    <div class="feat-item">
                        <div class="feat-ico" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="feat-title">Максимальная безопасность</div>
                            <div class="feat-desc">Ваши данные под надёжной защитой</div>
                        </div>
                    </div>

                    <div class="feat-item">
                        <div class="feat-ico" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                            </svg>
                        </div>
                        <div>
                            <div class="feat-title">Немедленный доступ</div>
                            <div class="feat-desc">Начните работу сразу после регистрации</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Правая панель — форма -->
        <div class="register-right">
            <div class="form-box">

                <div class="form-top">
                    <div class="form-top-ico" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <line x1="19" y1="8" x2="19" y2="14"/>
                            <line x1="22" y1="11" x2="16" y2="11"/>
                        </svg>
                    </div>
                    <div class="form-title">Создайте аккаунт</div>
                    <div class="form-sub">Присоединяйтесь к нашей платформе</div>
                </div>

                <EditForm Model="userModel" OnValidSubmit="HandleValidSubmit" FormName="register">
                    <DataAnnotationsValidator />

                    <!-- Email -->
                    <div class="field">
                        <span class="field-lbl">Email адрес *</span>
                        <div class="inp-wrap">
                            <div class="inp-ico" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                                    <polyline points="22,6 12,13 2,6"/>
                                </svg>
                            </div>
                            <InputText @bind-Value="userModel.Email"
                                       @bind-Value:event="oninput"
                                       type="email"
                                       class="lc-inp"
                                       placeholder="your.email@example.com" />
                        </div>
                        <ValidationMessage For="@(() => userModel.Email)" class="lc-validation-msg" />
                    </div>

                    <!-- Пароль -->
                    <div class="field">
                        <span class="field-lbl">Пароль *</span>
                        <div class="inp-wrap">
                            <div class="inp-ico" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="10" rx="2"/>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                            </div>
                            <input @bind="userModel.Password"
                                   type="password"
                                   class="lc-inp"
                                   placeholder="Не менее 6 символов"
                                   @oninput="OnPasswordInput" />
                        </div>
                        <ValidationMessage For="() => userModel.Password" class="lc-validation-msg" />

                        <!-- Индикатор силы пароля -->
                        <div class="strength-wrap">
                            <div class="strength-bar">
                                <div class="strength-fill" style="width: @(passwordStrength)%; background: @(passwordStrengthColor)"></div>
                            </div>
                            <div class="strength-hint">
                                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10"/>
                                    <line x1="12" y1="8" x2="12" y2="12"/>
                                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                                </svg>
                                @passwordStrengthHint
                            </div>
                        </div>
                    </div>

                    <!-- Подтверждение пароля -->
                    <div class="field">
                        <span class="field-lbl">Подтверждение пароля *</span>
                        <div class="inp-wrap">
                            <div class="inp-ico" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="10" rx="2"/>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                </svg>
                            </div>
                            <input @bind="userModel.ConfirmPassword"
                                   
                                   type="password"
                                   class="lc-inp"
                                   placeholder="Повторите ваш пароль" />
                        </div>
                        <ValidationMessage For="() => userModel.ConfirmPassword" class="lc-validation-msg" />
                        @if (!string.IsNullOrEmpty(confirmPasswordError))
                        {
                            <div class="lc-validation-msg">@confirmPasswordError</div>
                        }
                    </div>

                    <button type="submit" class="submit-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <line x1="19" y1="8" x2="19" y2="14"/>
                            <line x1="22" y1="11" x2="16" y2="11"/>
                        </svg>
                        Создать аккаунт
                    </button>
                </EditForm>

                <div class="divider"><span>или</span></div>

                <NavLink href="/login" class="login-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    Войти в систему
                </NavLink>

                <div class="sec-box">
                    <span class="sec-ico" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </span>
                    <div>
                        <div class="sec-title">Безопасность данных</div>
                        <div class="sec-list">
                            <span>· Пароли хранятся в зашифрованном виде</span>
                            <span>· Ваши данные защищены и конфиденциальны</span>
                            <span>· Мы не передаём данные третьим лицам</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>



@code {
    
    [SupplyParameterFromForm]
    private RegisterModel userModel{ get; set; } = new RegisterModel();
   
    private string message;
    private string confirmPasswordError = string.Empty;
    private bool showPassword = false;
    private bool showConfirmPassword = false;
    int passwordStrength = 0;
    string passwordStrengthColor = "#F5A623";
    string passwordStrengthHint = "Минимум 6 символов";

    void OnPasswordInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        if (val.Length == 0)      { passwordStrength = 0;   passwordStrengthColor = "#F5A623"; passwordStrengthHint = "Минимум 6 символов"; }
        else if (val.Length < 4)  { passwordStrength = 20;  passwordStrengthColor = "#e53e3e"; passwordStrengthHint = "Слишком короткий"; }
        else if (val.Length < 6)  { passwordStrength = 45;  passwordStrengthColor = "#D98E10"; passwordStrengthHint = "Почти достаточно"; }
        else if (val.Length < 10) { passwordStrength = 70;  passwordStrengthColor = "#1C3A5E"; passwordStrengthHint = "Хороший пароль"; }
        else                      { passwordStrength = 100; passwordStrengthColor = "#2E7D32"; passwordStrengthHint = "Отличный пароль "; }
    }
    
    private void OnConfirmPasswordChanged()
    {
        confirmPasswordError = string.Empty;
        if (!string.IsNullOrEmpty(userModel.Password) && !string.IsNullOrEmpty(userModel.ConfirmPassword) &&
            userModel.Password != userModel.ConfirmPassword)
        {
            confirmPasswordError = "Пароли не совпадают";
        }
    }
    private async Task HandleValidSubmit()
    {
        message = string.Empty;
        confirmPasswordError = string.Empty;

        if (userModel.Password != userModel.ConfirmPassword)
        {
            confirmPasswordError = "Пароли не совпадают";
            return;
        }

        try
        {
            var result = await AuthService.RegisterAsync(
                userModel.Email,
                userModel.Password
            );

            if (!result.Success)
            {
                message = result.ErrorMessage;
                return;
            }

            message = "Регистрация прошла успешно!";
            await Task.Delay(1000);
            Navigation.NavigateTo("/profile");
        }
        catch (Exception ex)
        {
            message = $"Ошибка при регистрации: {ex.Message}";
        }
    }

} 

<style>
  
