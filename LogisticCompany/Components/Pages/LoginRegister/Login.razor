@page "/login"
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@using LogisticCompany.Application.Interfaces
@using LogisticCompany.Application.model
@using Microsoft.AspNetCore.Components.Forms
@inject IAuthService AuthService



<div class="login-page">

    <!-- Декоративная полоска -->
    <div class="lc-stripe">
        <div class="lc-stripe-inner"></div>
    </div>

    <div class="login-grid">

        <!-- Левая панель — брендинг -->
        <div class="login-left">
            <div class="login-left-inner">

                <div class="brand-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3" />
                        <rect x="9" y="11" width="14" height="10" rx="2" />
                        <circle cx="12" cy="21" r="1" />
                        <circle cx="20" cy="21" r="1" />
                    </svg>
                </div>
                <div class="brand-name">Logistic Company</div>
                <div class="brand-sub">Инновационная система управления доставкой</div>

                <div class="feat-list">

                    <div class="feat-item">
                        <div class="feat-ico" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                            </svg>
                        </div>
                        <div>
                            <div class="feat-title">Мгновенное отслеживание</div>
                            <div class="feat-desc">Реальное время положение посылок</div>
                        </div>
                    </div>

                    <div class="feat-item">
                        <div class="feat-ico" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="20" x2="18" y2="10" />
                                <line x1="12" y1="20" x2="12" y2="4" />
                                <line x1="6" y1="20" x2="6" y2="14" />
                            </svg>
                        </div>
                        <div>
                            <div class="feat-title">Аналитика в реальном времени</div>
                            <div class="feat-desc">Полная статистика доставок</div>
                        </div>
                    </div>

                    <div class="feat-item">
                        <div class="feat-ico" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="10" rx="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                <circle cx="12" cy="16" r="1" />
                            </svg>
                        </div>
                        <div>
                            <div class="feat-title">Автоматизация процессов</div>
                            <div class="feat-desc">Умная маршрутизация</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Правая панель — форма -->
        <div class="login-right">
            <div class="form-box">

                <div class="form-top">
                    <div class="form-top-ico" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="10" rx="2" />
                            <path d="M7 11V7a5 5 0 0 1 9.9-1" />
                        </svg>
                    </div>
                    <div class="form-title">С возвращением!</div>
                    <div class="form-sub">Войдите в свою учётную запись</div>
                </div>

                <EditForm Model="loginModel" OnValidSubmit="HandleLogin" FormName="login">
                    <DataAnnotationsValidator />

                    <!-- Email -->
                    <div class="field">
                        <div class="field-label-row">
                            <span class="field-label">Email адрес</span>
                        </div>
                        <div class="inp-wrap">
                            <div class="inp-ico" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                                    <polyline points="22,6 12,13 2,6" />
                                </svg>
                            </div>
                            <InputText @bind-Value="loginModel.Email"
                                       type="email"
                                       class="lc-inp"
                                       placeholder="your.email@example.com" />
                        </div>
                        <ValidationMessage For="() => loginModel.Email" class="lc-validation-msg" />
                    </div>

                    <!-- Пароль -->
                    <div class="field">
                        <div class="field-label-row">
                            <span class="field-label">Пароль</span>
                            <NavLink href="/forgot-password" class="forgot-link">Забыли пароль?</NavLink>
                        </div>
                        <div class="inp-wrap">
                            <div class="inp-ico" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="10" rx="2" />
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                </svg>
                            </div>
                            <InputText @bind-Value="loginModel.Password"
                                       type="password"
                                       class="lc-inp"
                                       placeholder="Введите ваш пароль" />
                        </div>
                        <ValidationMessage For="() => loginModel.Password" class="lc-validation-msg" />
                    </div>

                    <button type="submit" class="submit-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                            <polyline points="10 17 15 12 10 7" />
                            <line x1="15" y1="12" x2="3" y2="12" />
                        </svg>
                        Войти в систему
                    </button>
                </EditForm>

                <div class="divider"><span>или</span></div>

                <NavLink href="/register" class="reg-btn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <line x1="19" y1="8" x2="19" y2="14" />
                        <line x1="22" y1="11" x2="16" y2="11" />
                    </svg>
                    Создать аккаунт
                </NavLink>

                <div class="sec-note">
                    <span class="sec-ico" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        </svg>
                    </span>
                    <span class="sec-text">Ваши данные защищены современными методами шифрования</span>
                </div>

            </div>
        </div>

    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="lc-toast" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        <span>@message</span>
    </div>
}




@code {
    [SupplyParameterFromForm]
    private LoginModel loginModel { get; set; } = new();
    private string message;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        message = null;

        var result = await AuthService.LoginAsync(
            loginModel.Email,
            loginModel.Password);

        isLoading = false;

        if (!result.IsSuccess)
        {
            message = result.Error!;
            return;
        }

        Navigation.NavigateTo(
            result.Role == "Admin"
                ? "/admin-home"
                : "/profile");
    }

}

<style>

    /* ── Полоска ─────────────────────────────────────────────── */
    .lc-stripe {
        height: 4px;
        background: #1C3A5E;
    }

    .lc-stripe-inner {
        height: 100%;
        width: 35%;
        background: #F5A623;
        border-radius: 0 3px 3px 0;
    }

    /* ── Страница ────────────────────────────────────────────── */
    .login-page {
        min-height: 100vh;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .login-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: calc(100vh - 4px);
    }

    @@media (max-width: 768px) {
        .login-grid {
            grid-template-columns: 1fr;
        }

        .login-left {
            display: none !important;
        }
    }

    /* ── Левая панель ────────────────────────────────────────── */
    .login-left {
        background: #1C3A5E;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 3rem 2.5rem;
        position: relative;
        overflow: hidden;
    }

        .login-left::before {
            content: '';
            position: absolute;
            top: -80px;
            right: -80px;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(245, 166, 35, 0.1);
            pointer-events: none;
        }

        .login-left::after {
            content: '';
            position: absolute;
            bottom: -60px;
            left: -60px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.04);
            pointer-events: none;
        }

    .login-left-inner {
        position: relative;
        z-index: 1;
        text-align: center;
        width: 100%;
        max-width: 300px;
    }

    .brand-icon {
        width: 58px;
        height: 58px;
        background: #F5A623;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        margin: 0 auto 1rem;
    }

    .brand-name {
        font-size: 22px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 4px;
    }

    .brand-sub {
        font-size: 12px;
        color: #A8C4DE;
        margin-bottom: 2.25rem;
        line-height: 1.5;
    }

    /* ── Фичи ────────────────────────────────────────────────── */
    .feat-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
        text-align: left;
    }

    .feat-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .feat-ico {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: rgba(245, 166, 35, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #F5A623;
        flex-shrink: 0;
    }

    .feat-title {
        font-size: 13px;
        font-weight: 500;
        color: #fff;
    }

    .feat-desc {
        font-size: 11px;
        color: #A8C4DE;
        margin-top: 2px;
    }

    /* ── Правая панель ───────────────────────────────────────── */
    .login-right {
        background: #F5F3EF;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1.5rem;
    }

    /* ── Карточка формы ──────────────────────────────────────── */
    .form-box {
        background: #fff;
        border: 1px solid #E2DBCF;
        border-radius: 16px;
        padding: 2rem;
        width: 100%;
        max-width: 360px;
    }

    .form-top {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .form-top-ico {
        width: 46px;
        height: 46px;
        background: #E8F0F9;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1C3A5E;
        margin: 0 auto .75rem;
    }

    .form-title {
        font-size: 18px;
        font-weight: 600;
        color: #1C2B3A;
        margin-bottom: 4px;
    }

    .form-sub {
        font-size: 12px;
        color: #8A8070;
    }

    /* ── Поля ────────────────────────────────────────────────── */
    .field {
        margin-bottom: 1rem;
    }

    .field-label-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: .4rem;
    }

    .field-label {
        font-size: 12px;
        font-weight: 500;
        color: #1C2B3A;
    }

    .forgot-link {
        font-size: 11px;
        color: #1C3A5E;
        text-decoration: none;
        transition: color 0.15s;
    }

        .forgot-link:hover {
            color: #F5A623;
            text-decoration: underline;
        }

    .inp-wrap {
        display: flex;
        border: 1px solid #D5CCBC;
        border-radius: 8px;
        overflow: hidden;
        transition: border-color 0.15s, box-shadow 0.15s;
    }

        .inp-wrap:focus-within {
            border-color: #1C3A5E;
            box-shadow: 0 0 0 3px rgba(28, 58, 94, 0.1);
        }

    .inp-ico {
        width: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #FAF8F4;
        color: #8A8070;
        flex-shrink: 0;
        border-right: 1px solid #E2DBCF;
    }

    .lc-inp {
        flex: 1;
        font-size: 13px;
        padding: 9px 10px;
        border: none;
        background: #FAF8F4;
        color: #1C2B3A;
        outline: none;
    }

        .lc-inp::placeholder {
            color: #B0A898;
        }

    .lc-validation-msg {
        font-size: 12px;
        color: #b91c1c;
        margin-top: 4px;
        display: block;
    }

    .lc-alert-danger {
        font-size: 13px;
        background: #FEF2F2;
        color: #B91C1C;
        border: 1px solid #FECACA;
        border-radius: 8px;
        padding: 9px 12px;
        margin-bottom: 1rem;
    }

    /* ── Кнопки ──────────────────────────────────────────────── */
    .submit-btn {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: none;
        background: #1C3A5E;
        color: #fff;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: .25rem;
    }

        .submit-btn:hover {
            background: #154E8C;
        }

    .divider {
        position: relative;
        text-align: center;
        margin: 1rem 0;
    }

        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: #EDE8E0;
        }

        .divider span {
            position: relative;
            background: #fff;
            padding: 0 12px;
            font-size: 11px;
            color: #8A8070;
        }

    .reg-btn {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #D5CCBC;
        background: #fff;
        color: #1C2B3A;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
    }

        .reg-btn:hover {
            background: #F5F3EF;
            border-color: #B0A898;
            color: #1C2B3A;
        }

    /* ── Заметка о безопасности ──────────────────────────────── */
    .sec-note {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #F5F3EF;
        border: 1px solid #EDE8E0;
        border-radius: 8px;
        padding: 8px 10px;
        margin-top: 1rem;
    }

    .sec-ico {
        color: #1C3A5E;
        flex-shrink: 0;
        display: flex;
    }

    .sec-text {
        font-size: 11px;
        color: #8A8070;
        line-height: 1.4;
    }

    /* ── Toast-уведомление ───────────────────────────────────── */
    .lc-toast {
        position: fixed;
        top: 1rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 8px;
        background: #FEF2F2;
        color: #B91C1C;
        border: 1px solid #FECACA;
        border-radius: 10px;
        padding: 10px 16px;
        font-size: 13px;
        z-index: 1050;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    }
</style>
